---
import { APP_URL, CHROME_URL, IOS_URL, FIREFOX_URL, EDGE_URL } from './data';
import { LOCALE_HOMES } from '../../i18n/routes';

const columns: { title: string; links: { label: string; href: string }[] }[] = [
  {
    title: 'Product',
    links: [
      { label: 'Browser extension', href: '/extension' },
      { label: 'Features', href: '/#features' },
      { label: 'Pricing', href: '/#pricing' },
      { label: 'Open the web app', href: APP_URL },
      { label: 'Discover public boards', href: 'https://app.marqly.com/discover' },
    ],
  },
  {
    title: 'Download',
    links: [
      { label: 'Chrome extension', href: CHROME_URL },
      { label: 'Edge extension', href: EDGE_URL },
      { label: 'Firefox extension', href: FIREFOX_URL },
      { label: 'iOS app', href: IOS_URL },
    ],
  },
  {
    title: 'Compare',
    links: [
      { label: 'Marqly vs Pocket', href: '/compare/marqly-vs-pocket' },
      { label: 'Marqly vs Raindrop', href: '/compare/marqly-vs-raindrop' },
      { label: 'Marqly vs Readwise Reader', href: '/compare/marqly-vs-readwise-reader' },
      { label: 'All comparisons', href: '/compare' },
      { label: 'Alternatives guides', href: '/alternatives' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Blog', href: '/blog' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Free tools', href: '/tools' },
      { label: 'Prompt Gallery', href: '/prompt-gallery' },
      { label: 'Help', href: 'https://help.marqly.com/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Contact us', href: 'mailto:support@marqly.com' },
      { label: 'Terms of Use', href: '/terms' },
      { label: 'Privacy Policy', href: '/privacypolicy' },
    ],
  },
];
---

<footer class="bg-surface">
  <div class="mx-auto max-w-[1120px] px-5 py-14 md:px-8 md:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.2fr_repeat(5,1fr)]">
      <div>
        <a href="/" class="flex items-center gap-2" aria-label="Marqly home">
          <img src="/landing/logo.svg" alt="" width="26" height="26" />
          <span class="text-[15px] font-semibold text-foreground">Marqly</span>
        </a>
        <p class="mt-3 max-w-[200px] text-[13px] leading-relaxed text-muted">
          The bookmark manager that finds things.
        </p>
      </div>
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="mb-3 text-[10px] font-semibold tracking-wider text-foreground/60 uppercase">
              {col.title}
            </p>
            <ul class="space-y-2">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener' : undefined}
                    class="text-[13px] text-foreground/75 transition-colors hover:text-foreground"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <nav
      aria-label="Language"
      class="mt-12 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-separator pt-6"
    >
      <span class="text-[10px] font-semibold tracking-wider text-foreground/60 uppercase">
        Language
      </span>
      <a href="/" class="text-[13px] text-foreground/75 transition-colors hover:text-foreground">
        English
      </a>
      {
        LOCALE_HOMES.map((l) => (
          <a
            href={l.href}
            hreflang={l.lang}
            lang={l.lang}
            class="text-[13px] text-foreground/75 transition-colors hover:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div
      class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-separator pt-6"
    >
      <p class="text-[11px] text-muted">© 2026 Marqly. All rights reserved.</p>
      <a
        href="https://x.com/getmarqly"
        target="_blank"
        rel="noopener"
        class="text-[11px] text-muted transition-colors hover:text-foreground"
      >
        @getmarqly
      </a>
    </div>
  </div>
</footer>
