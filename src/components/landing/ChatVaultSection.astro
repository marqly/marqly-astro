---
import { ChatVaultDemo, TranscriptStrip } from './demos';
---

<section class="bg-surface py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[0.85fr_1.15fr] md:gap-14">
      <div data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">AI chats</p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          The answer you'll<br />need again.
        </h2>
        <p class="mt-4 max-w-[480px] text-[16px] leading-relaxed text-muted">
          That one ChatGPT conversation that finally explained it? Save it. Marqly captures chats
          from ChatGPT, Claude, and Gemini into their own workspace, kept and searched like
          everything else you save.
        </p>
      </div>
      <div data-reveal style="--reveal-delay: 80ms">
        <TranscriptStrip />
      </div>
    </div>
    <div class="mt-10">
      <ChatVaultDemo />
    </div>
  </div>
</section>
