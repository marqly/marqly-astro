---
/**
 * Ask — the AI assistant. Header block, the full-width showcase (the panel
 * next to the library, cycling through its four jobs), then four cards for
 * the options: entry points, approval + undo, sources + memory, connected apps.
 * The four visuals share one fixed height and one inner rhythm (rows of 12px
 * text, 8px apart, centred) so the row reads as a set.
 */
import AskShowcase from './AskShowcase';
import { FaviconTile, Kbd } from './bits';
import { CITE_CLASS } from './AskDock';
import { CheckIcon, MessageIcon } from './icons';

const modes = [
  { label: 'Off', on: false },
  { label: 'Ask me first', on: true },
  { label: 'Small changes automatically', on: false },
];

const cards = [
  {
    lead: 'Open it from anywhere.',
    text: '⌘J, the chat button in the header, or “Ask about this” on any board or bookmark.',
  },
  {
    lead: 'Nothing changes without you.',
    text: 'Every change is a card you approve. It applies instantly and can be undone for 30 days.',
  },
  {
    lead: 'Every answer shows its work.',
    text: 'Numbered citations open the exact bookmark, highlight, note, or transcript behind them.',
  },
  {
    lead: 'Your library in other AI apps.',
    text: 'Claude, ChatGPT, Cursor, and VS Code over MCP. Read-only per app until you allow more, revocable in one click.',
  },
];

const apps = [
  { name: 'Claude', domain: 'claude.ai', edit: false },
  { name: 'ChatGPT', domain: 'chatgpt.com', edit: false },
  { name: 'Cursor', domain: 'cursor.com', edit: true },
];

const visual = 'flex h-[180px] flex-col justify-center gap-2 rounded-3xl bg-surface p-5 shadow-surface';
const row = 'flex h-8 items-center gap-2.5 rounded-xl px-3 text-[12px] font-medium';
/** One fixed leading slot per row so every label starts on the same x. */
const lead = 'flex w-7 shrink-0 items-center justify-center';
---

<section id="ai-assistant" class="py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="max-w-[600px]" data-reveal>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">AI assistant</p>
      <h2
        class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
      >
        You saved it.<br />
        <em class="mark-stroke">Now ask it.</em>
      </h2>
      <p class="mt-4 max-w-[520px] text-[16px] leading-relaxed text-muted">
        Ask is the chat panel inside Marqly. It answers from what you saved, with a numbered source
        under every claim. It notices dead links and duplicates before you do. And when you say so, it
        tags, moves, and tidies, one approved change at a time.
      </p>
      <p class="mt-5 text-[13px] text-muted">Part of Pro, with a 7-day free trial · ⌘J from anywhere in the app</p>
    </div>

    <figure class="mt-10" data-reveal style="--reveal-delay: 80ms">
      <AskShowcase client:visible />
      <figcaption class="mt-4 max-w-[640px] text-sm leading-relaxed text-muted">
        <b class="font-semibold text-foreground">One panel, four jobs.</b> Answers with numbered sources, a standing check for dead links and duplicates, tidy-ups you approve item by item, and the same tools inside Claude, ChatGPT, Cursor, and VS Code.
      </figcaption>
    </figure>

    <!-- The options, one card each. Same visual height, same row rhythm. -->
    <div class="mt-10 grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 md:gap-6 lg:grid-cols-4">
      <figure class="flex flex-col" data-reveal>
        <div class={visual}>
          <span class={`${row} text-foreground/70`}>
            <span class={lead}><Kbd>⌘J</Kbd></span>
            Open Ask anywhere
          </span>
          <span class={`${row} bg-default/70 text-foreground`}>
            <span class={lead}><MessageIcon size={14} className="text-muted" /></span>
            Ask about this board
          </span>
          <span class={`${row} text-foreground/70`}>
            <span class={lead}><MessageIcon size={14} className="text-muted" /></span>
            Ask about this bookmark
          </span>
        </div>
        <figcaption class="mt-4 text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">{cards[0].lead}</b> {cards[0].text}
        </figcaption>
      </figure>

      <figure class="flex flex-col" data-reveal style="--reveal-delay: 60ms">
        <div class={visual}>
          {
            modes.map((m) => (
              <span class={`${row} ${m.on ? 'bg-default/70 text-foreground' : 'text-foreground/70'}`}>
                <span class={lead}>
                  <span
                    class={`flex size-4 items-center justify-center rounded-full border ${
                      m.on ? 'border-foreground bg-foreground text-white' : 'border-separator'
                    }`}
                  >
                    {m.on && <CheckIcon size={10} />}
                  </span>
                </span>
                {m.label}
              </span>
            ))
          }
        </div>
        <figcaption class="mt-4 text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">{cards[1].lead}</b> {cards[1].text}
        </figcaption>
      </figure>

      <figure class="flex flex-col" data-reveal style="--reveal-delay: 120ms">
        <div class={visual}>
          <p class="px-1 text-[12px] leading-[1.6] text-foreground/85">
            Cold water is what makes it <span class="whitespace-nowrap">smooth<span class={CITE_CLASS}>1</span>;</span> blend it a minute longer than feels <span class="whitespace-nowrap">right<span class={CITE_CLASS}>2</span>.</span>
          </p>
          <span class="mx-1 inline-flex items-center gap-2 self-start rounded-full border border-separator py-1 pr-2.5 pl-1.5 text-[12px] leading-none text-muted">
            <span class="flex items-center">
              <span class="rounded-full ring-2 ring-surface"><FaviconTile domain="feelgoodfoodie.net" size={16} /></span>
              <span class="-ml-1.5 rounded-full ring-2 ring-surface"><FaviconTile domain="themediterraneandish.com" size={16} /></span>
            </span>
            2 sources
          </span>
          <span class="px-1 text-[11px] text-muted">What Ask remembers · 2 items</span>
        </div>
        <figcaption class="mt-4 text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">{cards[2].lead}</b> {cards[2].text}
        </figcaption>
      </figure>

      <figure class="flex flex-col" data-reveal style="--reveal-delay: 180ms">
        <div class={visual}>
          {
            apps.map((a) => (
              <span class={`${row} ${a.edit ? 'bg-default/70 text-foreground' : 'text-foreground/70'}`}>
                <span class={lead}><FaviconTile domain={a.domain} size={16} /></span>
                <span class="min-w-0 flex-1 truncate">{a.name}</span>
                <span
                  class={`shrink-0 rounded-2xl px-1.5 py-px text-[10px] font-semibold whitespace-nowrap ${
                    a.edit ? 'bg-[color:var(--warning)]/20 text-foreground' : 'bg-default text-muted'
                  }`}
                >
                  {a.edit ? 'Can edit' : 'Read-only'}
                </span>
              </span>
            ))
          }
        </div>
        <figcaption class="mt-4 text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">{cards[3].lead}</b> {cards[3].text}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
