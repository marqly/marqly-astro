---
import { IOS_URL, ANDROID_URL } from './data';
---

<div class="store-row">
  <a
    class="store-btn"
    href={IOS_URL}
    target="_blank"
    rel="noopener"
    aria-label="Download Marqly on the App Store"
  >
    <svg class="store-logo" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.37 12.62c.03 2.88 2.53 3.84 2.56 3.85-.02.07-.4 1.37-1.32 2.7-.8 1.15-1.63 2.3-2.94 2.32-1.29.03-1.7-.76-3.18-.76s-1.93.74-3.16.79c-1.27.05-2.24-1.24-3.05-2.4C3.56 16.9 2.3 12.55 4 9.63c.84-1.45 2.34-2.37 3.97-2.4 1.24-.02 2.41.83 3.18.83.76 0 2.19-1.03 3.69-.88.63.03 2.4.25 3.53 1.91-.09.05-2.11 1.23-2 3.53ZM13.15 3.9c.7-.84 1.17-2.01 1.04-3.18-1 .04-2.22.67-2.94 1.51-.65.75-1.22 1.96-1.07 3.11 1.13.09 2.28-.57 2.97-1.44Z"
      ></path>
    </svg>
    <span class="store-copy">
      <span class="store-kicker">Download on the</span>
      <span class="store-name">App Store</span>
    </span>
  </a>
  <a
    class="store-btn"
    href={ANDROID_URL}
    target="_blank"
    rel="noopener"
    aria-label="Get Marqly on Google Play"
  >
    <svg class="store-logo store-logo-play" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M3.609 1.814 13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893 2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199 2.26 1.293a1 1 0 0 1 0 1.75l-2.26 1.29-2.496-2.465 2.496-1.868zM5.864 2.658 16.8 8.99l-2.302 2.302L5.864 2.658z"
      ></path>
    </svg>
    <span class="store-copy">
      <span class="store-kicker">Get it on</span>
      <span class="store-name">Google Play</span>
    </span>
  </a>
</div>

<style>
  .store-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .store-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    min-width: 168px;
    padding: 8px 18px 8px 14px;
    border-radius: 12px;
    background: var(--ink, var(--eclipse, #111));
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 160ms cubic-bezier(0.2, 0, 0, 1),
      background-color 160ms cubic-bezier(0.2, 0, 0, 1);
  }

  .store-btn:hover {
    background: #000;
  }

  .store-btn:active {
    transform: scale(0.96);
  }

  .store-logo {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .store-logo-play {
    width: 22px;
    height: 22px;
  }

  .store-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    line-height: 1.05;
  }

  .store-kicker {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.86);
  }

  .store-name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
</style>
