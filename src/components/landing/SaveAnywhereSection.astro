---
import { SaveModal } from './SaveModal';
import HighlighterDemo from './HighlighterDemo';
import YouTubeShowcase from './YouTubeShowcase';
---

<section class="bg-surface py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="max-w-[600px]" data-reveal>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">Capture</p>
      <h2
        class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
      >
        Saving is a reflex,<br />not a chore.
      </h2>
      <p class="mt-4 max-w-[520px] text-[16px] leading-relaxed text-muted">
        The extension lives where you read. One shortcut saves the page; the AI does the filing
        while the dialog is still open.
      </p>
    </div>

    <!-- Twin cards: the save dialog and the highlighter, identical framing -->
    <div class="mt-10 grid grid-cols-1 items-stretch gap-5 md:grid-cols-2 md:gap-6">
      <figure class="flex flex-col" data-reveal>
        <div
          class="flex flex-1 items-center justify-center rounded-3xl p-5 py-10 sm:p-8 sm:py-12"
          style="background: color-mix(in oklab, var(--hl-blue) 30%, white)"
        >
          <SaveModal
            phase="suggested"
            url="haraldurthorleifsson.com"
            title="Halli — Haraldur Thorleifsson"
            boardEmoji="🎨"
            boardName="Design systems"
            tags={['design', 'people', 'inspiration']}
          />
        </div>
        <figcaption class="mt-4 text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">One click, zero filing.</b>
          Marqly picks the board and suggests tags before the dialog closes. Leave it alone and it
          saves itself.
        </figcaption>
      </figure>

      <figure class="flex flex-col" data-reveal style="--reveal-delay: 70ms">
        <div
          class="flex flex-1 items-center justify-center rounded-3xl p-5 py-10 sm:p-8 sm:py-12"
          style="background: color-mix(in oklab, var(--hl-mint) 30%, white)"
        >
          <HighlighterDemo client:visible />
        </div>
        <figcaption class="mt-4 text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">Highlight what mattered.</b>
          Six markers, restored on every revisit, searchable from your library. Go on, recolor it.
        </figcaption>
      </figure>
    </div>

    <!-- Full-width: the AI card on a real watch page -->
    <figure class="mt-10" data-reveal>
      <YouTubeShowcase client:visible />
      <figcaption class="mt-4 max-w-[640px] text-sm leading-relaxed text-muted">
        <b class="font-semibold text-foreground">YouTube, summarized in place.</b>
        A card next to the player with a streaming summary, chat over the transcript, and
        playback-synced timestamps. Save the video and all of it stays searchable.
      </figcaption>
    </figure>
  </div>
</section>
