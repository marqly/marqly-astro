---
/**
 * Reviews — the four testimonials carried over from the previous site,
 * verbatim. id="reviews" is a site-wide anchor (the header links to
 * /#reviews from every page). Avatars were dropped 2026-09-25; the grid is
 * 2×2 so two more REAL quotes (Play Store / email — never invented) can join
 * without breaking the rhythm.
 */
const testimonials = [
  {
    name: 'Chenten',
    role: 'Product Designer, Berlin',
    quote:
      'Great bookmarking tool with a user-friendly interface. Absolutely a great way to save your bookmarks.',
  },
  {
    name: 'Adrian',
    role: 'Indie founder, Lisbon',
    quote:
      'I love the simplicity of Marqly. It allows me to manage all of my bookmarks in a single place.',
  },
  {
    name: 'Michael',
    role: 'Researcher, Toronto',
    quote: 'Fantastic way to organize bookmarks. Highly recommended!',
  },
  {
    name: 'Tina',
    role: 'Editor, New York',
    quote: 'The reader mode plus AI summaries save me hours every week. Worth every cent of Pro.',
  },
];
---

<section id="reviews" class="bg-surface py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="max-w-[600px]" data-reveal>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">Reviews</p>
      <h2
        class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
      >
        People who used to lose links.
      </h2>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
      {
        testimonials.map((t, i) => (
          <figure
            class="flex flex-col rounded-3xl bg-background p-7 md:p-8"
            data-reveal
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <blockquote class="flex-1 text-[16px] leading-relaxed text-foreground/85">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-6 border-t border-separator pt-4">
              <span class="block text-sm font-medium text-foreground">{t.name}</span>
              <span class="block text-xs text-muted">{t.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
