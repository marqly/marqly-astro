---
import { APP_URL } from './data';
import { CheckIcon } from './icons';

export interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;

const freePerks = [
  // Was 'Your 100 most recent bookmarks' until 2026-09-05, when the read wall was
  // removed: FREE now reads and searches its whole library, capped only by the 2,000
  // storage limit. This was the single biggest change to what free is worth, and
  // leaving the old line would have undersold the plan rather than oversold it.
  'Your whole library — search all of it',
  'Up to 2,000 bookmarks',
  'One-click bookmark saving',
  'Bookmark preview',
  'Highlights',
  'Notes (up to 10)',
  'Boards and collections',
  'Read mode',
  'Access on mobile, tablet',
  'Unlimited devices',
];

const proPerks = [
  'Unlimited bookmarks',
  'AI tagging and summaries on every save',
  'Semantic + full-text search',
  'AI Organizer for bulk auto-filing',
  'Ask AI over your library',
  'YouTube AI summaries and chat',
  'ChatVault for AI conversations',
  'Clipboard cloud sync',
  'Broken-link checking',
  'Unlimited notes',
  'Smart sorting',
  'Priority support by email',
];

// Single source of truth for this section. Must match apps/api
// STRIPE_PRICE_PRO_*_AMOUNT_CENTS, which is what app.marqly.com/checkout charges.
//   Annual: $72/year → $6/mo, 33% off the $108/year monthly-equivalent
//   Monthly: $9/mo
//
// PROMO is the standing first-year offer (Stripe promotion code STANDING39 → coupon
// COMEBACK39-2026-09, $33 off, duration: once). It is NOT a fake sale: the offer has no
// expiry, so nothing here pretends it is about to end, and the renewal price is stated
// beside it every time it appears — the honest thing, and what card-network and EU
// consumer rules require.
const PRICE = {
  annual: {
    amount: '$39',
    period: '/first year',
    was: '$72',
    note: 'then $72/year · just $3.25/month for year one',
    promo: true,
  },
  monthly: {
    amount: '$9',
    period: '/month',
    was: null,
    note: 'billed monthly · switch to annual for your first year at $39',
    promo: false,
  },
};

// Two savings claims, deliberately kept apart because they compare different things and
// merging them would overstate one:
//   CYCLE_SAVE — annual vs paying monthly at LIST ($72 vs $108/yr). A property of the
//                billing cycle, true with or without a promotion → belongs on the toggle.
//   PROMO_SAVE — the standing first-year offer against annual list ($39 vs $72 = 45.8%).
//                A property of the offer → belongs on the card.
const CYCLE_SAVE = 'Save 33%';
const PROMO_SAVE = 'Save 46%';
const PROMO_CODE = 'STANDING39';
---

<section id="pricing" class="py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="max-w-[600px]" data-reveal>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">Pricing</p>
      {
        isPage ? (
          <h1 class="font-display mt-3 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground">
            Free to start.<br />One price for everything.
          </h1>
        ) : (
          <h2 class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground">
            Free to start.<br />One price for everything.
          </h2>
        )
      }
    </div>

    <div
      class="mt-8 inline-flex items-center gap-1 rounded-3xl bg-default p-1"
      role="group"
      aria-label="Billing period"
      data-billing-toggle
      data-reveal
    >
      <button
        type="button"
        data-billing-btn="annual"
        aria-pressed="true"
        class="flex items-center gap-2 rounded-3xl px-4 py-2 text-[13px] font-medium transition-colors bg-surface text-foreground shadow-surface"
      >
        Annually
        <span class="rounded-2xl bg-pro px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-white">
          {CYCLE_SAVE}
        </span>
      </button>
      <button
        type="button"
        data-billing-btn="monthly"
        aria-pressed="false"
        class="rounded-3xl px-4 py-2 text-[13px] font-medium transition-colors text-muted"
      >
        Monthly
      </button>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 md:gap-6">
      <div class="flex flex-col rounded-3xl bg-surface p-7 shadow-surface" data-reveal>
        <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Free</h3>
        <p class="font-display mt-3 text-4xl font-medium text-foreground">$0</p>
        <p class="mt-1 text-[11px] text-muted">forever · no card required</p>
        <ul class="mt-6 flex-1 space-y-2.5">
          {
            freePerks.map((p) => (
              <li class="flex items-start gap-2.5 text-sm text-foreground/80">
                <CheckIcon size={14} className="mt-1 shrink-0 text-muted" />
                {p}
              </li>
            ))
          }
        </ul>
        <p class="mt-3 mb-2.5 text-[11px] text-muted">
          Store up to 2,000 bookmarks — and read and search every one of them.
        </p>
        <a
          href={APP_URL}
          data-cta="pricing_free"
          class="flex h-11 items-center justify-center rounded-3xl bg-default text-[15px] font-medium text-foreground transition-colors hover:bg-default/70"
        >
          Get Marqly free
        </a>
      </div>

      <div class="relative flex flex-col rounded-3xl bg-ink p-7 text-white" data-reveal style="--reveal-delay: 70ms">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-sm font-semibold tracking-wide text-white/70 uppercase">Pro</h3>
          <span
            class="rounded-2xl bg-pro px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white"
            data-price-save
          >
            {PROMO_SAVE} · FIRST YEAR
          </span>
        </div>
        <p class="font-display mt-3 flex items-baseline gap-2.5 text-4xl font-medium">
          <span class="text-2xl text-white/40 line-through" data-price-was>{PRICE.annual.was}</span>
          <span data-price-amount>{PRICE.annual.amount}</span><span
            class="text-lg text-white/60"
            data-price-period>{PRICE.annual.period}</span
          >
        </p>
        <p class="mt-1 text-[11px] text-white/60" data-price-note>
          {PRICE.annual.note}
        </p>
        <ul class="mt-6 flex-1 space-y-2.5">
          {
            proPerks.map((p) => (
              <li class="flex items-start gap-2.5 text-sm text-white/85">
                <CheckIcon size={14} className="mt-1 shrink-0 text-pro-bright" />
                {p}
              </li>
            ))
          }
        </ul>
        {/*
          The discount and the trial are mutually exclusive, and the page must not imply
          otherwise. `subscribeStripe` suppresses the trial whenever a promotion code is
          applied (`cardTrialEnabled = !couponApplied && …`) — deliberately, so nobody gets
          "free for a week, then discounted". So a single CTA reading "Start the free trial"
          while carrying coupon=STANDING39 would charge immediately and contradict its own
          label, which is exactly the kind of mismatch that cost real purchases in 2026-09.
          Both offers are therefore shown as what they are, and only the primary one carries
          the code.
        */}
        <div class="mt-6 mb-2.5 space-y-1.5 text-[12px] text-white/55">
          <p class="flex items-start gap-2">
            <CheckIcon size={12} className="mt-[3px] shrink-0 text-pro-bright" />
            <span data-price-reassure>$39 today, then $72/year — cancel before renewal and that is all you pay</span>
          </p>
          <p class="flex items-start gap-2">
            <CheckIcon size={12} className="mt-[3px] shrink-0 text-pro-bright" />
            Cancel any time; your bookmarks stay yours and stay readable
          </p>
        </div>
        <a
          href={APP_URL}
          data-cta="pricing_pro"
          data-pricing-cta="pro"
          class="flex h-11 items-center justify-center rounded-3xl bg-white text-[15px] font-medium text-ink transition-transform active:scale-[0.97]"
        >
          <span data-price-cta-label>Get Pro — $39 for year one</span>
        </a>
        <a
          href={`${APP_URL}/checkout?billing=yearly&src=www_pricing_trial`}
          data-cta="pricing_pro_trial"
          data-pricing-cta="trial"
          class="mt-2.5 flex h-9 items-center justify-center text-[12px] text-white/60 underline-offset-4 transition-colors hover:text-white/85 hover:underline"
        >
          or start a 7-day free trial at $72/year
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ PRICE, PROMO_SAVE, PROMO_CODE }}>
  // Vanilla, no hydration — matches the rest of this landing page.
  const toggle = document.querySelector('[data-billing-toggle]');
  const section = document.querySelector('#pricing');
  if (toggle && section) {
    const amountEl = section.querySelector('[data-price-amount]');
    const periodEl = section.querySelector('[data-price-period]');
    const noteEl = section.querySelector('[data-price-note]');
    const wasEl = section.querySelector('[data-price-was]');
    const saveEl = section.querySelector('[data-price-save]');
    const buttons = toggle.querySelectorAll('[data-billing-btn]');
    const ACTIVE = ['bg-surface', 'text-foreground', 'shadow-surface'];

    // The toggle's choice used to be lost at the hop to the app — the CTA
    // carries it now so checkout can preselect the billing cycle.
    const carryBilling = (key) => {
      const proCta = section.querySelector('[data-pricing-cta="pro"]');
      if (!proCta) return;
      try {
        const url = new URL(proCta.href);
        url.searchParams.set('billing', key);
        url.searchParams.set('src', 'www_pricing');
        // The promotion code has to travel with the click or the page lies: checkout
        // would open at the full $72 the card just struck through. Annual only — the
        // coupon is a flat $33 off, which is most of a $9 month, and checkout forces
        // yearly whenever a coupon is present. Removed on monthly rather than left stale.
        if (key === 'annual') {
          url.searchParams.set('coupon', PROMO_CODE);
          url.searchParams.set('utm_source', 'www');
          url.searchParams.set('utm_medium', 'pricing');
          url.searchParams.set('utm_campaign', 'standing_offer_2026-09');
        } else {
          url.searchParams.delete('coupon');
        }
        proCta.href = url.toString();
      } catch {}
    };

    const apply = (key) => {
      const price = PRICE[key];
      if (!price) return;
      amountEl.textContent = price.amount;
      periodEl.textContent = price.period;
      noteEl.textContent = price.note;
      // Monthly carries no discount, so the struck-through anchor and the savings badge
      // must disappear rather than sit beside a price they do not describe.
      if (wasEl) {
        wasEl.textContent = price.was ?? '';
        wasEl.hidden = !price.was;
      }
      if (saveEl) {
        saveEl.textContent = price.promo ? `${PROMO_SAVE} · FIRST YEAR` : '7-DAY FREE TRIAL';
      }
      // On monthly there is no discount, so the CTA goes back to the trial and the
      // separate trial link would be a duplicate of it.
      const ctaLabel = section.querySelector('[data-price-cta-label]');
      const reassure = section.querySelector('[data-price-reassure]');
      const trialLink = section.querySelector('[data-pricing-cta="trial"]');
      if (ctaLabel) ctaLabel.textContent = price.promo ? 'Get Pro — $39 for year one' : 'Start the free trial';
      if (reassure) {
        reassure.textContent = price.promo
          ? '$39 today, then $72/year — cancel before renewal and that is all you pay'
          : '7 days free first — cancel before it ends and you are not charged';
      }
      if (trialLink) trialLink.hidden = !price.promo;
      buttons.forEach((button) => {
        const isActive = button.dataset.billingBtn === key;
        button.setAttribute('aria-pressed', String(isActive));
        button.classList.toggle('text-muted', !isActive);
        ACTIVE.forEach((cls) => button.classList.toggle(cls, isActive));
      });
      carryBilling(key);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.billingBtn));
    });

    // Stamp the server-rendered default onto the CTA too.
    const initial = [...buttons].find((b) => b.getAttribute('aria-pressed') === 'true');
    if (initial) carryBilling(initial.dataset.billingBtn);
  }
</script>
