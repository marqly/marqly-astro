---
import { APP_URL } from './data';
import { CheckIcon } from './icons';

const freePerks = [
  'Your 100 most recent bookmarks',
  'One-click bookmark saving',
  'Basic search',
  'Bookmark preview',
  'Highlights',
  'Notes (up to 10)',
  'Boards and collections',
  'Read mode',
  'Access on mobile, tablet',
  'Unlimited devices',
];

const proPerks = [
  'Unlimited bookmarks',
  'AI tagging and summaries on every save',
  'Semantic + full-text search',
  'AI Organizer for bulk auto-filing',
  'Ask AI over your library',
  'YouTube AI summaries and chat',
  'ChatVault for AI conversations',
  'Clipboard cloud sync',
  'Broken-link checking',
  'Unlimited notes',
  'Smart sorting',
  'Priority support by email',
];

// Single source of truth for this section. Must match apps/api
// STRIPE_PRICE_PRO_*_AMOUNT_CENTS, which is what app.marqly.com/checkout charges.
//   Annual: $72/year → $6/mo, 33% off the $108/year monthly-equivalent
//   Monthly: $9/mo
const PRICE = {
  annual: { amount: '$6', period: '/month', note: 'billed annually at $72 · or $9 monthly' },
  monthly: { amount: '$9', period: '/month', note: 'billed monthly · switch to annual to save 33%' },
};
const SAVE_LABEL = 'Save 33%';
---

<section id="pricing" class="py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="max-w-[600px]" data-reveal>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">Pricing</p>
      <h2
        class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
      >
        Free to start.<br />One price for everything.
      </h2>
    </div>

    <div
      class="mt-8 inline-flex items-center gap-1 rounded-3xl bg-default p-1"
      role="group"
      aria-label="Billing period"
      data-billing-toggle
      data-reveal
    >
      <button
        type="button"
        data-billing-btn="annual"
        aria-pressed="true"
        class="flex items-center gap-2 rounded-3xl px-4 py-2 text-[13px] font-medium transition-colors bg-surface text-foreground shadow-surface"
      >
        Annually
        <span class="rounded-2xl bg-pro px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-white">
          {SAVE_LABEL}
        </span>
      </button>
      <button
        type="button"
        data-billing-btn="monthly"
        aria-pressed="false"
        class="rounded-3xl px-4 py-2 text-[13px] font-medium transition-colors text-muted"
      >
        Monthly
      </button>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 md:gap-6">
      <div class="flex flex-col rounded-3xl bg-surface p-7 shadow-surface" data-reveal>
        <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Free</h3>
        <p class="font-display mt-3 text-4xl font-medium text-foreground">$0</p>
        <p class="mt-1 text-[11px] text-muted">forever · no card required</p>
        <ul class="mt-6 flex-1 space-y-2.5">
          {
            freePerks.map((p) => (
              <li class="flex items-start gap-2.5 text-sm text-foreground/80">
                <CheckIcon size={14} className="mt-1 shrink-0 text-muted" />
                {p}
              </li>
            ))
          }
        </ul>
        <p class="mt-3 mb-2.5 text-[11px] text-muted">
          Store up to 2,000; the 100 most recent stay accessible on Free.
        </p>
        <a
          href={APP_URL}
          data-cta="pricing_free"
          class="flex h-11 items-center justify-center rounded-3xl bg-default text-[15px] font-medium text-foreground transition-colors hover:bg-default/70"
        >
          Get Marqly free
        </a>
      </div>

      <div class="relative flex flex-col rounded-3xl bg-ink p-7 text-white" data-reveal style="--reveal-delay: 70ms">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold tracking-wide text-white/70 uppercase">Pro</h3>
          <span class="rounded-2xl bg-pro px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white">
            7-DAY FREE TRIAL
          </span>
        </div>
        <p class="font-display mt-3 text-4xl font-medium">
          <span data-price-amount>{PRICE.annual.amount}</span><span
            class="text-lg text-white/60"
            data-price-period>{PRICE.annual.period}</span
          >
        </p>
        <p class="mt-1 text-[11px] text-white/60" data-price-note>
          {PRICE.annual.note}
        </p>
        <ul class="mt-6 flex-1 space-y-2.5">
          {
            proPerks.map((p) => (
              <li class="flex items-start gap-2.5 text-sm text-white/85">
                <CheckIcon size={14} className="mt-1 shrink-0 text-pro-bright" />
                {p}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 mb-2.5 text-center text-[12px] text-white/55">Cancel anytime.</p>
        <a
          href={APP_URL}
          data-cta="pricing_pro"
          data-pricing-cta="pro"
          class="flex h-11 items-center justify-center rounded-3xl bg-white text-[15px] font-medium text-ink transition-transform active:scale-[0.97]"
        >
          Start the free trial
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ PRICE }}>
  // Vanilla, no hydration — matches the rest of this landing page.
  const toggle = document.querySelector('[data-billing-toggle]');
  const section = document.querySelector('#pricing');
  if (toggle && section) {
    const amountEl = section.querySelector('[data-price-amount]');
    const periodEl = section.querySelector('[data-price-period]');
    const noteEl = section.querySelector('[data-price-note]');
    const buttons = toggle.querySelectorAll('[data-billing-btn]');
    const ACTIVE = ['bg-surface', 'text-foreground', 'shadow-surface'];

    // The toggle's choice used to be lost at the hop to the app — the CTA
    // carries it now so checkout can preselect the billing cycle.
    const carryBilling = (key) => {
      const proCta = section.querySelector('[data-pricing-cta="pro"]');
      if (!proCta) return;
      try {
        const url = new URL(proCta.href);
        url.searchParams.set('billing', key);
        url.searchParams.set('src', 'www_pricing');
        proCta.href = url.toString();
      } catch {}
    };

    const apply = (key) => {
      const price = PRICE[key];
      if (!price) return;
      amountEl.textContent = price.amount;
      periodEl.textContent = price.period;
      noteEl.textContent = price.note;
      buttons.forEach((button) => {
        const isActive = button.dataset.billingBtn === key;
        button.setAttribute('aria-pressed', String(isActive));
        button.classList.toggle('text-muted', !isActive);
        ACTIVE.forEach((cls) => button.classList.toggle(cls, isActive));
      });
      carryBilling(key);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.billingBtn));
    });

    // Stamp the server-rendered default onto the CTA too.
    const initial = [...buttons].find((b) => b.getAttribute('aria-pressed') === 'true');
    if (initial) carryBilling(initial.dataset.billingBtn);
  }
</script>
