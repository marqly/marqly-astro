---
import { APP_URL, TEAMS_PUBLIC, TEAMS_PRICE } from './data';
import { CheckIcon } from './icons';

export interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;

const freePerks = [
  // 2026-09-05: the read wall was removed — FREE reads and searches its whole
  // library, capped only by storage. 2026-09-25: that storage cap dropped from
  // 2,000 to 100 (owner-confirmed; site-wide sweep pending).
  'Your whole library — search all of it',
  'Up to 100 bookmarks',
  'One-click bookmark saving',
  'Bookmark preview',
  'Highlights',
  'Notes (up to 10)',
  'Boards and collections',
  'Read mode',
  'Access on mobile, tablet',
  'Unlimited devices',
];

const proPerks = [
  'Unlimited bookmarks',
  'AI tagging and summaries on every save',
  'Semantic + full-text search',
  'Ask: AI answers with sources',
  'MCP',
  'AI Organizer for bulk auto-filing',
  'YouTube AI summaries and chat',
  'ChatVault for AI conversations',
  'Clipboard cloud sync',
  'Broken-link checking',
  'Unlimited notes',
  'Smart sorting',
  'Priority support by email',
];

const teamsPerks = [
  'All Pro features',
  'Shared team workspace — boards and bookmarks',
  'Save, organise, and search together',
  'Personal libraries stay separate',
  'Pooled AI: 2× a Pro allowance per seat',
  'Owner, Admin, and Member roles',
  'Email invites; a pending invite holds a seat',
  'Activity log for Owners and Admins',
  'One Owner-paid bill',
  'Cancel any time — data kept read-only',
];

// Single source of truth for this section. Must match apps/api
// STRIPE_PRICE_PRO_*_AMOUNT_CENTS, which is what app.marqly.com/checkout charges.
//   Annual: $72/year → $6/mo, 33% off the $108/year monthly-equivalent
//   Monthly: $9/mo
//
// PROMO is the standing first-year offer (Stripe promotion code STANDING49 → coupon
// STANDING49-2026-09, $23 off, duration: once). It is NOT a fake sale: the offer has no
// expiry, so nothing here pretends it is about to end, and the renewal price is stated
// beside it every time it appears — the honest thing, and what card-network and EU
// consumer rules require.
const PRICE = {
  annual: {
    amount: '$49',
    period: '/first year',
    was: '$72',
    note: 'then $72/year · just $4.08/month for year one',
    promo: true,
  },
  monthly: {
    amount: '$9',
    period: '/month',
    was: null,
    note: 'billed monthly · switch to annual for your first year at $49',
    promo: false,
  },
};

// PROMO_SAVE is the standing first-year offer against annual list ($49 vs $72 = 31.9% →
// rounded DOWN per the app's discount rule; the "· FIRST YEAR" baseline is printed in the badge).
const PROMO_SAVE = 'Save 31%';
const PROMO_CODE = 'STANDING49';
---

<section id="pricing" class="py-20 md:py-28">
  <div class="mx-auto max-w-[1120px] px-5 md:px-8">
    <div class="max-w-[600px]" data-reveal>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">Pricing</p>
      {
        isPage ? (
          <h1 class="font-display mt-3 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground">
            Free to start.<br />One price for everything.
          </h1>
        ) : (
          <h2 class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground">
            Free to start.<br />One price for everything.
          </h2>
        )
      }
    </div>

    <div
      class="mt-8 inline-flex items-center gap-1 rounded-3xl bg-default p-1"
      role="group"
      aria-label="Billing period"
      data-billing-toggle
      data-reveal
    >
      <button
        type="button"
        data-billing-btn="annual"
        aria-pressed="true"
        class="flex items-center gap-2 rounded-3xl px-4 py-2 text-[13px] font-medium transition-colors bg-surface text-foreground shadow-surface"
      >
        Annually
      </button>
      <button
        type="button"
        data-billing-btn="monthly"
        aria-pressed="false"
        class="rounded-3xl px-4 py-2 text-[13px] font-medium transition-colors text-muted"
      >
        Monthly
      </button>
    </div>

    <div class={`mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 md:gap-6 ${TEAMS_PUBLIC ? 'lg:grid-cols-3' : ''}`}>
      <div class="flex flex-col rounded-3xl bg-surface p-7 shadow-surface" data-reveal>
        <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Free</h3>
        <p class="font-display mt-3 text-4xl font-medium text-foreground">$0</p>
        <p class="mt-1 text-[11px] text-muted">forever · no card required</p>
        <ul class="mt-6 flex-1 space-y-2.5">
          {
            freePerks.map((p) => (
              <li class="flex items-start gap-2.5 text-sm text-foreground/80">
                <CheckIcon size={14} className="mt-1 shrink-0 text-muted" />
                {p}
              </li>
            ))
          }
        </ul>
        <a
          href={APP_URL}
          data-cta="pricing_free"
          class="flex h-11 items-center justify-center rounded-3xl bg-default text-[15px] font-medium text-foreground transition-colors hover:bg-default/70"
        >
          Get Marqly free
        </a>
      </div>

      <div class="relative flex flex-col rounded-3xl bg-ink p-7 text-white" data-reveal style="--reveal-delay: 70ms">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-sm font-semibold tracking-wide text-white/70 uppercase">Pro</h3>
          <span
            class="rounded-2xl bg-pro px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white"
            data-price-save
          >
            {PROMO_SAVE} · FIRST YEAR
          </span>
        </div>
        <p class="font-display mt-3 flex items-baseline gap-2.5 text-4xl font-medium">
          <span class="text-2xl text-white/40 line-through" data-price-was>{PRICE.annual.was}</span>
          <span data-price-amount>{PRICE.annual.amount}</span><span
            class="text-lg text-white/60"
            data-price-period>{PRICE.annual.period}</span
          >
        </p>
        <p class="mt-1 text-[11px] text-white/60" data-price-note>
          {PRICE.annual.note}
        </p>
        <ul class="mt-6 flex-1 space-y-2.5">
          {
            proPerks.map((p) => (
              <li class="flex items-start gap-2.5 text-sm text-white/85">
                <CheckIcon size={14} className="mt-1 shrink-0 text-pro-bright" />
                {p}
              </li>
            ))
          }
        </ul>
        {/*
          Marqly sells no free trial (retired 2026-09-18): Pro is billed the moment you
          upgrade. The CTA therefore only ever says "Get Pro" — with the first-year offer on
          annual, at list price on monthly — and carries the promotion code only when the
          checkout will honour it (annual). A label that promises something the checkout
          will not deliver is exactly the mismatch that cost real purchases in 2026-09.
        */}
        <a
          href={APP_URL}
          data-cta="pricing_pro"
          data-pricing-cta="pro"
          class="mt-7 flex h-11 items-center justify-center rounded-3xl bg-white text-[15px] font-medium text-ink transition-transform active:scale-[0.97]"
        >
          <span data-price-cta-label>Get Pro — $49 for year one</span>
        </a>
      </div>

      {
        /*
          Teams — dark until launch (TEAMS_PUBLIC in ./data). The card follows the
          Annually/Monthly toggle through its own data-teams-* hooks: annual is the
          server-rendered default (matching the toggle), and every string names its
          period — no bare "≈$6" without "billed yearly", no mixing of periods.
        */
        TEAMS_PUBLIC && (
          <div class="flex flex-col rounded-3xl bg-surface p-7 shadow-surface" data-reveal style="--reveal-delay: 140ms">
            <h3 class="text-sm font-semibold tracking-wide text-muted uppercase">Teams</h3>
            <p class="font-display mt-3 flex items-baseline gap-1.5 text-4xl font-medium text-foreground">
              <span data-teams-amount>{TEAMS_PRICE.perSeatYearly}</span>
              <span class="text-base font-normal tracking-[0.3px] text-muted" data-teams-period>/seat/yr</span>
            </p>
            <p class="mt-1 text-[12px] text-muted" data-teams-sub>about {TEAMS_PRICE.perSeatMonthlyWhenYearly}/seat/month, billed yearly</p>
            <p class="mt-2 text-[11px] font-medium text-foreground/60" data-teams-min>
              {TEAMS_PRICE.minSeats}-seat minimum — from {TEAMS_PRICE.fromYearly}/year
            </p>
            <ul class="mt-6 flex-1 space-y-2.5">
              <li class="flex items-start gap-2.5 text-sm font-semibold text-foreground">
                <CheckIcon size={14} className="mt-1 shrink-0 text-pro" />
                <span>
                  {teamsPerks[0]}
                  <span class="ml-1.5 rounded-2xl bg-pro px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white uppercase">
                    included
                  </span>
                </span>
              </li>
              {teamsPerks.slice(1).map((p) => (
                <li class="flex items-start gap-2.5 text-sm text-foreground/80">
                  <CheckIcon size={14} className="mt-1 shrink-0 text-pro" />
                  {p}
                </li>
              ))}
            </ul>
            <a
              href="/teams"
              data-cta="pricing_teams"
              class="mt-7 flex h-11 items-center justify-center rounded-3xl bg-default text-[15px] font-medium text-foreground transition-colors hover:bg-default/70"
            >
              Get Teams
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<script define:vars={{ PRICE, PROMO_SAVE, PROMO_CODE, TEAMS_PRICE: TEAMS_PRICE }}>
  // Vanilla, no hydration — matches the rest of this landing page.
  const toggle = document.querySelector('[data-billing-toggle]');
  const section = document.querySelector('#pricing');
  if (toggle && section) {
    const amountEl = section.querySelector('[data-price-amount]');
    const periodEl = section.querySelector('[data-price-period]');
    const noteEl = section.querySelector('[data-price-note]');
    const wasEl = section.querySelector('[data-price-was]');
    const saveEl = section.querySelector('[data-price-save]');
    const buttons = toggle.querySelectorAll('[data-billing-btn]');
    const ACTIVE = ['bg-surface', 'text-foreground', 'shadow-surface'];

    // The toggle's choice used to be lost at the hop to the app — the CTA
    // carries it now so checkout can preselect the billing cycle.
    const carryBilling = (key) => {
      const proCta = section.querySelector('[data-pricing-cta="pro"]');
      if (!proCta) return;
      try {
        const url = new URL(proCta.href);
        url.searchParams.set('billing', key);
        url.searchParams.set('src', 'www_pricing');
        // The promotion code has to travel with the click or the page lies: checkout
        // would open at the full $72 the card just struck through. Annual only — the
        // coupon is a flat $23 off, which is most of a $9 month, and checkout forces
        // yearly whenever a coupon is present. Removed on monthly rather than left stale.
        if (key === 'annual') {
          url.searchParams.set('coupon', PROMO_CODE);
          url.searchParams.set('utm_source', 'www');
          url.searchParams.set('utm_medium', 'pricing');
          url.searchParams.set('utm_campaign', 'standing_offer_2026-09');
        } else {
          url.searchParams.delete('coupon');
        }
        proCta.href = url.toString();
      } catch {}
    };

    const apply = (key) => {
      const price = PRICE[key];
      if (!price) return;
      amountEl.textContent = price.amount;
      periodEl.textContent = price.period;
      noteEl.textContent = price.note;
      // Teams follows the same period switch (dark until TEAMS_PUBLIC — the
      // elements simply do not exist then, hence the guards).
      const teams = {
        annual: {
          amount: TEAMS_PRICE.perSeatYearly,
          period: '/seat/yr',
          sub: `about ${TEAMS_PRICE.perSeatMonthlyWhenYearly}/seat/month, billed yearly`,
          min: `${TEAMS_PRICE.minSeats}-seat minimum — from ${TEAMS_PRICE.fromYearly}/year`,
        },
        monthly: {
          amount: TEAMS_PRICE.perSeatMonthly,
          period: '/seat/mo',
          sub: `or ${TEAMS_PRICE.perSeatYearly}/seat/yr — about ${TEAMS_PRICE.perSeatMonthlyWhenYearly}/seat/month billed yearly`,
          min: `${TEAMS_PRICE.minSeats}-seat minimum — from ${TEAMS_PRICE.fromMonthly}/month`,
        },
      }[key];
      if (teams) {
        const tA = section.querySelector('[data-teams-amount]');
        const tP = section.querySelector('[data-teams-period]');
        const tS = section.querySelector('[data-teams-sub]');
        const tM = section.querySelector('[data-teams-min]');
        if (tA) tA.textContent = teams.amount;
        if (tP) tP.textContent = teams.period;
        if (tS) tS.textContent = teams.sub;
        if (tM) tM.textContent = teams.min;
      }
      // Monthly carries no discount, so the struck-through anchor and the savings badge
      // must disappear rather than sit beside a price they do not describe.
      if (wasEl) {
        wasEl.textContent = price.was ?? '';
        wasEl.hidden = !price.was;
      }
      if (saveEl) {
        saveEl.textContent = price.promo ? `${PROMO_SAVE} · FIRST YEAR` : 'CANCEL ANYTIME';
      }
      // On monthly there is no discount, so the CTA is plain "Get Pro" at list price.
      const ctaLabel = section.querySelector('[data-price-cta-label]');
      if (ctaLabel) ctaLabel.textContent = price.promo ? 'Get Pro — $49 for year one' : 'Get Pro — $9/month';
      buttons.forEach((button) => {
        const isActive = button.dataset.billingBtn === key;
        button.setAttribute('aria-pressed', String(isActive));
        button.classList.toggle('text-muted', !isActive);
        ACTIVE.forEach((cls) => button.classList.toggle(cls, isActive));
      });
      carryBilling(key);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.billingBtn));
    });

    // Stamp the server-rendered default onto the CTA too.
    const initial = [...buttons].find((b) => b.getAttribute('aria-pressed') === 'true');
    if (initial) carryBilling(initial.dataset.billingBtn);
  }
</script>
