---
import { APP_URL, CHROME_URL } from './data';

const links = [
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
];
---

<header class="sticky top-0 z-50 bg-background/85 backdrop-blur-md">
  <nav
    aria-label="Main"
    class="mx-auto flex h-14 max-w-[1120px] items-center gap-6 px-5 md:px-8"
  >
    <a href="/" class="flex items-center gap-2" aria-label="Marqly home">
      <img src="/landing/logo.svg" alt="" width="26" height="26" />
      <span class="text-[15px] font-semibold text-foreground">Marqly</span>
    </a>
    <div class="ml-4 flex items-center gap-5 max-md:hidden">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-muted transition-colors hover:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="ml-auto flex items-center gap-2">
      <a
        href={APP_URL}
        class="flex h-9 items-center rounded-3xl px-3.5 text-sm font-medium text-foreground transition-colors hover:bg-default max-sm:hidden"
      >
        Sign in
      </a>
      <a
        href={CHROME_URL}
        target="_blank"
        rel="noopener"
        class="flex h-9 items-center rounded-3xl bg-accent px-4 text-sm font-medium text-accent-foreground transition-transform active:scale-[0.97]"
      >
        Add to Chrome
      </a>
    </div>
  </nav>
</header>
