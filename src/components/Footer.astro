---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.avif';

const product = [
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'AI Tagging', href: '/#features' },
  // Crawlable followed link (noopener ≠ nofollow): passes this domain's
  // authority to the app's board directory so the /s/ board pages get indexed.
  { label: 'Discover public boards', href: 'https://app.marqly.com/discover' },
  { label: 'Contact us', href: 'mailto:support@marqly.com' },
  { label: 'Help', href: 'https://help.marqly.com/' },
];
const download = [
  { label: 'iOS app', href: 'https://apps.apple.com/us/app/marqly-ai-bookmark-manager/id6758905385' },
  { label: 'Chrome extension', href: 'https://chromewebstore.google.com/detail/marqly-all-in-one-bookmar/kcadneobjofkppmekgadodnaojoehemc' },
  { label: 'Firefox extension', href: 'https://addons.mozilla.org/en-US/firefox/addon/marqly/' },
  { label: 'Edge extension', href: 'https://microsoftedge.microsoft.com/addons/detail/marqly-%E2%80%93-the-ultimate-boo/gojjglmdginjjpgajdnobmnkmcogngok' },
];
const compare = [
  { label: 'Marqly vs Pocket', href: '/compare/marqly-vs-pocket' },
  { label: 'Marqly vs Raindrop', href: '/compare/marqly-vs-raindrop' },
  { label: 'Marqly vs Readwise Reader', href: '/compare/marqly-vs-readwise-reader' },
  { label: 'All comparisons', href: '/compare' },
  { label: 'Alternatives guides', href: '/alternatives' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Free tools', href: '/tools' },
];
const legal = [
  { label: 'Terms of Use', href: '/terms' },
  { label: 'Privacy Policy', href: '/privacypolicy' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="brand-col">
        <a href="/" aria-label="Marqly home" class="brand">
          <Image src={logo} alt="Marqly" height={28} width={112} densities={[1, 2]} />
        </a>
        <p class="tagline">The bookmark manager supercharged with AI. Save once. Find it instantly.</p>
        <div class="badges">
          <span class="badge">★ 4.8 on Chrome Web Store</span>
          <span class="badge">★ 4.7 on Product Hunt</span>
        </div>
      </div>

      <nav class="links" aria-label="Product">
        <h4>Product</h4>
        {product.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>)}
      </nav>

      <nav class="links" aria-label="Download">
        <h4>Download</h4>
        {download.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>)}
      </nav>

      <nav class="links" aria-label="Compare">
        <h4>Compare</h4>
        {compare.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <nav class="links" aria-label="Legal">
        <h4>Legal</h4>
        {legal.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">© {year} Marqly Labs. All rights reserved.</p>
      <div class="socials">
        <a href="https://twitter.com/getmarqly" aria-label="Marqly on X" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=100088234261663" aria-label="Marqly on Facebook" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.563V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.992 22 12z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/marqly" aria-label="Marqly on LinkedIn" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.producthunt.com/products/marqly" aria-label="Marqly on Product Hunt" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.604 8.444h-3.405V12h3.405a1.81 1.81 0 0 0 0-3.62v.064zm1.19 3.555h.39a3.247 3.247 0 0 0 0-6.495H7.927v15.32h2.272v-5.378h4.595a3.247 3.247 0 0 0 0-6.447zM24 12c0 6.627-5.373 12-12 12S0 18.627 0 12 5.373 0 12 0s12 5.373 12 12z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-1);
    color: var(--ink-3);
    padding-block: var(--space-24) var(--space-12);
    border-top: 1px solid var(--border-1);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr;
    gap: var(--space-12);
    align-items: flex-start;
  }
  .brand-col {
    max-width: 360px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand :global(img) {
    height: 28px;
    width: auto;
    max-width: 112px;
  }
  .tagline {
    margin-top: var(--space-5);
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: var(--lh-base);
    max-width: 32ch;
  }
  .badges {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--ink-2);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .links h4 {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
    letter-spacing: var(--tracking-base);
  }
  .links a {
    font-size: var(--fs-sm);
    color: var(--ink-3);
    transition: color var(--dur-base) var(--ease-out);
  }
  .links a:hover { color: var(--ink-1); }

  .footer-bottom {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .copyright {
    font-size: var(--fs-xs);
    color: var(--ink-4);
  }
  .socials {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    color: var(--ink-3);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    transition: color var(--dur-base) var(--ease-out),
                background var(--dur-base) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .socials a:hover {
    color: var(--ink-1);
    background: var(--surface-3);
    transform: translateY(-1px);
  }

  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
    .links[aria-label="Legal"], .links[aria-label="Compare"] {
      grid-column: span 1;
    }
  }
  @media (max-width: 700px) {
    .site-footer { padding-block: var(--space-16) var(--space-10); }
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
    .brand-col { grid-column: 1 / -1; }
    .footer-bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
