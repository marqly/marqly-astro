---
// Clean, hand-built pricing section. Replaces the brittle Framer-generated
// PricingSection.js + ResponsivePricing.jsx (no toggle on mobile, left-aligned,
// throws "Maximum call stack size exceeded"). Pure Astro + scoped CSS + a tiny
// vanilla-JS toggle — no React hydration, works identically on every breakpoint.
const APP = 'https://app.marqly.com/';

// Pricing facts — must match apps/api STRIPE_PRICE_PRO_*_AMOUNT_CENTS, which is what
// app.marqly.com/checkout actually charges (it reads GET /billing/plans).
//   Annual:  $72/year  → $6/mo, 33% off the $108/year list price
//   Monthly: $9/mo
const PRICE = {
  annual: { amount: '$72', period: '/year', wasAmount: '$108', note: 'Just $6/mo, billed annually' },
  monthly: { amount: '$9', period: '/month', wasAmount: null, note: 'Billed monthly' },
};

const freeFeatures = [
  'Up to 50 bookmarks',
  'Basic Search',
  'Bookmark Preview',
  'Bookmark Tags',
  'Access on Mobile, Tablet',
  'Unlimited Devices',
];

const proFeatures = [
  { label: 'Unlimited bookmarks', accent: false },
  { label: 'AI Powered Features', accent: true },
  { label: 'Super Fast Search', accent: false },
  { label: 'Fast Web Preview', accent: false },
  { label: 'Bookmark Preview', accent: false },
  { label: 'Bookmark Tags', accent: false },
  { label: 'Boards / Collections', accent: false },
  { label: 'Highlights & Notes', accent: false },
  { label: 'Read Mode', accent: false },
  { label: 'Smart Sorting', accent: false },
  { label: 'Unlimited Devices', accent: false },
  { label: 'Access anywhere', accent: false },
  { label: 'Priority support by email', accent: false },
];

const check = `<svg viewBox="0 0 20 20" width="16" height="16"><path d="M4 10.5l3.5 3.5L16 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="pricing-hero" data-billing="annual">
  <div class="container">
    <span class="eyebrow">✦ Pricing Plan ✦</span>
    <h1 class="pricing-title">Enjoy all features and unlimited bookmarks.</h1>

    <div class="billing-toggle" role="group" aria-label="Billing period">
      <button type="button" class="toggle-tab" data-billing-btn="monthly" aria-pressed="false">
        Monthly
      </button>
      <button type="button" class="toggle-tab is-active" data-billing-btn="annual" aria-pressed="true">
        Annually
        <span class="save-badge">Save 50%</span>
      </button>
    </div>
  </div>

  <div class="container plans">
    <!-- Free plan -->
    <article class="plan-card">
      <header class="plan-head">
        <h2 class="plan-name">Free Plan</h2>
        <div class="plan-price">
          <span class="amount">$0</span>
        </div>
        <p class="plan-note">Free forever</p>
      </header>
      <a href={APP} class="plan-cta cta-light">Start for Free</a>
      <ul class="feature-list">
        {freeFeatures.map((f) => (
          <li>
            <span class="check" aria-hidden="true" set:html={check} />
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </article>

    <!-- Pro plan -->
    <article class="plan-card plan-card--pro">
      <header class="plan-head">
        <h2 class="plan-name">Pro Plan</h2>
        <div class="plan-price">
          <span class="was" data-price-was>{PRICE.annual.wasAmount}</span>
          <span class="amount" data-price-amount>{PRICE.annual.amount}</span>
          <span class="period" data-price-period>{PRICE.annual.period}</span>
        </div>
        <p class="plan-note" data-price-note>{PRICE.annual.note}</p>
      </header>
      <a href={APP} class="plan-cta cta-dark">Get Started</a>
      <ul class="feature-list">
        {proFeatures.map((f) => (
          <li class={f.accent ? 'is-accent' : ''}>
            <span class="check" aria-hidden="true" set:html={check} />
            <span>{f.label}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<script define:vars={{ PRICE }}>
  const root = document.querySelector('.pricing-hero');
  if (root) {
    const wasEl = root.querySelector('[data-price-was]');
    const amountEl = root.querySelector('[data-price-amount]');
    const periodEl = root.querySelector('[data-price-period]');
    const noteEl = root.querySelector('[data-price-note]');
    const proHead = root.querySelector('.plan-card--pro .plan-head');
    const buttons = root.querySelectorAll('[data-billing-btn]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const writePrice = (key) => {
      const p = PRICE[key];
      wasEl.textContent = p.wasAmount ?? '';
      wasEl.hidden = !p.wasAmount;
      amountEl.textContent = p.amount;
      periodEl.textContent = p.period;
      noteEl.textContent = p.note;
    };

    const apply = (key) => {
      if (root.dataset.billing === key) return; // already on this period
      root.dataset.billing = key;
      buttons.forEach((b) => {
        const active = b.dataset.billingBtn === key;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      if (reduceMotion) {
        writePrice(key);
        return;
      }

      // Cross-fade the Pro price block: fade out → swap text → fade in.
      proHead.classList.add('is-swapping');
      window.setTimeout(() => {
        writePrice(key);
        proHead.classList.remove('is-swapping');
      }, 160);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => apply(b.dataset.billingBtn)),
    );
  }
</script>

<style>
  .pricing-hero {
    padding-top: var(--space-16);
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-heading-soft);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.85rem;
    box-shadow: var(--shadow-sm);
  }
  .pricing-title {
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-heading);
    max-width: 18ch;
    margin-inline: auto;
  }

  /* Billing toggle */
  .billing-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: var(--space-8);
    padding: 5px;
    background: #000;
    border-radius: var(--radius-pill);
  }
  .toggle-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: #fff;
    background: transparent;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .toggle-tab.is-active {
    background: #fff;
    color: #231645;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(47, 1, 151, 0.08);
  }
  .save-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: #fff;
    background: #7749f6;
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.5rem;
    line-height: 1.2;
  }

  /* ===== Plan cards ===== */
  .plans {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-8);
    margin-top: var(--space-16);
    text-align: left;
  }
  .plan-card {
    flex: 0 1 340px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }
  .plan-card--pro {
    box-shadow: var(--shadow-md);
  }
  .plan-head {
    margin-bottom: var(--space-6);
  }
  .plan-name {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: #080808;
    line-height: var(--lh-tight);
  }
  .plan-price {
    margin-top: var(--space-4);
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  /* Cross-fade the Pro price + note when switching billing period */
  .plan-price,
  .plan-note {
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .plan-head.is-swapping .plan-price,
  .plan-head.is-swapping .plan-note {
    opacity: 0;
    transform: translateY(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .plan-price,
    .plan-note {
      transition: none;
    }
  }
  .plan-price .was {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: #6b6478;
    text-decoration: line-through;
    text-decoration-color: #e0453f;
    text-decoration-thickness: 2.5px;
  }
  .plan-price .was[hidden] {
    display: none;
  }
  .plan-price .amount {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-heading);
    line-height: 1;
  }
  .plan-price .period {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    color: var(--color-text);
  }
  .plan-note {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    color: var(--color-text);
    min-height: 1.2em;
  }

  .plan-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-pill);
    transition: transform 0.15s ease;
  }
  .plan-cta:hover {
    transform: translateY(-1px);
  }
  .cta-light {
    background: #fff;
    color: #757575;
    border: 1px solid var(--color-border-strong);
  }
  .cta-dark {
    background: #000;
    color: #fff;
  }

  .feature-list {
    list-style: none;
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feature-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    color: var(--color-heading-soft);
  }
  .feature-list li.is-accent {
    color: #7e4fff;
    font-weight: 500;
  }
  .check {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--color-heading);
  }
  .feature-list li.is-accent .check {
    color: #7e4fff;
  }

  @media (max-width: 810px) {
    .pricing-title {
      font-size: 1.75rem;
    }
    .plans {
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
    }
    .plan-card {
      flex: 1 1 auto;
      width: 100%;
      max-width: 420px;
    }
    /* Lead with the paid Pro plan on mobile */
    .plan-card--pro {
      order: -1;
    }
  }
</style>
