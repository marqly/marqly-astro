---
import type { Competitor } from '../../lib/competitors';

interface Props {
  tools: Competitor[];
}

const { tools } = Astro.props;
const uniqueTools = [...new Map(tools.map((tool) => [tool.slug, tool])).values()];
const verificationDates = [...new Set(uniqueTools.map((tool) => tool.lastVerified))].sort();

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const verifiedLabel =
  verificationDates.length === 1
    ? formatDate(verificationDates[0])
    : `${formatDate(verificationDates[0])}–${formatDate(verificationDates.at(-1)!)}`;
---

<aside class="source-note" aria-label="Comparison verification and official sources">
  <span>Pricing and features verified {verifiedLabel} against official sources:</span>
  <span class="source-links">
    {uniqueTools.map((tool, index) => (
      <>
        {index > 0 && <span aria-hidden="true"> · </span>}
        <a href={tool.website} target="_blank" rel="noopener">
          {tool.name} official site <span aria-hidden="true">↗</span>
        </a>
      </>
    ))}
  </span>
</aside>

<style>
  .source-note {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-inner);
    background: var(--surface-2);
    color: var(--ink-3);
    font-size: var(--fs-xs);
    line-height: var(--lh-base);
  }
  .source-links { white-space: normal; }
  .source-note a {
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--border-2);
    text-underline-offset: 2px;
  }
  .source-note a:hover { color: var(--ink-1); }
</style>
