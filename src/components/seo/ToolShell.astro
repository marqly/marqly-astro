---
/**
 * Shared shell for /tools/* pages: hero, the interactive tool (default slot),
 * long-form supporting content (`content` slot), FAQ, CTA. Pages emit their
 * own JSON-LD via the layout.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import FaqAccordion from './FaqAccordion.astro';
import CtaBox from './CtaBox.astro';

interface Props {
  name: string;
  heading: string;
  sub: string;
  faqs?: { q: string; a: string }[];
  ctaHeading?: string;
  ctaSub?: string;
}
const { name, heading, sub, faqs = [], ctaHeading, ctaSub } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Free tools', path: '/tools' },
  { name, path: Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') },
];
---

<section class="tool-hero">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1>{heading}</h1>
    <p class="sub">{sub}</p>
  </div>
</section>

<section class="tool-body">
  <div class="container narrow">
    <div class="tool-panel">
      <slot />
    </div>

    <div class="prose">
      <slot name="content" />
    </div>

    {faqs.length > 0 && (
      <div class="faq-wrap">
        <FaqAccordion faqs={faqs} heading="Frequently asked questions" />
      </div>
    )}

    <CtaBox heading={ctaHeading} sub={ctaSub} />

    <p class="all-tools"><a href="/tools">← All free tools</a></p>
  </div>
</section>

<style>
  .tool-hero {
    /* extra bottom padding so the tool panel can straddle the band edge */
    padding-block: var(--space-16) var(--space-20);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border-1);
  }
  .tool-hero h1 {
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
    line-height: var(--lh-tight);
    max-width: 26ch;
  }
  .tool-hero .sub { margin-top: var(--space-5); font-size: var(--fs-lg); color: var(--ink-2); max-width: 58ch; }

  .tool-body { padding-block: 0 var(--space-16); }
  .narrow { max-width: 820px; }
  .tool-panel {
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-top: calc(-1 * var(--space-12));
    box-shadow: var(--shadow-lg, 0 12px 32px rgba(10, 10, 15, 0.06));
    margin-bottom: var(--space-12);
  }
  @media (max-width: 700px) {
    .tool-panel { margin-top: calc(-1 * var(--space-8)); padding: var(--space-5); }
  }

  .prose :global(p) { font-size: var(--fs-base); line-height: var(--lh-base); color: var(--ink-2); margin-bottom: var(--space-4); }
  .prose :global(h2) { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-top: var(--space-10); margin-bottom: var(--space-3); letter-spacing: var(--tracking-tight); }
  .prose :global(h3) { font-size: var(--fs-lg); font-weight: 600; color: var(--ink-1); margin-top: var(--space-6); margin-bottom: var(--space-2); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin-bottom: var(--space-4); color: var(--ink-2); line-height: var(--lh-base); }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(a) { color: var(--ink-1); font-weight: 500; text-decoration: underline; }
  .prose :global(strong) { color: var(--ink-1); }

  .faq-wrap { margin-top: var(--space-12); }
  .all-tools { margin-top: var(--space-8); }
  .all-tools a { font-size: var(--fs-sm); color: var(--ink-3); }
  .all-tools a:hover { color: var(--ink-1); }

  /* Shared tool-UI primitives (used by the pages' slotted markup) */
  .tool-panel :global(label) { display: block; font-size: var(--fs-sm); font-weight: 500; color: var(--ink-1); margin-bottom: var(--space-2); }
  .tool-panel :global(input[type='text']),
  .tool-panel :global(input[type='url']),
  .tool-panel :global(textarea) {
    width: 100%;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--ink-1);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
  }
  .tool-panel :global(textarea) { min-height: 160px; resize: vertical; }
  .tool-panel :global(input:focus-visible), .tool-panel :global(textarea:focus-visible) {
    outline: none;
    border-color: var(--border-2);
    box-shadow: 0 0 0 3px var(--accent-ring);
  }
  .tool-panel :global(.tool-row) { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: flex-end; }
  .tool-panel :global(.tool-row > .grow) { flex: 1 1 320px; }
  .tool-panel :global(.tool-actions) { margin-top: var(--space-4); display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .tool-panel :global(.tool-status) { margin-top: var(--space-4); font-size: var(--fs-sm); color: var(--ink-3); }
  .tool-panel :global(.tool-status.is-error) { color: #b42318; }
  .tool-panel :global(.tool-output) {
    margin-top: var(--space-5);
    max-height: 480px;
    overflow: auto;
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    font-size: var(--fs-sm);
    line-height: var(--lh-base);
    color: var(--ink-2);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .tool-panel :global(table.tool-table) { width: 100%; border-collapse: collapse; margin-top: var(--space-5); font-size: var(--fs-sm); }
  .tool-panel :global(table.tool-table th), .tool-panel :global(table.tool-table td) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--border-1);
    color: var(--ink-2);
    word-break: break-all;
  }
  .tool-panel :global(table.tool-table th) { color: var(--ink-1); font-weight: 600; border-top: none; }
  .tool-panel :global(input[type='file']) { font-size: var(--fs-sm); color: var(--ink-2); }
  .tool-panel :global(.hidden) { display: none; }
</style>
