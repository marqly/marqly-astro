---
/**
 * Visible FAQ accordion. The page is responsible for emitting the matching
 * FAQPage JSON-LD (via lib/schema.faqPage) so schema and visible text stay
 * identical.
 */
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  /** Optional map of question → /faq/<slug> "full answer" link. */
  links?: Record<string, string>;
}
const { faqs, heading, links = {} } = Astro.props;
---

{faqs.length > 0 && (
  <section class="faq-block">
    {heading && <h2>{heading}</h2>}
    <div class="faq-items">
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            {f.q}
            <span class="chev" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </summary>
          <div class="faq-a">
            <p>{f.a}</p>
            {links[f.q] && <p><a href={links[f.q]}>Full answer →</a></p>}
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq-block h2 {
    font-size: var(--fs-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
    margin-bottom: var(--space-6);
  }
  .faq-items { display: flex; flex-direction: column; gap: var(--space-3); }
  .faq-item {
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-md);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .faq-item:hover { border-color: var(--border-2); }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
    padding: var(--space-5) var(--space-6);
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--ink-1);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .chev { color: var(--ink-4); flex-shrink: 0; transition: transform var(--dur-base) var(--ease-out); }
  .faq-item[open] .chev { transform: rotate(180deg); }
  .faq-a { padding: 0 var(--space-6) var(--space-5); }
  .faq-a p {
    font-size: var(--fs-sm);
    line-height: var(--lh-base);
    color: var(--ink-2);
  }
  .faq-a p + p { margin-top: var(--space-3); }
  .faq-a a { color: var(--ink-1); font-weight: 500; text-decoration: underline; }
</style>
