---
/**
 * Shared renderer for locale landers (src/content/locale-pages/<lang>/*.md).
 * Mirrors the English [usecase].astro lander, but every chrome string comes
 * from the entry's own frontmatter so the page is 100% in its language.
 */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FaqAccordion from './FaqAccordion.astro';
import CtaBox from './CtaBox.astro';
import {
  CHROME_STORE_URL,
  breadcrumbList,
  faqPage,
  organization,
  softwareApplication,
  webSite,
} from '../../lib/schema';
import { alternatesForPath } from '../../i18n/routes';

interface Props {
  entry: CollectionEntry<'localePages'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const crumbs = [
  { name: d.crumbHome, path: `/${d.lang}` },
  { name: d.title, path: d.path },
];

const jsonLd = [
  organization(),
  webSite(d.lang),
  softwareApplication(),
  breadcrumbList(crumbs),
  ...(d.faqs.length ? [faqPage(d.faqs, d.lang)] : []),
];
---

<LandingLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  canonical={`https://www.marqly.com${d.path}`}
  jsonLd={jsonLd}
  lang={d.lang}
  alternates={alternatesForPath(d.path)}
  showLinkHub={false}
>
  <section class="hero-lite">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      {d.eyebrow && <span class="eyebrow">{d.eyebrow}</span>}
      <h1>{d.hero.heading}</h1>
      <p class="sub">{d.hero.subheading}</p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--lg" href={d.ctaUrl}>{d.ctaLabel} <span class="arrow">→</span></a>
        <a class="btn btn--outline btn--lg" href={CHROME_STORE_URL} target="_blank" rel="noopener">{d.ctaSecondaryLabel}</a>
      </div>
      <p class="hero-trust">{d.trustLine}</p>
    </div>
  </section>

  <article class="section">
    <div class="container narrow">
      <div class="prose">
        <Content />
      </div>

      {d.faqs.length > 0 && (
        <div class="faq-wrap">
          <FaqAccordion faqs={d.faqs} heading={d.faqHeading} />
        </div>
      )}

      <CtaBox
        ctaUrl={d.ctaUrl}
        ctaLabel={d.ctaLabel}
        secondaryLabel={d.ctaSecondaryLabel}
        heading={d.hero.heading}
        sub={d.description}
      />
    </div>
  </article>
</LandingLayout>

<style>
  .hero-lite {
    padding-block: var(--space-16) var(--space-12);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border-1);
  }
  .hero-lite .eyebrow { margin-bottom: var(--space-5); }
  .hero-lite h1 {
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
    line-height: var(--lh-tight);
    max-width: 22ch;
  }
  .hero-lite .sub {
    margin-top: var(--space-5);
    font-size: var(--fs-lg);
    color: var(--ink-2);
    max-width: 58ch;
    line-height: var(--lh-base);
  }
  .hero-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero-trust {
    margin-top: var(--space-5);
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  @media (max-width: 700px) {
    .hero-lite { padding-block: var(--space-12) var(--space-10); }
  }

  .narrow { max-width: 760px; }
  .prose :global(p) {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }
  .prose :global(h2) {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--ink-1);
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
    letter-spacing: var(--tracking-tight);
  }
  .prose :global(h3) {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--ink-1);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: var(--space-4);
    color: var(--ink-2);
    line-height: var(--lh-base);
  }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(a) { color: var(--ink-1); font-weight: 500; text-decoration: underline; }
  .prose :global(strong) { color: var(--ink-1); }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: var(--space-6);
    font-size: var(--fs-sm);
  }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border-1);
    color: var(--ink-2);
  }
  .prose :global(th) { color: var(--ink-1); font-weight: 600; }

  .faq-wrap { margin-top: var(--space-12); }
</style>
