---
/**
 * Shared blog index for locale trees (/es/blog, /pt/blog, /de/blog, /fr/blog,
 * /it/blog). Lists posts whose frontmatter `lang` matches, in that locale's
 * own chrome. Thin per-locale pages under src/pages/<lang>/blog/index.astro
 * just render this with their lang.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import LandingLayout from '../../layouts/LandingLayout.astro';
import { alternatesForPath } from '../../i18n/routes';
import { BLOG_UI } from '../../i18n/ui';

interface Props {
  lang: 'es' | 'pt' | 'de' | 'fr' | 'it' | 'ja' | 'zh' | 'ko' | 'nl' | 'pl' | 'tr';
}
const { lang } = Astro.props;

const STRINGS: Record<Props['lang'], {
  title: string; description: string; kicker: string; h1: string; sub: string;
  enBefore: string; enLink: string; enAfter: string;
}> = {
  es: {
    title: 'El Blog de Marqly en Español — Marcadores, IA y Segundo Cerebro',
    description: 'Guías y comparativas en español: gestionar marcadores, apps para leer más tarde, búsqueda con IA y tu segundo cerebro en el navegador. Del equipo de Marqly.',
    kicker: 'El Blog de Marqly',
    h1: 'Guarda con criterio. Encuéntralo todo.',
    sub: 'Guías y comparativas en español sobre marcadores con IA, apps para leer más tarde y un segundo cerebro que sí se puede buscar.',
    enBefore: 'Hay más artículos en el ', enLink: 'blog en inglés', enAfter: ' — la edición en español está creciendo.',
  },
  pt: {
    title: 'O Blog da Marqly em Português — Favoritos, IA e Segundo Cérebro',
    description: 'Guias e comparativos em português: organizar favoritos, apps de salvar para ler depois, busca com IA e o seu segundo cérebro no navegador. Do time da Marqly.',
    kicker: 'O Blog da Marqly',
    h1: 'Salve com método. Encontre tudo.',
    sub: 'Guias e comparativos em português sobre favoritos com IA, apps de ler depois e um segundo cérebro que dá para pesquisar de verdade.',
    enBefore: 'Tem mais artigos no ', enLink: 'blog em inglês', enAfter: ' — a edição em português está crescendo.',
  },
  de: {
    title: 'Der Marqly Blog auf Deutsch — Lesezeichen, KI & zweites Gehirn',
    description: 'Ratgeber und Vergleiche auf Deutsch: Lesezeichen verwalten, Später-lesen-Apps, KI-Suche und das zweite Gehirn im Browser. Vom Team hinter Marqly.',
    kicker: 'Der Marqly Blog',
    h1: 'Speichern mit System. Alles wiederfinden.',
    sub: 'Ratgeber und Vergleiche auf Deutsch: Lesezeichen verwalten, Später-lesen-Apps und ein durchsuchbares zweites Gehirn im Browser.',
    enBefore: 'Mehr Artikel gibt es im ', enLink: 'englischen Blog', enAfter: ' — die deutschen Ausgaben wachsen gerade.',
  },
  fr: {
    title: 'Le Blog Marqly en Français — Favoris, IA et Second Cerveau',
    description: 'Guides et comparatifs en français : gérer ses favoris, applications de lecture différée, recherche par IA et second cerveau dans le navigateur. Par l’équipe Marqly.',
    kicker: 'Le Blog Marqly',
    h1: 'Sauvegardez avec méthode. Retrouvez tout.',
    sub: 'Guides et comparatifs en français sur les favoris avec IA, la lecture différée et un second cerveau vraiment cherchable.',
    enBefore: 'Retrouvez davantage d’articles sur le ', enLink: 'blog en anglais', enAfter: ' — l’édition française s’étoffe.',
  },
  it: {
    title: 'Il Blog di Marqly in Italiano — Segnalibri, AI e Secondo Cervello',
    description: 'Guide e confronti in italiano: gestire i segnalibri, app per leggere dopo, ricerca con AI e il secondo cervello nel browser. Dal team di Marqly.',
    kicker: 'Il Blog di Marqly',
    h1: 'Salva con metodo. Ritrova tutto.',
    sub: 'Guide e confronti in italiano su segnalibri con AI, app per leggere dopo e un secondo cervello davvero cercabile.',
    enBefore: 'Trovi altri articoli nel ', enLink: 'blog in inglese', enAfter: ' — l’edizione italiana sta crescendo.',
  },
  ja: {
    title: 'Marqly公式ブログ（日本語）— AIブックマーク＆第二の脳ガイド',
    description: 'ブックマーク整理、あとで読むアプリ、AI検索、ブラウザ上の第二の脳に関する日本語ガイドと徹底比較。Marqlyチームがお届けします。',
    kicker: 'Marqly 公式ブログ',
    h1: '賢く保存して、瞬時に見つける。',
    sub: 'AIブックマーク管理、あとで読むアプリ、真に検索可能な第二の脳に関する日本語ガイド。',
    enBefore: 'さらに多くの記事は', enLink: '英語版ブログ', enAfter: 'でも公開しています。日本語記事も順次拡大中です。',
  },
  zh: {
    title: 'Marqly 中文博客 — AI 书签管理与第二大脑指南',
    description: '书签整理、稍后读应用、AI 语义搜索与个人知识管理中文深度指南与对比。来自 Marqly 团队。',
    kicker: 'Marqly 博客',
    h1: '智能收藏，秒速找回。',
    sub: '探索 AI 书签管理、稍后读工具以及真正可语义检索的第二大脑中文指南。',
    enBefore: '更多前沿文章请访问', enLink: '英文博客', enAfter: ' — 中文专区正持续更新中。',
  },
  ko: {
    title: 'Marqly 한국어 블로그 — AI 북마크 & 두 번째 뇌 가이드',
    description: '북마크 정리, 나중에 읽기 앱, AI 시맨틱 검색, 브라우저 속 두 번째 뇌에 대한 한국어 가이드 및 비교. Marqly 팀 제공.',
    kicker: 'Marqly 블로그',
    h1: '스마트하게 저장하고, 바로 찾아보세요.',
    sub: 'AI 북마크 관리, 나중에 읽기 도구, 실제로 검색 가능한 두 번째 뇌에 관한 한국어 심층 가이드.',
    enBefore: '더 많은 아티클은 ', enLink: '영문 블로그', enAfter: '에서 확인하실 수 있으며, 한국어 콘텐츠도 지속 업데이트 중입니다.',
  },
  nl: {
    title: 'Het Marqly Blog in het Nederlands — Bladwijzers, AI & Tweede Brein',
    description: 'Gidsen en vergelijkingen in het Nederlands: bladwijzers beheren, later-lezen-apps, AI-zoekfunctie en een doorzoekbaar tweede brein. Van het Marqly-team.',
    kicker: 'Het Marqly Blog',
    h1: 'Sla slim op. Vind alles direct terug.',
    sub: 'Gidsen en vergelijkingen in het Nederlands over AI-bladwijzers, later-lezen-apps en een doorzoekbaar tweede brein.',
    enBefore: 'Meer artikelen vind je op het ', enLink: 'Engelstalige blog', enAfter: ' — de Nederlandse editie groeit continu.',
  },
  pl: {
    title: 'Blog Marqly po Polsku — Zakładki, AI i Drugi Mózg',
    description: 'Przewodniki i porównania po polsku: zarządzanie zakładkami, aplikacje do czytania na później, wyszukiwanie semantyczne AI i cyfrowy drugi mózg w przeglądarce.',
    kicker: 'Oficjalny Blog Marqly',
    h1: 'Zapisuj mądrze. Znajduj natychmiast.',
    sub: 'Przewodniki i rzetelne porównania po polsku: inteligentne zakładki z AI, czytanie na później i przeszukiwalny drugi mózg.',
    enBefore: 'Więcej artykułów znajdziesz na ', enLink: 'blogu po angielsku', enAfter: ' — polska edycja stale się powiększa.',
  },
  tr: {
    title: 'Marqly Türkçe Blog — Yer İmleri, Yapay Zeka ve İkinci Beyin',
    description: 'Türkçe rehberler ve karşılaştırmalar: yer imi yönetimi, daha sonra oku uygulamaları, yapay zeka ile anlamsal arama ve tarayıcınızdaki ikinci beyin.',
    kicker: 'Marqly Blog',
    h1: 'Akıllıca kaydedin. Anında bulun.',
    sub: 'Yapay zeka destekli yer imi yöneticisi, daha sonra oku çözümleri ve aradığınızı anında bulan ikinci beyin rehberleri.',
    enBefore: 'Daha fazla makale için ', enLink: 'İngilizce bloğumuzu', enAfter: ' ziyaret edebilirsiniz — Türkçe içeriklerimiz genişliyor.',
  },
};

const s = STRINGS[lang];
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const postHref = (id: string) => `/${lang}/blog/${id.replace(new RegExp(`^${lang}/`), '')}`;
const fmtDate = (d: Date) =>
  d.toLocaleDateString(BLOG_UI[lang].dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });

const path = `/${lang}/blog`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: s.kicker,
    url: `https://www.marqly.com${path}`,
    description: s.description,
    inLanguage: lang,
    blogPost: posts.slice(0, 20).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `https://www.marqly.com${postHref(p.id)}`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
];
---

<LandingLayout
  title={s.title}
  description={s.description}
  canonical={`https://www.marqly.com${path}`}
  jsonLd={jsonLd}
  lang={lang}
  alternates={alternatesForPath(path)}
  showLinkHub={false}
  localeLinkHub={lang}
>
  <div class="blog-index">
    <header class="blog-head">
      <p class="kicker">{s.kicker}</p>
      <h1>{s.h1}</h1>
      <p class="sub">{s.sub}</p>
    </header>

    <div class="grid">
      {posts.map((post) => (
        <a class="card" href={postHref(post.id)}>
          {post.data.heroImage && (
            <div class="card-img">
              <Image
                src={post.data.heroImage}
                alt={post.data.heroAlt ?? post.data.title}
                widths={[320, 480, 640]}
                sizes="(max-width: 700px) 100vw, 360px"
              />
            </div>
          )}
          <div class="card-body">
            <span class="chip">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          </div>
        </a>
      ))}
    </div>

    <p class="en-note">
      {s.enBefore}<a href="/blog">{s.enLink}</a>{s.enAfter}
    </p>
  </div>
</LandingLayout>

<style>
  .blog-index {
    max-width: 1140px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }
  .blog-head { max-width: 680px; margin-bottom: var(--space-16); }
  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  .blog-head h1 { font-size: var(--fs-h1); margin-bottom: var(--space-4); }
  .blog-head .sub { font-size: var(--fs-lg); color: var(--color-text-soft); line-height: var(--lh-snug); }

  .chip {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(0, 122, 255, 0.08);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
  }
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .card:hover { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); transform: translateY(-2px); }
  .card-img :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; }
  .card-body { padding: var(--space-6); display: flex; flex-direction: column; flex: 1; }
  .card-body h2 { font-size: var(--fs-lg); margin-bottom: var(--space-3); line-height: var(--lh-snug); }
  .card-body p { color: var(--color-text-soft); font-size: var(--fs-sm); margin-bottom: var(--space-4); }
  .card-body time { font-size: var(--fs-sm); color: var(--color-text-muted); margin-top: auto; }

  .en-note { margin-top: var(--space-12); font-size: var(--fs-sm); color: var(--color-text-muted); }
  .en-note a { text-decoration: underline; }
</style>
