---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.avif';

const nav = [
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Reviews', href: '/#reviews' },
  { label: 'Blog', href: '/blog' },
  { label: 'Help', href: 'https://help.marqly.com/' },
];

const CHROME_STORE =
  'https://chromewebstore.google.com/detail/marqly-all-in-one-bookmar/kcadneobjofkppmekgadodnaojoehemc';
const APP = 'https://app.marqly.com';
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Marqly home">
      <Image src={logo} alt="Marqly" height={28} width={112} densities={[1, 2]} />
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <a href={CHROME_STORE} class="btn btn--outline btn--sm hide-sm" target="_blank" rel="noopener">
        Install Extension
      </a>
      <a href={APP} class="btn btn--dark btn--sm">
        Open Marqly
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" data-mobile-menu hidden>
    <nav class="mobile-nav" aria-label="Mobile">
      {nav.map((item) => <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a>)}
      <a href={CHROME_STORE} target="_blank" rel="noopener">Install Extension</a>
      <a href={APP} class="mobile-cta">Open Marqly →</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.querySelector('[data-header]');
    if (!header) return;

    // Add elevated style when user scrolls past the hero
    const onScroll = () => {
      if (window.scrollY > 8) header.classList.add('is-scrolled');
      else header.classList.remove('is-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu toggle
    const toggle = header.querySelector('[data-menu-toggle]');
    const menu = header.querySelector('[data-mobile-menu]');
    if (toggle && menu) {
      const setOpen = (open) => {
        toggle.setAttribute('aria-expanded', String(open));
        if (open) menu.removeAttribute('hidden');
        else menu.setAttribute('hidden', '');
        toggle.classList.toggle('is-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
      };
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        setOpen(!open);
      });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 240ms var(--ease-out), background 240ms var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--border-1);
    background: rgba(255, 255, 255, 0.88);
  }
  .header-inner {
    display: flex;
    align-items: center;
    height: var(--header-h);
    gap: var(--space-6);
  }
  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand :global(img) {
    height: 28px;
    width: auto;
    max-width: 112px;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .brand-word {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink-1);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-shrink: 0;
  }
  .nav a {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: var(--tracking-base);
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--dur-base) var(--ease-out);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1.5px;
    background: var(--ink-1);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .nav a:hover { color: var(--ink-1); }
  .nav a:hover::after { transform: scaleX(1); }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    flex: 1;
    min-width: 0;
  }

  .menu-toggle {
    display: none;
    width: 40px; height: 40px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-1);
    background: var(--surface-1);
  }
  .menu-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink-1);
    border-radius: 2px;
    transition: transform 240ms var(--ease-out), opacity 240ms var(--ease-out);
  }
  .menu-toggle.is-open span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .menu-toggle.is-open span:nth-child(2) { opacity: 0; }
  .menu-toggle.is-open span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .mobile-menu {
    border-top: 1px solid var(--border-1);
    background: var(--surface-1);
    padding: var(--space-6) 0 var(--space-8);
    animation: navIn 240ms var(--ease-out);
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-inline: var(--container-pad);
  }
  .mobile-nav a {
    display: block;
    padding: 0.85rem 0.25rem;
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--ink-1);
    border-bottom: 1px solid var(--border-1);
  }
  .mobile-nav a:last-child { border-bottom: 0; }
  .mobile-cta {
    margin-top: var(--space-4);
    background: var(--ink-1);
    color: #fff;
    text-align: center;
    border-radius: var(--radius-pill);
    padding: 0.95rem 1.5rem;
    border: 0;
  }

  @keyframes navIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 860px) {
    .nav { display: none; }
    .hide-sm { display: none; }
    .menu-toggle { display: inline-flex; }
  }
</style>
