---
/*
 * Site-wide promo strip. Compact red→pink gradient bar pinned at the top of
 * every page (in normal flow, above the nav). Dismissible — once closed it
 * stays hidden for that visitor via localStorage. Bump PROMO_KEY to re-show
 * after the offer/copy changes.
 */
const PROMO_KEY = 'marqly_promo_50off_yearly_v1';
// Scroll to the pricing section on the homepage — NOT the old standalone /Pricing page (removed).
const HREF = '/#pricing';
---

<div class="promo-bar" id="promo-bar">
  <div class="promo-inner">
    <span class="promo-text">
      <span class="promo-emoji" aria-hidden="true">✨</span>
      Save <strong>27%</strong> with Marqly yearly — <strong>$79/year</strong>.
    </span>
    <a class="promo-cta" href={HREF}>Upgrade&nbsp;→</a>
  </div>
  <button class="promo-close" id="promo-close" type="button" aria-label="Dismiss announcement">✕</button>
</div>

<script is:inline define:vars={{ PROMO_KEY }}>
  (function () {
    var bar = document.getElementById('promo-bar');
    if (!bar) return;
    try {
      if (localStorage.getItem(PROMO_KEY) === 'dismissed') { bar.remove(); return; }
    } catch (e) {}
    var btn = document.getElementById('promo-close');
    if (btn) {
      btn.addEventListener('click', function () {
        bar.style.display = 'none';
        try { localStorage.setItem(PROMO_KEY, 'dismissed'); } catch (e) {}
      });
    }
  })();
</script>

<style>
  .promo-bar {
    position: relative;
    width: 100%;
    color: #fff;
    background: linear-gradient(90deg, #e11900 0%, #f4106e 45%, #fc037b 70%, #e11900 100%);
    background-size: 200% 100%;
    animation: promo-shift 10s linear infinite;
    z-index: 60;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
  }

  .promo-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    min-height: 40px;
    padding: 0.4rem 2.6rem;
    text-align: center;
  }

  .promo-text {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.3;
  }
  .promo-text strong { font-weight: 700; }
  .promo-emoji { margin-right: 0.1rem; }

  .promo-cta {
    display: inline-flex;
    align-items: center;
    background: #fff;
    color: #d40d5e;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.3rem 0.72rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .promo-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.22);
  }

  .promo-close {
    position: absolute;
    right: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    background: transparent;
    border: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.78rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 6px;
    transition: background 150ms ease, color 150ms ease;
  }
  .promo-close:hover { color: #fff; background: rgba(255, 255, 255, 0.16); }

  @keyframes promo-shift {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-bar { animation: none; }
    .promo-cta { transition: none; }
  }

  @media (max-width: 520px) {
    .promo-inner { padding: 0.4rem 2.3rem; gap: 0.4rem; }
    .promo-text { font-size: 0.74rem; }
    .promo-cta { font-size: 0.72rem; padding: 0.26rem 0.6rem; }
  }
</style>
