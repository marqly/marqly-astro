---
import '@fontsource-variable/geist';
import '../styles/global.css';
/* New design system LAST so its font + base tokens win site-wide; page
   content keeps its scoped styles, only the shell + typography unify. */
import '../styles/landing.css';
import Nav from '../components/landing/Nav.astro';
import FooterV2 from '../components/landing/FooterV2.astro';
import LinkHub from '../components/seo/LinkHub.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://www.marqly.com/og-default.png',
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

// build.format:'file' leaks ".html" into pathname during prerender — normalize
// so canonicals stay extensionless, matching served URLs and the sitemap.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonicalURL = canonical ?? new URL(cleanPath, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@getmarqly" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Marqly Blog" href="/rss.xml" />

    {
      jsonLd.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }

    <!-- GA4 — same property as marqly.com, gated to the marqly.com host -->
    <script is:inline define:vars={{ gaId: 'G-M6QHXLGPG7' }}>
      if (location.hostname === 'marqly.com' || location.hostname.endsWith('.marqly.com')) {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <div class="linkhub-compat">
      <LinkHub />
    </div>
    <FooterV2 />

    <!-- Scroll reveal observer — single tiny script for the whole site -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
        // Safety net: if anything is still hidden after 2.5s (e.g. observer mis-fires,
        // very tall pages, paused tabs), reveal the rest so nothing is permanently invisible.
        setTimeout(() => els.forEach((el) => el.classList.add('is-visible')), 2500);
      })();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 12px;
        background: var(--ink-1);
        color: #fff;
        padding: 0.5rem 0.9rem;
        border-radius: var(--radius-pill);
        font-size: var(--fs-sm);
        font-weight: 500;
        z-index: 100;
        transition: top 200ms var(--ease-out);
      }
      .skip-link:focus-visible {
        top: 12px;
        outline: none;
        box-shadow: 0 0 0 3px var(--accent-ring);
      }
    </style>
  </body>
</html>
