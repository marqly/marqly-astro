---
import LandingLayout from './LandingLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const slug = post.id;

// Related posts: same category first, then tag overlap — keeps every post
// linked into its cluster (crawl depth + dwell time).
const allPosts = await getCollection('blog', (p) => !p.data.draft && p.id !== post.id);
const tagSet = new Set(data.tags);
const related = allPosts
  .map((p) => ({
    p,
    score:
      (p.data.category === data.category ? 2 : 0) +
      p.data.tags.filter((t) => tagSet.has(t)).length,
  }))
  .sort((x, y) => y.score - x.score || y.p.data.pubDate.valueOf() - x.p.data.pubDate.valueOf())
  .slice(0, 4)
  .map((x) => x.p);
const url = `https://www.marqly.com/blog/${slug}`;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'Marqly', url: 'https://www.marqly.com' },
  publisher: {
    '@type': 'Organization',
    name: 'Marqly',
    logo: { '@type': 'ImageObject', url: 'https://www.marqly.com/favicon.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(data.ogImage ? { image: data.ogImage } : {}),
  ...(data.tags.length ? { keywords: data.tags.join(', ') } : {}),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.marqly.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.marqly.com/blog' },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};

const faqPage = data.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

// Entity schema — asserts Marqly as a recognizable software product + organization on
// every post. Helps answer engines (Google AI Overviews, ChatGPT, Perplexity) confidently
// cite/recommend Marqly in "best X" answers. Paid price intentionally omitted until the
// live Stripe pricing is confirmed; the free tier (0) is asserted via AggregateOffer.
const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Marqly',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Web, iOS, Chrome, Edge, Firefox, Safari',
  url: 'https://www.marqly.com',
  description:
    'AI bookmark manager with semantic search — save articles, videos, and links, then find any of them by describing what you remember instead of the exact title.',
  featureList: [
    'Semantic AI search (find saves by meaning, not keywords)',
    'Automatic AI tagging',
    'AI article summaries',
    'AI YouTube summaries, chat, and playback-synced transcript on the watch page',
    'Web highlighter — 6 colors and notes that persist on any page',
    'Save any webpage as a clean, screen-faithful PDF',
    'Public board sharing — links and highlights, no signup to view',
    'Import from Pocket, Raindrop, and browser bookmarks',
  ],
  offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: '0', offerCount: 2 },
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Marqly',
  url: 'https://www.marqly.com',
  logo: 'https://www.marqly.com/favicon.png',
  sameAs: ['https://twitter.com/getmarqly', 'https://x.com/getmarqly'],
};

const jsonLd = [blogPosting, breadcrumb, softwareApp, organization, ...(faqPage ? [faqPage] : [])];
---

<LandingLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  canonical={url}
  ogImage={data.ogImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="post-header">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Blog</a>
      </nav>
      <p class="kicker">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="dek">{data.description}</p>
      <div class="byline">
        <span>Marqly Team</span>
        <span class="dot">·</span>
        <time datetime={data.pubDate.toISOString()}>{fmtDate(data.pubDate)}</time>
        {data.updatedDate && (
          <>
            <span class="dot">·</span>
            <span>Updated {fmtDate(data.updatedDate)}</span>
          </>
        )}
      </div>
    </header>

    {data.heroImage && (
      <figure class="hero">
        <Image src={data.heroImage} alt={data.heroAlt ?? data.title} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 760px" />
      </figure>
    )}

    <div class="post-body">
      <slot />
    </div>

    {data.faqs.length > 0 && (
      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl>
          {data.faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <aside class="post-cta">
      <h2>Stop losing what you save.</h2>
      <p>Marqly turns everything you bookmark into a searchable, AI-powered second brain. Ask it anything — find saves by meaning, not keywords.</p>
      <a class="cta-btn" href={data.ctaUrl}>{data.ctaLabel} →</a>
    </aside>

    {related.length > 0 && (
      <nav class="related-posts" aria-label="Related articles">
        <h2>Keep reading</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/blog/${r.id}`}>
                <span class="rp-cat">{r.data.category}</span>
                <span class="rp-title">{r.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</LandingLayout>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }

  .related-posts {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-1);
  }
  .related-posts h2 {
    font-size: var(--fs-h4);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }
  .related-posts ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .related-posts a {
    display: block;
    height: 100%;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .related-posts a:hover { border-color: var(--border-2); }
  .rp-cat {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin-bottom: var(--space-1);
  }
  .rp-title { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-1); line-height: var(--lh-snug); }
  @media (max-width: 620px) { .related-posts ul { grid-template-columns: 1fr; } }

  .crumbs {
    display: flex;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }
  .crumbs a:hover { color: var(--color-link-hover); }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .post-header h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    color: rgba(10, 10, 10, 1);
    margin-bottom: var(--space-4);
  }

  .dek {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--color-text-soft);
    margin-bottom: var(--space-6);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
  .byline .dot { opacity: 0.5; }

  .hero {
    margin: var(--space-12) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .hero :global(img) { width: 100%; height: auto; }

  /* Article body */
  .post-body {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-heading-soft);
  }
  .post-body :global(h2) {
    font-size: var(--fs-h2);
    margin: var(--space-12) 0 var(--space-4);
    scroll-margin-top: 100px;
  }
  .post-body :global(h3) {
    font-size: var(--fs-h3);
    margin: var(--space-8) 0 var(--space-3);
  }
  .post-body :global(p) { margin: var(--space-4) 0; }
  .post-body :global(ul) { list-style: disc; }
  .post-body :global(ol) { list-style: decimal; }
  .post-body :global(ul),
  .post-body :global(ol) { margin: var(--space-4) 0; padding-left: var(--space-6); }
  .post-body :global(li) { margin: var(--space-2) 0; }
  .post-body :global(li::marker) { color: var(--ink-4); }
  .post-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-body :global(a:hover) { color: var(--color-primary-hover); }
  .post-body :global(strong) { color: var(--color-heading); font-weight: 600; }
  .post-body :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-8) 0;
    border: 1px solid var(--color-border);
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-6);
    margin: var(--space-8) 0;
    color: var(--color-text-soft);
    font-style: italic;
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-bg-alt);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
  }
  .post-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-12) 0;
  }
  .post-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: separate;
    border-spacing: 0;
    margin: var(--space-8) 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
    border: 1px solid #e1e3e8;
    border-radius: var(--radius-lg);
  }
  .post-body :global(thead) { background: var(--color-bg-alt); }
  .post-body :global(th),
  .post-body :global(td) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid #ebedf0;
    border-right: 1px solid #ebedf0;
    vertical-align: top;
  }
  .post-body :global(th:last-child),
  .post-body :global(td:last-child) { border-right: none; }
  .post-body :global(tbody tr:last-child td) { border-bottom: none; }
  .post-body :global(th) {
    color: var(--color-heading);
    font-weight: 600;
    white-space: nowrap;
    border-bottom: 1px solid #e1e3e8;
  }
  .post-body :global(tbody tr:nth-child(even)) { background: rgba(13, 13, 16, 0.022); }
  .post-body :global(tbody tr:hover) { background: var(--accent-mute); }

  /* FAQ */
  .faq {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
  }
  .faq h2 { font-size: var(--fs-h3); margin-bottom: var(--space-6); }
  .faq-item { padding: var(--space-4) 0; border-bottom: 1px solid var(--color-border); }
  .faq dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-heading);
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
  }
  .faq dd { margin: 0; color: var(--color-text-soft); line-height: var(--lh-base); }

  /* CTA card */
  .post-cta {
    position: relative;
    margin-top: var(--space-16);
    padding: var(--space-12);
    background: linear-gradient(135deg, var(--accent-mute) 0%, var(--accent-soft) 100%);
    border: 1px solid var(--accent-ring);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-float);
    text-align: center;
    overflow: hidden;
  }
  /* subtle accent glow in the corner */
  .post-cta::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(0, 122, 255, 0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .post-cta h2 {
    position: relative;
    font-size: var(--fs-h2);
    letter-spacing: -0.01em;
    color: var(--ink-1);
    margin-bottom: var(--space-3);
  }
  .post-cta p {
    position: relative;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--color-text-soft);
    max-width: 48ch;
    margin: 0 auto var(--space-8);
  }
  .cta-btn {
    position: relative;
    display: inline-block;
    background: var(--accent-grad);
    color: #fff;
    font-weight: 600;
    font-size: 1.05rem;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-pill);
    box-shadow: 0 6px 18px rgba(0, 122, 255, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(0, 122, 255, 0.34);
  }

  @media (max-width: 760px) {
    .post { padding: var(--space-12) var(--space-4) var(--space-16); }
    .post-cta { padding: var(--space-8) var(--space-6); }
  }
</style>
