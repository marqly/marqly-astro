---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import LandingLayout from '../../layouts/LandingLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const [featured, ...rest] = posts;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const title = 'The Marqly Blog — AI Bookmarking & Second Brain Guides';
const description =
  'Guides, comparisons, and tips on AI bookmark managers, read-it-later apps, and building a searchable second brain. From the team behind Marqly.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Marqly Blog',
    url: 'https://www.marqly.com/blog',
    description,
    blogPost: posts.slice(0, 20).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `https://www.marqly.com/blog/${p.id}`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
];
---

<LandingLayout
  title={title}
  description={description}
  canonical="https://www.marqly.com/blog"
  jsonLd={jsonLd}
>
  <div class="blog-index">
    <header class="blog-head">
      <p class="kicker">The Marqly Blog</p>
      <h1>Save smarter. Find anything.</h1>
      <p class="sub">
        Guides, comparisons, and ideas on AI bookmarking, read-it-later apps, and building a
        searchable second brain.
      </p>
    </header>

    {featured && (
      <a class="featured" href={`/blog/${featured.id}`}>
        {featured.data.heroImage && (
          <div class="featured-img">
            <Image
              src={featured.data.heroImage}
              alt={featured.data.heroAlt ?? featured.data.title}
              widths={[600, 1000, 1400]}
              sizes="(max-width: 900px) 100vw, 760px"
            />
          </div>
        )}
        <div class="featured-body">
          <span class="chip">{featured.data.category}</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <time datetime={featured.data.pubDate.toISOString()}>{fmtDate(featured.data.pubDate)}</time>
        </div>
      </a>
    )}

    <div class="grid">
      {rest.map((post) => (
        <a class="card" href={`/blog/${post.id}`}>
          {post.data.heroImage && (
            <div class="card-img">
              <Image
                src={post.data.heroImage}
                alt={post.data.heroAlt ?? post.data.title}
                widths={[320, 480, 640]}
                sizes="(max-width: 700px) 100vw, 360px"
              />
            </div>
          )}
          <div class="card-body">
            <span class="chip">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          </div>
        </a>
      ))}
    </div>
  </div>
</LandingLayout>

<style>
  .blog-index {
    max-width: 1140px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }
  .blog-head { max-width: 680px; margin-bottom: var(--space-16); }
  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  .blog-head h1 { font-size: var(--fs-h1); margin-bottom: var(--space-4); }
  .blog-head .sub { font-size: var(--fs-lg); color: var(--color-text-soft); line-height: var(--lh-snug); }

  .chip {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(0, 122, 255, 0.08);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }

  /* Featured */
  .featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-16);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .featured:hover { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); transform: translateY(-2px); }
  .featured-img { border-radius: var(--radius-lg); overflow: hidden; }
  .featured-img :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3 / 2; }
  .featured-body h2 { font-size: var(--fs-h3); margin-bottom: var(--space-3); }
  .featured-body p { color: var(--color-text-soft); margin-bottom: var(--space-4); }
  .featured-body time { font-size: var(--fs-sm); color: var(--color-text-muted); }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
  }
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .card:hover { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); transform: translateY(-2px); }
  .card-img :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; }
  .card-body { padding: var(--space-6); display: flex; flex-direction: column; flex: 1; }
  .card-body h3 { font-size: var(--fs-lg); margin-bottom: var(--space-3); line-height: var(--lh-snug); }
  .card-body time { font-size: var(--fs-sm); color: var(--color-text-muted); margin-top: auto; }

  @media (max-width: 900px) {
    .featured { grid-template-columns: 1fr; }
  }
</style>
