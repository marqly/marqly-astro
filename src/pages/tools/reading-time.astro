---
import LandingLayout from '../../layouts/LandingLayout.astro';
import ToolShell from '../../components/seo/ToolShell.astro';
import { breadcrumbList, faqPage, freeWebApplication, organization, webSite } from '../../lib/schema';

const title = 'Reading Time Calculator: Free, Instant, No Sign-Up';
const description =
  'Paste any text to get its word count, character count, reading time at 238 words per minute, and speaking time at 150 wpm. Free, instant, no signup needed.';

const faqs = [
  {
    q: 'How is reading time calculated?',
    a: 'Word count divided by reading speed. This tool counts words by splitting on whitespace, then divides by 238 words per minute — the average adult silent-reading rate for non-fiction English found in a large 2019 meta-analysis of reading research. Speaking time uses 150 wpm, a comfortable presentation pace. Both are rounded to the nearest few seconds, not up to whole minutes.',
  },
  {
    q: 'Is 238 words per minute right for everyone?',
    a: 'No — it is an average, and the spread around it is wide. Skimming runs far faster; studying dense technical material runs slower; reading in a second language slower still. Treat the number as a planning estimate for typical prose, not a stopwatch. Fiction averages slightly higher, around 260 wpm.',
  },
  {
    q: 'Why do reading-time estimates differ between sites?',
    a: 'Three reasons: different assumed speeds (tools use anywhere from 180 to 300 wpm), different word counting (code blocks, captions, and headings may or may not count), and adjustments some sites make for images — Medium famously adds 12 seconds for the first image. Same article, honestly different answers.',
  },
  {
    q: 'Is my text stored anywhere?',
    a: 'No. Counting happens in your browser as you type — the text never leaves the page, there is no server call, and nothing persists after you close the tab. Paste unpublished drafts freely.',
  },
  {
    q: 'How exactly are words counted?',
    a: 'The page splits your text at whitespace and counts the resulting chunks, so a URL, a code token, or a long hyphenated string each counts as one word. A raw character count, spaces included, is shown beside it so you can sanity-check the number.',
  },
  {
    q: 'Does the estimate work for non-English text?',
    a: 'It works for any language that separates words with spaces — the 238 wpm figure is an English-based average, so treat the result as a planning estimate elsewhere. Languages written without word spaces, such as Chinese, Japanese, or Thai, are undercounted by any whitespace-based counter, including this one, so the minute estimate is not meaningful for them.',
  },
  {
    q: 'Can I use this for my blog’s “min read” label?',
    a: 'Yes. The number is simply your word count divided by 238, and the calculator needs no account. Keep in mind that other platforms assume different speeds — anywhere from 180 to 300 wpm — so your label will not always match a competitor’s for the same article.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Free tools', path: '/tools' },
    { name: 'Reading time calculator', path: '/tools/reading-time' },
  ]),
  faqPage(faqs),
  freeWebApplication(
    'Reading time calculator',
    'Paste any text to get its word count, character count, reading time at 238 words per minute, and speaking time at 150 wpm. Free, instant, no signup needed.',
    '/tools/reading-time',
  ),
];
---

<LandingLayout title={title} description={description} jsonLd={jsonLd} ogImage="https://www.marqly.com/og/seo/tool-reading-time.png">
  <ToolShell
    name="Reading time calculator"
    heading="How long will it take to read?"
    sub="Paste text and get word count, character count, reading time, and speaking time — live, as you type. Nothing leaves your browser."
    faqs={faqs}
    ctaHeading="Reading list longer than your reading time?"
    ctaSub="Save articles to Marqly and AI summarizes them — triage a backlog in minutes, then read only what earns the time."
  >
    <label for="rt-in">Your text</label>
    <textarea id="rt-in" placeholder="Paste an article, essay, script, or chapter…"></textarea>
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-4); margin-top: var(--space-5);"
    >
      <div>
        <div id="rt-read" style="font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1);">0 sec</div>
        <div style="font-size: var(--fs-sm); color: var(--ink-3);">Reading time (238 wpm)</div>
      </div>
      <div>
        <div id="rt-speak" style="font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1);">0 sec</div>
        <div style="font-size: var(--fs-sm); color: var(--ink-3);">Speaking time (150 wpm)</div>
      </div>
      <div>
        <div id="rt-words" style="font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1);">0</div>
        <div style="font-size: var(--fs-sm); color: var(--ink-3);">Words</div>
      </div>
      <div>
        <div id="rt-chars" style="font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1);">0</div>
        <div style="font-size: var(--fs-sm); color: var(--ink-3);">Characters</div>
      </div>
    </div>

    <Fragment slot="content">
      <h2>How reading time is calculated</h2>
      <p>
        The formula is unglamorous: <em>words ÷ reading speed</em>. The interesting part is which
        speed you divide by. This tool uses <strong>238 words per minute</strong>, the average
        adult silent-reading rate for non-fiction English established by Marc Brysbaert's 2019
        meta-analysis, which pooled measurements from nearly 200 reading studies. It is the most
        defensible single number available — most "average person reads 200–250 wpm" claims trace
        back to far thinner evidence. Speaking time uses 150 wpm, a comfortable pace for
        presentations and voiceover; conversational speech runs faster, but scripts read aloud
        shouldn't.
      </p>

      <h2>Why the average hides a wide range</h2>
      <p>
        238 wpm describes typical adults reading typical prose for comprehension. Real reading
        speed swings with purpose and material: skimming for the gist can triple the rate, while
        working through a dense methods section or legal clause can halve it. Fiction reads a bit
        faster than non-fiction (around 260 wpm in the same meta-analysis) because narrative
        vocabulary is more predictable. Second-language readers, and anyone reading on a cramped
        phone screen in a moving train, come in below average. So a "12 min read" label is a
        planning estimate, not a promise.
      </p>

      <h2>Why article estimates vary between sites</h2>
      <p>
        Paste the same article here and into three publishing platforms and you may get four
        answers. Platforms disagree on the assumed speed (anywhere from 180 to 300 wpm), on what
        counts as a word (headings, captions, code blocks), and on adjustments for non-text
        content — Medium adds 12 seconds for the first image and scales down from there. None of
        them are wrong; they are just measuring slightly different things. This tool stays simple
        on purpose: whitespace-separated words, one well-sourced speed, no image fudge factors.
      </p>

      <h2>How to use the calculator</h2>
      <ol>
        <li>Paste an article, essay, script, or chapter into the box — the four counters update live as you type. There is no button to press.</li>
        <li>Check the word count first. If it looks off, you probably pasted menus, captions, or code along with the prose; trim the text and the numbers recalculate instantly.</li>
        <li>Read the default estimate at 238 wpm, then adjust for your actual reader with the speed table below — the arithmetic is just words ÷ speed.</li>
        <li>Planning a course or a queue? Run each piece and add the minutes up; the rough planning speeds below are good enough for batching.</li>
      </ol>

      <h2>Reference: which reading speed to assume</h2>
      <table>
        <thead>
          <tr>
            <th scope="col">Reader or mode</th>
            <th scope="col">Assumed speed</th>
            <th scope="col">Where the number comes from</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Adult silent reading, English non-fiction</td>
            <td>238 wpm</td>
            <td>This tool's default; the 2019 Brysbaert meta-analysis cited above.</td>
          </tr>
          <tr>
            <td>English fiction</td>
            <td>around 260 wpm</td>
            <td>Same meta-analysis; narrative vocabulary is more predictable.</td>
          </tr>
          <tr>
            <td>Other read-time widgets</td>
            <td>180–300 wpm</td>
            <td>The spread of published platform defaults — the reason estimates disagree between sites.</td>
          </tr>
          <tr>
            <td>Narration and presentations</td>
            <td>150 wpm</td>
            <td>This page's speaking timer; a comfortable read-aloud pace.</td>
          </tr>
          <tr>
            <td>Studying dense material</td>
            <td>roughly half the default (~120 wpm)</td>
            <td>Rule-of-thumb planning figure, not a measured rate.</td>
          </tr>
          <tr>
            <td>Skimming for the gist</td>
            <td>up to about 3× the default</td>
            <td>Rule-of-thumb planning figure; reading research measures comprehension-based reading.</td>
          </tr>
        </tbody>
      </table>
      <p>
        Worked example: an 1,800-word essay is 1,800 ÷ 238 ≈ 7.6 minutes of silent reading — the page
        renders it as “7 min 34 sec” — and 1,800 ÷ 150 = 12 minutes exactly if you read it aloud as a
        script.
      </p>

      <h2>What counts as a word</h2>
      <p>
        The counter splits your text at whitespace and counts every resulting chunk, so a URL, a code
        token, or a long hyphenated string each counts as one word. Anything you paste is measured:
        headings, captions, cookie banners. Publishing platforms often treat non-prose content
        differently, which is why their labels can differ even when they use a similar speed. The
        character count is raw length — spaces and line breaks included — so you can sanity-check the
        word count against it. For an article label, paste just the body prose.
      </p>

      <h2>Privacy and limits</h2>
      <p>
        Counting happens inside your browser as you type: no network request, no account, nothing
        stored, nothing left after you close the tab — paste unpublished drafts freely. Two honest
        limits. First, every result is an average-based estimate, not a stopwatch: real reading speed
        swings with material and purpose, as above. Second, word-based counting only makes sense for
        scripts that separate words with spaces. Chinese, Japanese, and Thai text will undercount words
        badly — the character count still works, but the minute estimate does not.
      </p>

      <h2>When the reading pile outgrows the reading time</h2>
      <p>
        Knowing an article is an 18-minute read is useful; having forty of them queued is the real
        problem. That's the case for a read-it-later workflow — covered in our roundup of the
        <a href="/blog/best-read-it-later-apps-2026">best read-it-later apps</a> and on the
        <a href="/read-it-later">read-it-later</a> page. Marqly's angle: AI summarizes every saved
        article, so you can triage the pile in minutes and spend your actual reading time on the
        pieces that deserve it.
      </p>

      <h2>Related tools and guides</h2>
      <p>
        Counting is one step in a larger reading workflow. Clean a messy page into plain prose with the
        <a href="/tools/html-to-markdown">HTML to Markdown converter</a> before you time it; for video,
        the <a href="/tools/youtube-transcript">YouTube transcript viewer</a> gets you the text behind it
        — at the two rates on this page, reading a transcript takes notably less time than listening to
        the same words aloud. Marqly's <a href="/web-highlighter">web highlighter</a> keeps your
        annotations attached to the saved page, the <a href="/youtube-summarizer">YouTube
        summarizer</a> condenses video before you commit to it, and the
        <a href="/second-brain">second-brain</a> guide — alongside the longer
        <a href="/blog/how-to-build-a-second-brain">how to build a second brain</a> walkthrough — covers
        what to do with everything you have time for.
      </p>
    </Fragment>
  </ToolShell>
</LandingLayout>

<script>
  const input = document.getElementById('rt-in') as HTMLTextAreaElement;
  const readEl = document.getElementById('rt-read')!;
  const speakEl = document.getElementById('rt-speak')!;
  const wordsEl = document.getElementById('rt-words')!;
  const charsEl = document.getElementById('rt-chars')!;

  const READ_WPM = 238;
  const SPEAK_WPM = 150;

  function fmtDuration(minutes: number): string {
    const totalSec = Math.round(minutes * 60);
    if (totalSec < 60) return `${totalSec} sec`;
    const m = Math.floor(totalSec / 60);
    const s = totalSec % 60;
    if (m >= 60) {
      const h = Math.floor(m / 60);
      return `${h} hr ${m % 60} min`;
    }
    return s > 0 ? `${m} min ${s} sec` : `${m} min`;
  }

  function update() {
    const text = input.value;
    const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
    wordsEl.textContent = words.toLocaleString();
    charsEl.textContent = text.length.toLocaleString();
    readEl.textContent = fmtDuration(words / READ_WPM);
    speakEl.textContent = fmtDuration(words / SPEAK_WPM);
  }

  input.addEventListener('input', update);
  update();
</script>
