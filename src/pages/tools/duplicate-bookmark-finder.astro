---
import LandingLayout from '../../layouts/LandingLayout.astro';
import ToolShell from '../../components/seo/ToolShell.astro';
import { breadcrumbList, faqPage, freeWebApplication, organization, webSite } from '../../lib/schema';

const title = 'Duplicate Bookmark Finder — Find & Remove Duplicate Bookmarks';
const description =
  'Upload your bookmarks HTML export and find duplicate bookmarks instantly — grouped by normalized URL, with a one-click deduplicated file. Free and private.';

const faqs = [
  {
    q: 'How does it decide two bookmarks are duplicates?',
    a: 'URLs are normalized before comparing: the host is lowercased, a trailing slash is stripped, tracking parameters (utm_*, fbclid, gclid) are removed, and #fragments are ignored. So the same article saved from a newsletter link and from the address bar counts as one page. Different query strings that actually change the page are kept apart.',
  },
  {
    q: 'Does the deduplicated file keep my folders?',
    a: 'No — the download is a flat list, one entry per unique URL, keeping the first occurrence with its title and saved date. Rebuilding a folder tree while merging entries that lived in different folders has no right answer, so we do the honest simple thing. Every browser imports the flat file fine.',
  },
  {
    q: 'Is my bookmarks file uploaded to a server?',
    a: 'No. Parsing, normalizing, grouping, and generating the deduplicated file all happen in your browser — the file never leaves your machine. There is no account, no quota, and nothing retained after you close the tab. Watch the network inspector if you want proof.',
  },
  {
    q: 'What do I do with the deduplicated file?',
    a: 'Import it back into your browser (after removing the old bookmarks, or into a fresh folder), or import it into Marqly, which reads standard bookmarks HTML directly — titles and tags come along with the file. On the Pro plan, Marqly also AI-tags imported links automatically, so the cleaned pile actually becomes findable. Marqly has a free plan you can start on.',
  },
  {
    q: 'Why were two bookmarks for the same page not grouped?',
    a: 'Matching happens on the normalized URL, and normalization is deliberately conservative: a different protocol (http vs https), a different subdomain (www vs m), or a query parameter that is not a known tracker is treated as a different page. The section “Which URLs count as duplicates” lists exactly what gets unified and what stays apart — check the misses there.',
  },
  {
    q: 'Which of the duplicate copies does the download keep?',
    a: 'The first occurrence of each unique page, in the order your export listed them, with its title, its saved date, and its URL exactly as you saved it — tracking parameters and all. The normalized URL is only the matching key; it is never written into the output file.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Free tools', path: '/tools' },
    { name: 'Duplicate bookmark finder', path: '/tools/duplicate-bookmark-finder' },
  ]),
  faqPage(faqs),
  freeWebApplication(
    'Duplicate bookmark finder',
    'Upload your bookmarks HTML export and find duplicate bookmarks instantly — grouped by normalized URL, with a one-click deduplicated file. Free and private.',
    '/tools/duplicate-bookmark-finder',
  ),
];
---

<LandingLayout title={title} description={description} jsonLd={jsonLd} ogImage="https://www.marqly.com/og/seo/tool-duplicate-bookmark-finder.png">
  <ToolShell
    name="Duplicate bookmark finder"
    heading="Find duplicate bookmarks in your export"
    sub="Upload a bookmarks HTML file, see every duplicate grouped by URL, and download a deduplicated copy. Runs entirely in your browser."
    faqs={faqs}
    ctaHeading="Deduplicated — now make it searchable"
    ctaSub="Import the cleaned file into Marqly and AI tags every link automatically. Find any save by describing it, not by remembering the folder."
  >
    <div class="tool-row">
      <div class="grow">
        <label for="db-file">Bookmarks HTML file</label>
        <input id="db-file" type="file" accept=".html,.htm" />
      </div>
    </div>
    <p class="tool-status" id="db-status" role="status"></p>
    <div class="tool-actions hidden" id="db-actions">
      <button class="btn btn--primary btn--sm" id="db-download" type="button">
        Download deduplicated HTML
      </button>
    </div>
    <div class="hidden" id="db-table-wrap" style="overflow-x: auto;">
      <table class="tool-table">
        <thead>
          <tr><th>URL</th><th>Saved as</th><th>Copies</th></tr>
        </thead>
        <tbody id="db-tbody"></tbody>
      </table>
    </div>

    <Fragment slot="content">
      <h2>Why duplicate bookmarks pile up</h2>
      <p>
        Nobody saves the same page twice on purpose. Duplicates come from the mechanics of saving:
        you bookmark an article from a newsletter link (with <code>utm_source</code> bolted on),
        then again months later from the address bar. Sync merges the bookmarks from an old laptop
        into your current profile. You import an export "just to be safe" on a new machine without
        deleting anything first. Each of those events looks harmless; ten years of them means an
        export where a meaningful slice of the file is the same pages under slightly different URLs.
      </p>

      <h2>How it works</h2>
      <p>
        The whole pipeline runs inside this browser tab, with no server involved:
      </p>
      <ol>
        <li>
          Your bookmarks HTML file is read locally and parsed as a document — every link it contains
          is pulled out along with its title and saved-date attribute. Non-web links (anything that
          isn't <code>http</code> or <code>https</code>) are skipped.
        </li>
        <li>
          Each URL is <strong>normalized</strong> — lowercased host, trailing slash removed, known
          tracking parameters dropped, fragment ignored — and used as a matching key.
        </li>
        <li>
          Bookmarks with the same key are <strong>grouped</strong>; any group with more than one
          member appears in the results table, sorted by how many copies there are, with the
          different titles the page was saved under.
        </li>
        <li>
          The <strong>deduplicated download</strong> keeps one entry per unique page: the first
          occurrence, with its original title, saved date, and URL as you saved it. The file is
          generated in the tab and offered back to you as a download.
        </li>
      </ol>

      <h2>How to use it</h2>
      <ol>
        <li>
          Export your bookmarks from your browser: open the bookmarks manager and choose the export
          option to save an HTML file. The menu paths for each browser are in
          <a href="/faq/how-do-i-import-chrome-bookmarks">our export and import guide</a>.
        </li>
        <li>Choose that file above with the <strong>Bookmarks HTML file</strong> picker.</li>
        <li>
          The status line tells you the total checked, how many URLs were duplicated, and how many
          copies are removable — and the table lists every duplicated URL.
        </li>
        <li>
          Press <strong>Download deduplicated HTML</strong> to get a copy of the file with one entry
          per unique page.
        </li>
        <li>
          Replace the old set: import the clean file into a fresh folder (or clear the old
          bookmarks first, then import) so you can verify the result before committing.
        </li>
      </ol>

      <h2>Which URLs count as duplicates</h2>
      <p>
        Matching happens on the normalized URL, never on the raw text. This is exactly what gets
        unified — and what deliberately stays apart:
      </p>
      <table>
        <thead>
          <tr><th>Saved as</th><th>and also as</th><th>Result</th><th>Why</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Example.com/article</td><td>example.com/article</td>
            <td>Grouped</td><td>The host is lowercased before comparing.</td>
          </tr>
          <tr>
            <td>/article/</td><td>/article</td>
            <td>Grouped</td><td>Trailing slashes are stripped — on deep paths and on the bare domain root.</td>
          </tr>
          <tr>
            <td>?utm_source=newsletter</td><td>no parameter</td>
            <td>Grouped</td><td><code>utm_*</code> identifies the click, not the page.</td>
          </tr>
          <tr>
            <td>?fbclid=… / ?gclid=…</td><td>no parameter</td>
            <td>Grouped</td><td>Facebook and Google click IDs are removed too.</td>
          </tr>
          <tr>
            <td>#comments</td><td>no fragment</td>
            <td>Grouped</td><td>Fragments scroll within the page; they don't change it.</td>
          </tr>
          <tr>
            <td>?page=2</td><td>?page=3</td>
            <td>Kept apart</td><td>Any query parameter that isn't a known tracker is preserved — it might change the page.</td>
          </tr>
          <tr>
            <td>http://example.com/a</td><td>https://example.com/a</td>
            <td>Kept apart</td><td>The protocol is not rewritten or upgraded.</td>
          </tr>
          <tr>
            <td>www.example.com/a</td><td>m.example.com/a</td>
            <td>Kept apart</td><td>Subdomains are not unified.</td>
          </tr>
        </tbody>
      </table>
      <p>
        The conservatism is intentional: wrongly merging two genuinely different pages (a paginated
        archive, two products on one domain) destroys information, while missing a stylistic
        near-duplicate only leaves a bookmark you can delete by hand.
      </p>

      <h2>What the deduplicated file contains</h2>
      <p>
        A standard Netscape bookmarks HTML file — the same format browsers export — with one entry
        per unique URL. The surviving copy is the <strong>first occurrence</strong> in your file's
        order, keeping its title, its saved date (when the export recorded one), and its URL exactly
        as you saved it; the normalized URL is only a matching key and is never written into the
        output. It is a flat list: folders are flattened, because merging "same URL, three different
        folders" into a tree has no correct answer. Chrome, Firefox, Edge, and Safari all import it.
        To inspect the file before or after, the
        <a href="/tools/bookmark-file-viewer">bookmark file viewer</a> opens it as a searchable
        table.
      </p>

      <h2>When to run this</h2>
      <ul>
        <li>
          <strong>Before a migration</strong> — moving to a new machine or browser profile: dedupe
          first so you don't seed the fresh setup with years of sync dust. The
          <a href="/migrate/browser-bookmarks">browser-bookmarks migration guide</a> covers the rest.
        </li>
        <li>
          <strong>After sync has multiplied things</strong> — the classic "same tab twice" profile
          built by merging old devices.
        </li>
        <li>
          <strong>Before importing into any new manager</strong> — most tools have no duplicate
          detection at import time, so a doubled file stays doubled forever. What a manager should do
          <em>after</em> the cleanup is covered in our
          <a href="/bookmark-organizer">bookmark organizer guide</a>.
        </li>
        <li>
          <strong>On a research pile collected from many sources</strong> — newsletter links, search
          results, and shared posts save the same pages under different campaign URLs. If the pile is
          a reading queue rather than a link list, a
          <a href="/read-it-later">read-it-later setup</a> is the better fit.
        </li>
      </ul>

      <h2>Privacy: what happens to your file</h2>
      <p>
        Nothing leaves your computer. There is no server component to this tool: your file is read
        into the page's memory, parsed, grouped, and re-generated entirely inside your browser tab.
        No part of it is uploaded, no request carries its contents anywhere, there is no account and
        no quota, and closing the tab discards everything — there is nothing retained because there
        is nothing sent. If you want proof before you trust a bookmarks file to any web tool, open
        your browser's network inspector before selecting the file: deduplication produces no
        network requests at all.
      </p>

      <h2>Limits and edge cases</h2>
      <ul>
        <li>
          <strong>Near-duplicates are not caught.</strong> Different subdomains, AMP variants,
          protocol changes, and shortened URLs that expand elsewhere all stay as separate entries —
          see the table above.
        </li>
        <li>
          <strong>First copy wins.</strong> If the first saved copy has the worst title ("Untitled
          page"), that is the survivor. Re-export, re-order, or fix titles after importing.
        </li>
        <li>
          <strong>Folders are flattened</strong> in the download, by design. Treat the output as a
          deduplicated link set, not a re-organized library.
        </li>
        <li>
          <strong>Original save dates are kept in the downloaded file</strong> — but if you import
          that file into Marqly, items take their import date; saves' original dates are not
          preserved through an import. Titles and tags do come along.
        </li>
        <li>
          <strong>Only http(s) bookmarks are processed.</strong> Other entries in the export are
          ignored, which is why the counts can differ slightly from what the browser's manager
          displays.
        </li>
      </ul>

      <h2>After the cleanup</h2>
      <p>
        Deduplication fixes the redundancy, not the findability — a flat list of two thousand
        unique links is still two thousand links. Importing the cleaned file into
        <a href="https://app.marqly.com">Marqly</a> keeps its titles and tags, and on the Pro plan
        AI tags each imported link automatically, while semantic search finds "that piece about
        negotiating a raise" without you remembering its title or where you filed it. Marqly has a
        <a href="/pricing">free plan</a> to get started on; see our guide on
        <a href="/faq/how-do-i-import-chrome-bookmarks">how to import Chrome bookmarks</a>, or clean
        the tracking parameters out of individual links with the
        <a href="/tools/url-cleaner">URL cleaner</a> before you save them at all.
      </p>

      <h2>Related tools and guides</h2>
      <ul>
        <li><a href="/tools/bookmark-file-viewer">Inspect any bookmarks export</a> as a searchable table — before this tool or after.</li>
        <li><a href="/tools/dead-link-checker">Check the survivors for link rot</a> — deduplicating then batch-checking is the one-two pass for an old collection.</li>
        <li><a href="/tools/url-cleaner">Strip tracking parameters</a> from a single link at a time.</li>
        <li><a href="/migrate/browser-bookmarks">Move bookmarks between browsers</a> without carrying the junk along.</li>
        <li><a href="/blog/how-to-organize-bookmarks">A bookmark-organizing system</a> that stops duplicates reappearing next year.</li>
        <li><a href="/read-it-later">Turn the cleaned list into a working reading queue.</a></li>
      </ul>
    </Fragment>
  </ToolShell>
</LandingLayout>

<script>
  type Bookmark = { title: string; url: string; addDate: string | null };
  type Group = { key: string; entries: Bookmark[] };

  const fileInput = document.getElementById('db-file') as HTMLInputElement;
  const status = document.getElementById('db-status')!;
  const actions = document.getElementById('db-actions')!;
  const tableWrap = document.getElementById('db-table-wrap')!;
  const tbody = document.getElementById('db-tbody')!;

  let allBookmarks: Bookmark[] = [];
  let uniqueOrder: Bookmark[] = [];

  const TRACKING = new Set(['fbclid', 'gclid']);

  function normalizeUrl(raw: string): string {
    try {
      const u = new URL(raw);
      u.hash = '';
      u.hostname = u.hostname.toLowerCase();
      const drop: string[] = [];
      u.searchParams.forEach((_value, key) => {
        const k = key.toLowerCase();
        if (k.startsWith('utm_') || TRACKING.has(k)) drop.push(key);
      });
      for (const key of drop) u.searchParams.delete(key);
      if (u.pathname !== '/') u.pathname = u.pathname.replace(/\/+$/, '');
      let s = u.toString();
      if (u.pathname === '/' && !u.search) s = s.replace(/\/$/, '');
      return s;
    } catch {
      return raw.trim();
    }
  }

  function parseBookmarks(html: string): Bookmark[] {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    return Array.from(doc.querySelectorAll('a[href]'))
      .map((a) => ({
        title: a.textContent?.trim() || '(untitled)',
        url: a.getAttribute('href') ?? '',
        addDate: a.getAttribute('add_date'),
      }))
      .filter((b) => /^https?:/i.test(b.url));
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    status.classList.remove('is-error');
    try {
      allBookmarks = parseBookmarks(await file.text());
    } catch {
      status.textContent = 'Could not read that file.';
      status.classList.add('is-error');
      return;
    }
    if (allBookmarks.length === 0) {
      status.textContent = 'No bookmarks found in that file — is it a browser bookmarks HTML export?';
      status.classList.add('is-error');
      tableWrap.classList.add('hidden');
      actions.classList.add('hidden');
      return;
    }

    const byKey = new Map<string, Bookmark[]>();
    uniqueOrder = [];
    for (const b of allBookmarks) {
      const key = normalizeUrl(b.url);
      const existing = byKey.get(key);
      if (existing) {
        existing.push(b);
      } else {
        byKey.set(key, [b]);
        uniqueOrder.push(b);
      }
    }

    const dupGroups: Group[] = [];
    byKey.forEach((entries, key) => {
      if (entries.length > 1) dupGroups.push({ key, entries });
    });
    dupGroups.sort((a, b) => b.entries.length - a.entries.length);

    tbody.textContent = '';
    for (const g of dupGroups) {
      const tr = document.createElement('tr');
      const tdUrl = document.createElement('td');
      tdUrl.textContent = g.key.length > 90 ? `${g.key.slice(0, 87)}…` : g.key;
      const tdTitles = document.createElement('td');
      const titles = Array.from(new Set(g.entries.map((e) => e.title)));
      tdTitles.textContent =
        titles.length > 2 ? `${titles.slice(0, 2).join(' · ')} (+${titles.length - 2} more)` : titles.join(' · ');
      const tdCount = document.createElement('td');
      tdCount.textContent = String(g.entries.length);
      tr.replaceChildren(tdUrl, tdTitles, tdCount);
      tbody.appendChild(tr);
    }

    const removable = allBookmarks.length - uniqueOrder.length;
    if (dupGroups.length === 0) {
      status.textContent = `${allBookmarks.length} bookmarks checked — no duplicates found. Nice.`;
      tableWrap.classList.add('hidden');
      actions.classList.add('hidden');
    } else {
      status.textContent = `${allBookmarks.length} bookmarks — ${dupGroups.length} duplicated URLs, ${removable} removable ${removable === 1 ? 'copy' : 'copies'}.`;
      tableWrap.classList.remove('hidden');
      actions.classList.remove('hidden');
    }
  });

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  document.getElementById('db-download')!.addEventListener('click', () => {
    const lines = uniqueOrder.map((b) => {
      const date = b.addDate ? ` ADD_DATE="${esc(b.addDate)}"` : '';
      return `    <DT><A HREF="${esc(b.url)}"${date}>${esc(b.title)}</A>`;
    });
    const html = [
      '<!DOCTYPE NETSCAPE-Bookmark-file-1>',
      '<!-- Deduplicated by marqly.com/tools/duplicate-bookmark-finder. Folders are flattened. -->',
      '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">',
      '<TITLE>Bookmarks</TITLE>',
      '<H1>Bookmarks</H1>',
      '<DL><p>',
      ...lines,
      '</DL><p>',
      '',
    ].join('\n');
    const blob = new Blob([html], { type: 'text/html' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'bookmarks-deduplicated.html';
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
