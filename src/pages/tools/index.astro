---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import { breadcrumbList, itemList, organization, webSite } from '../../lib/schema';
import { freeToolCategories, freeTools } from '../../lib/free-tools';

const title = 'Free Tools for Bookmarks, Links & YouTube — No Signup Needed';
const description =
  'Eighteen genuinely free tools for YouTube, URLs, SEO, content, and bookmark files. No signup, no paid API, and no hidden usage limit.';

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Free tools', path: '/tools' },
  ]),
  itemList(freeTools.map((tool) => tool.name), '/tools'),
];
---

<LandingLayout title={title} description={description} jsonLd={jsonLd} ogImage="https://www.marqly.com/og/seo/hub-tools.png">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Free tools', path: '/tools' }]} />
      <header class="tools-head">
        <h1>Free tools</h1>
        <p>
          Small, sharp tools for YouTube, links, SEO, content, and bookmarks — free, no signup,
          and no usage limit disguised as a pricing page. Most run privately in your browser;
          URL inspection tools use a small server request because browsers block cross-site checks.
        </p>
      </header>

      {freeToolCategories.map((category) => (
        <section class="tool-group" aria-labelledby={`tools-${category.toLowerCase().replaceAll(' ', '-').replace('&', 'and')}`}>
          <div class="group-head">
            <h2 id={`tools-${category.toLowerCase().replaceAll(' ', '-').replace('&', 'and')}`}>{category}</h2>
            <span>{freeTools.filter((tool) => tool.category === category).length} tools</span>
          </div>
          <ul class="tool-cards">
            {freeTools.filter((tool) => tool.category === category).map((tool) => (
              <li>
                <a href={tool.path} class="tool-card">
                  <div class="card-head">
                    <h3>{tool.name}</h3>
                    <span class="privacy-tag">{tool.browserOnly ? 'Runs locally' : 'Live check'}</span>
                  </div>
                  <p>{tool.desc}</p>
                  <span class="more">Open the tool →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <CtaBox />
    </div>
  </section>
</LandingLayout>

<style>
  .tools-head { max-width: 60ch; margin-bottom: var(--space-12); }
  .tools-head h1 {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
  }
  .tools-head p { margin-top: var(--space-4); font-size: var(--fs-base); color: var(--ink-2); }

  .tool-group { margin-bottom: var(--space-12); }
  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .group-head h2 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); }
  .group-head > span { font-size: var(--fs-xs); color: var(--ink-3); }
  .tool-cards {
    list-style: none;
    margin: 0 0 var(--space-12);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .tool-card {
    display: block;
    height: 100%;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .tool-card:hover { border-color: var(--border-2); transform: translateY(-2px); }
  .card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
  .tool-card h3 { font-size: var(--fs-base); font-weight: 600; color: var(--ink-1); }
  .privacy-tag {
    flex: none;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-pill);
    padding: 2px 7px;
    font-size: 10px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .tool-card p {
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: var(--lh-base);
  }
  .tool-card .more {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--ink-2);
  }

  @media (max-width: 1000px) { .tool-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .tool-cards { grid-template-columns: 1fr; } }
</style>
