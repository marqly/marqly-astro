---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import Faq from '../components/framer/Faq.js';

const title = 'Marqly Pricing — Free & Pro Plans | AI Bookmark Manager from $0';
const description =
  'Compare Marqly Free vs Pro plans. Free: 50 bookmarks with basic features. Pro at $84/year: unlimited bookmarks, AI tagging, smart organization, and more. Start free today.';
---

<BaseLayout title={title} description={description} navVariant="Desktop / Pricing">
  <PricingSection />
  <div class="faq-center"><Faq client:only="react" /></div>
</BaseLayout>

<style>
  /* The Framer FAQ root is a fixed-width block; BaseLayout's .fr-chrome centering
     rule is scoped to BaseLayout and doesn't reach a wrapper authored here, so
     center it explicitly. (display:contents on the astro-island means the Framer
     root becomes the flex item.) */
  .faq-center {
    display: flex;
    justify-content: center;
    width: 100%;
    /* Breathing room above the FAQ (from the plan cards) and below (to the footer) */
    padding-block: var(--space-32);
  }
  .faq-center :global(.framer-15hz13w) {
    max-width: 100%;
  }
  @media (max-width: 810px) {
    .faq-center {
      padding-block: var(--space-24);
    }
  }
</style>
