---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ComparisonTable from '../../components/seo/ComparisonTable.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import { competitors, marqly } from '../../lib/competitors';
import { marqlyEdges, pricingSentence, rankAlternatives } from '../../lib/compare-content';
import { breadcrumbList, faqPage, itemList, organization, softwareApplication, webSite } from '../../lib/schema';

export function getStaticPaths() {
  return competitors.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}

const { slug } = Astro.props;
const subject = competitors.find((c) => c.slug === slug)!;
const ranked = rankAlternatives(subject, competitors, marqly);

const path = `/alternatives/${subject.slug}`;
const h1 = `Best ${subject.name} alternatives (2026)`;
const title = `Best ${subject.name} Alternatives (2026) — ${ranked.length} Tools Compared`;
const description =
  subject.status === 'shutdown'
    ? `${subject.name} is gone — here are the ${ranked.length} best ${subject.name} alternatives in 2026, compared on features, pricing, and import paths.`
    : `Looking for a ${subject.name} alternative? The ${ranked.length} best options in 2026 compared on AI features, highlights, pricing, and imports.`;

const edges = marqlyEdges(marqly, subject, 3);
const marqlyWhy = `Marqly covers the core job — save, organize, retrieve — and adds ${
  edges.length ? edges.join(', ') : 'an AI organization layer'
} that ${subject.name} ${subject.status === 'shutdown' ? 'never had' : "doesn't offer"}. Every save is auto-tagged and summarized, and semantic search finds things by meaning. Free tier, no card required.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Alternatives', path: '/alternatives' },
  { name: `${subject.name} alternatives`, path },
];

const jsonLd = [
  organization(),
  webSite(),
  softwareApplication(),
  breadcrumbList(crumbs),
  itemList(ranked.map((r) => r.name), path),
  ...(subject.faqs.length ? [faqPage(subject.faqs)] : []),
];

const others = competitors.filter((c) => c.slug !== subject.slug);
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogImage={`https://www.marqly.com/og/seo/alternatives-${subject.slug}.png`}
>
  <article class="section">
    <div class="container alt-page">
      <Breadcrumbs items={crumbs} />
      <h1>{h1}</h1>

      <p class="intro">
        {subject.status === 'shutdown' ? (
          <>
            <strong>{subject.name} has shut down.</strong> {subject.shutdownNote} Here are the
            best replacements in 2026, ranked by how well they cover what {subject.name} did —
            and what they add on top.
          </>
        ) : (
          <>
            {subject.overview} Below are the strongest alternatives in 2026, ranked honestly:
            each covers a different mix of jobs, and the right one depends on yours.
          </>
        )}
      </p>

      <h2>The best {subject.name} alternatives, ranked</h2>
      <ol class="ranked">
        {ranked.map((tool, i) => (
          <li class={`rank-card${tool.slug === 'marqly' ? ' is-marqly' : ''}`}>
            <div class="rank-head">
              <span class="rank-n">#{i + 1}</span>
              <h3>{tool.name}</h3>
              <span class="rank-tag">{tool.tagline}</span>
            </div>
            <p class="rank-why">{tool.slug === 'marqly' ? marqlyWhy : tool.verdict + ' ' + tool.bestFor}</p>
            <ul class="mini-pros">
              {tool.pros.slice(0, 3).map((p) => <li>{p}</li>)}
            </ul>
            <p class="rank-price"><strong>Pricing:</strong> {pricingSentence(tool)}</p>
            {tool.slug === 'marqly' ? (
              <a class="btn btn--primary" href="https://app.marqly.com">Try Marqly free <span class="arrow">→</span></a>
            ) : (
              <a class="rank-link" href={`/compare/marqly-vs-${tool.slug}`}>Marqly vs {tool.name} →</a>
            )}
          </li>
        ))}
      </ol>

      <h2>Marqly vs {subject.name}, feature by feature</h2>
      <ComparisonTable tools={[marqly, subject]} variant="full" />
      <p class="deep-link"><a href={`/compare/marqly-vs-${subject.slug}`}>See the full Marqly vs {subject.name} comparison →</a></p>

      {subject.faqs.length > 0 && (
        <div class="faq-wrap">
          <FaqAccordion faqs={subject.faqs} heading={`${subject.name} alternatives FAQ`} />
        </div>
      )}

      <CtaBox />

      <nav class="xlinks" aria-label="Explore more alternatives">
        <h3>Explore more alternatives</h3>
        <ul>
          {others.map((c) => (
            <li><a href={`/alternatives/${c.slug}`}>{c.name} alternatives</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</LandingLayout>

<style>
  .alt-page { max-width: 900px; }
  h1 { font-size: var(--fs-h2); font-weight: 600; letter-spacing: var(--tracking-tight); color: var(--ink-1); line-height: var(--lh-tight); }
  h2 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-top: var(--space-12); margin-bottom: var(--space-4); letter-spacing: var(--tracking-tight); }
  .intro { margin-top: var(--space-5); font-size: var(--fs-base); line-height: var(--lh-base); color: var(--ink-2); }
  .intro strong { color: var(--ink-1); }

  .ranked { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-5); counter-reset: none; }
  .rank-card {
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }
  .rank-card.is-marqly { border-color: var(--border-2); background: var(--surface-2); }
  .rank-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-3); }
  .rank-n { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-3); }
  .rank-head h3 { font-size: var(--fs-lg); font-weight: 600; color: var(--ink-1); }
  .rank-tag { font-size: var(--fs-xs); color: var(--ink-3); }
  .rank-why { margin-top: var(--space-3); font-size: var(--fs-sm); line-height: var(--lh-base); color: var(--ink-2); }
  .mini-pros { list-style: disc; margin-top: var(--space-3); padding-left: 1.2rem; font-size: var(--fs-sm); color: var(--ink-2); line-height: var(--lh-base); display: flex; flex-direction: column; gap: var(--space-1); }
  .mini-pros li::marker { color: var(--ink-4); }
  .rank-price { margin-top: var(--space-3); font-size: var(--fs-sm); color: var(--ink-3); }
  .rank-price strong { color: var(--ink-2); }
  .rank-link { display: inline-block; margin-top: var(--space-3); font-size: var(--fs-sm); font-weight: 500; color: var(--ink-1); text-decoration: underline; }
  .rank-card .btn { margin-top: var(--space-4); }

  .deep-link { margin-top: var(--space-4); }
  .deep-link a { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-1); text-decoration: underline; }

  .faq-wrap { margin-top: var(--space-12); }

  .xlinks { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--border-1); }
  .xlinks h3 { font-size: var(--fs-base); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-4); }
  .xlinks ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2) var(--space-6);
  }
  .xlinks a { font-size: var(--fs-sm); color: var(--ink-3); }
  .xlinks a:hover { color: var(--ink-1); }
  @media (max-width: 800px) { .xlinks ul { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .xlinks ul { grid-template-columns: 1fr; } }
</style>
