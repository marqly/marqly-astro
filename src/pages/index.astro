    border-radius: var(--radius-pill);
  }
  .ui-status-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    display: inline-block;
  }
  .ui-status--ok { color: #1f9d55; background: rgba(31, 157, 85, 0.1); }
  .ui-status--ok .ui-status-dot { background: #1f9d55; }
  .ui-status--bad { color: #d64545; background: rgba(214, 69, 69, 0.1); }
  .ui-status--bad .ui-status-dot { background: #d64545; }
  .ui-offline-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-top: 1px solid var(--border-1);
    font-size: 0.6rem;
    color: var(--ink-4);
  }
  .ui-offline-icon { color: var(--ink-4); display: inline-flex; }

  /* ----- Sync card ----- */
  .ui-sync {
    display: flex;
    flex-direction: column;
  }
  .ui-sync-pill {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.62rem;
    font-weight: 600;
    color: #1f9d55;
    background: rgba(31, 157, 85, 0.1);
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-pill);
  }
  .ui-sync-check {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: #1f9d55;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ui-devices {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.55rem 0.6rem;
  }
  .ui-device {
    border: 1px solid var(--border-1);
    border-radius: 10px;
    padding: 0.5rem 0.6rem;
    background: var(--surface-2);
  }
  .ui-device-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.35rem;
  }
  .ui-device-icon {
    font-size: 0.85rem;
    line-height: 1;
  }
  .ui-device-name {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-1);
    flex: 1;
  }
  .ui-device-check {
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #1f9d55;
    color: #fff;
    font-size: 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .ui-device .ui-list { padding: 0; }
  .ui-device .ui-row {
    padding: 0.18rem 0;
    border-bottom: none;
    font-size: 0.62rem;
    color: var(--ink-3);
  }
  .ui-device .ui-row::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--ink-4);
    display: inline-block;
    flex: 0 0 auto;
  }
  .ui-list--mini .ui-row-title { font-size: 0.66rem; }
  .ui-list--compact .ui-row { padding: 0.4rem 0.75rem; }
  .ui-sync-foot {
    padding: 0.5rem 0.75rem 0.6rem;
    border-top: 1px solid var(--border-1);
    font-size: 0.6rem;
    color: var(--ink-4);
    text-align: center;
  }

  /* ============================================================ */
  /* HOW IT WORKS                                                 */
  /* ============================================================ */
  .how {
    background: var(--surface-2);
    padding-block: var(--section-pad-y);
    border-top: 1px solid var(--border-1);
    border-bottom: 1px solid var(--border-1);
  }
  .steps {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .step {
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .step-vis {
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-inner);
    overflow: hidden;
    box-shadow: 0 1px 0 rgba(13, 13, 16, 0.03);
    margin-bottom: var(--space-2);
    min-height: 226px;
    display: flex;
    flex-direction: column;
  }
  .step-num {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    align-self: flex-start;
    letter-spacing: 0.06em;
  }
  .step-title {
    font-size: var(--fs-h4);
    font-weight: 500;
    color: var(--ink-1);
    letter-spacing: -0.02em;
  }
  .step-body {
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.55;
  }

  /* ----- Step 01: Install ----- */
  .ui-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    background: var(--surface-3);
    border-bottom: 1px solid var(--border-1);
  }
  .ui-toolbar-dots {
    display: inline-flex;
    gap: 4px;
  }
  .ui-toolbar-dots span {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #d0d0d4;
    display: block;
  }
  .ui-toolbar-dots span:nth-child(1) { background: #ff6058; }
  .ui-toolbar-dots span:nth-child(2) { background: #ffc130; }
  .ui-toolbar-dots span:nth-child(3) { background: #28c941; }
  .ui-toolbar-url {
    flex: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-pill);
    padding: 0.18rem 0.5rem;
    font-size: 0.6rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ui-toolbar-lock { color: var(--ink-4); display: inline-flex; }
  .ui-toolbar-icons {
    display: inline-flex;
    gap: 3px;
  }
  .ui-toolbar-icons span {
    width: 14px; height: 14px;
    border-radius: 4px;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
  }
  .ui-toolbar-ext {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ink-1) !important;
    color: #fff;
    border-color: transparent !important;
    box-shadow: 0 0 0 4px rgba(13, 13, 16, 0.12);
    animation: extPulse 2.4s var(--ease-in-out) infinite;
  }
  @keyframes extPulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(13, 13, 16, 0.12); }
    50% { box-shadow: 0 0 0 7px rgba(13, 13, 16, 0.06); }
  }
  @media (prefers-reduced-motion: reduce) { .ui-toolbar-ext { animation: none; } }

  .step-install-body {
    flex: 1;
    padding: 0.85rem 0.9rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .step-install-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-1);
    letter-spacing: -0.015em;
  }
  .step-install-sub {
    font-size: 0.62rem;
    color: var(--ink-4);
  }
  .step-install-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6rem;
    color: var(--ink-3);
    margin-top: 0.15rem;
  }
  .step-install-stars {
    color: var(--star);
    letter-spacing: 0.05em;
  }
  .step-install-stars span {
    color: var(--ink-1);
    font-weight: 600;
    margin-left: 4px;
    letter-spacing: 0;
  }
  .step-install-users {
    color: var(--ink-4);
  }
  .step-install-btn {
    margin-top: 0.5rem;
    width: 100%;
    background: var(--ink-1);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.55rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: default;
  }
  .step-install-browsers {
    margin-top: 0.6rem;
    display: flex;
    gap: 0.35rem;
    justify-content: center;
  }
  .step-install-browser {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    color: var(--ink-2);
    font-size: 0.6rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* ----- Step 02: Save ----- */
  .step-vis--save {
    padding: 0.85rem 0.75rem 0.95rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    background: var(--surface-2);
  }
  .ui-save-kbd {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
  }
  .kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 0.4rem;
    background: var(--surface-1);
    border: 1px solid var(--border-2);
    border-bottom-width: 2px;
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-1);
  }
  .ui-save-kbd-label {
    margin-left: 0.4rem;
    font-size: 0.6rem;
    color: var(--ink-4);
    font-family: var(--font-sans, var(--font-mono));
  }
  .ui-save-pop {
    width: 100%;
    background: var(--surface-1);
    border: 1px solid var(--border-2);
    border-radius: 12px;
    padding: 0.6rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    box-shadow: 0 8px 22px -8px rgba(13, 13, 16, 0.12);
  }
  .ui-save-pop-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ui-save-pop-icon {
    width: 18px; height: 18px;
    background-color: rgba(0, 0, 0, 1);
    color: #fff;
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ui-save-pop-head strong {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-1);
  }
  .ui-save-pop-title {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-1);
    line-height: 1.3;
  }
  .ui-save-pop-url {
    font-size: 0.58rem;
    color: var(--ink-4);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ui-save-pop-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.22rem;
  }
  .ui-save-pop-foot {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.58rem;
    color: var(--ink-4);
  }
  .ui-spinner {
    width: 9px; height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--border-2);
    border-top-color: var(--accent);
    animation: spin 0.9s linear infinite;
    flex-shrink: 0;
  }

  /* ----- Step 03: Find ----- */
  .step-vis--find {
    padding: 0.6rem 0 0;
  }
  .step-vis--find .ui-search-bar--lg { border-bottom: 1px solid var(--border-1); }
  .step-vis--find .ui-list {
    flex: 1;
  }

  @media (max-width: 800px) {
    .steps { grid-template-columns: 1fr; }
  }

  /* ============================================================ */
  /* PRICING                                                      */
  /* ============================================================ */
  .pricing { background: var(--surface-1); }
  .billing-toggle-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
  .billing-toggle {
    display: inline-flex;
    align-items: center;
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-pill);
    padding: 4px;
    gap: 0;
  }
  .bt-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-3);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-family: inherit;
    transition: color var(--dur-base) var(--ease-out),
                background var(--dur-base) var(--ease-out);
  }
  .bt-opt.is-active {
    background: var(--surface-1);
    color: var(--ink-1);
    box-shadow:
      0 1px 0 rgba(13, 13, 16, 0.04),
      0 4px 10px -4px rgba(13, 13, 16, 0.12);
  }
  .bt-save {
    display: inline-flex;
    align-items: center;
    font-size: 0.6rem;
    font-weight: 700;
    color: #fff;
    background: #fc037b;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    align-items: stretch;
    max-width: 820px;
    margin-inline: auto;
  }
  .tier {
    position: relative;
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 2.8vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: transform var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
  }
  .tier:hover { transform: translateY(-2px); border-color: var(--border-2); }
  .tier--featured {
    background: linear-gradient(165deg, #0d0d10 0%, #1a1a1f 100%);
    color: #fff;
    border-color: transparent;
    box-shadow:
      0 1px 0 rgba(13, 13, 16, 0.04),
      0 24px 60px -20px rgba(13, 13, 16, 0.35);
  }
  .tier--featured:hover { border-color: transparent; }
  .tier-flag {
    position: absolute;
    top: -10px; left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--accent);
    color: #fff;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }
  .tier-name {
    font-size: var(--fs-h4);
    font-weight: 500;
    color: inherit;
    letter-spacing: -0.02em;
  }
  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .tier-price[hidden] { display: none; }
  .tier-amount {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .tier-period {
    font-size: var(--fs-sm);
    color: inherit;
    opacity: 0.65;
  }
  .tier-blurb {
    font-size: var(--fs-sm);
    line-height: 1.5;
    opacity: 0.75;
  }
  .tier--featured .tier-blurb {
    color: rgba(209, 209, 224, 1);
  }
  .tier-cta { width: 100%; }
  .tier-perks {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid currentColor;
    display: grid;
    gap: 0.7rem;
  }
  .tier--featured .tier-perks { border-top-color: rgba(255, 255, 255, 0.12); }
  .tier-perks li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .check {
    flex: 0 0 auto;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .tier--featured .check { background: rgba(0, 122, 255, 0.18); color: #7eb6ff; }

  @media (max-width: 760px) {
    .tiers { grid-template-columns: 1fr; }
  }

  /* ============================================================ */
  /* REVIEWS                                                      */
  /* ============================================================ */
  .reviews { background: var(--surface-2); border-top: 1px solid var(--border-1); border-bottom: 1px solid var(--border-1); }
  .reviews-row {
    margin-top: var(--space-12);
    position: relative;
  }
  .reviews-track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: var(--space-3);
  }
  .reviews-track::-webkit-scrollbar { display: none; }
  .review {
    flex: 0 0 calc(33.333% - 1.1rem);
    min-width: 280px;
    scroll-snap-align: start;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .review--dark {
    background: linear-gradient(165deg, #0d0d10 0%, #1a1a1f 100%);
    border-color: transparent;
    color: #fff;
  }
  .review--dark .review-quote { color: rgba(255, 255, 255, 0.92); }
  .review--dark .review-meta strong { color: #fff; }
  .review--dark .review-meta span { color: rgba(255, 255, 255, 0.6); }
  .review--dark .review-stars { color: var(--star); }
  .review-stars { color: var(--star); letter-spacing: 0.1em; font-size: var(--fs-sm); }
  .review-quote {
    font-size: var(--fs-lg);
    color: var(--ink-1);
    line-height: 1.4;
    letter-spacing: -0.015em;
    flex: 1;
  }
  .review-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid currentColor;
  }
  .review--dark .review-meta { border-top-color: rgba(255, 255, 255, 0.12); }
  .review-meta :global(img),
  .review-meta img {
    width: 40px; height: 40px;
    border-radius: 50%;
  }
  .review-meta strong { display: block; color: var(--ink-1); font-weight: 600; font-size: var(--fs-sm); }
  .review-meta span { display: block; color: var(--ink-4); font-size: var(--fs-xs); }

  .reviews-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    color: var(--ink-1);
    font-size: 1.1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out),
                background var(--dur-base) var(--ease-out);
    box-shadow: var(--shadow-callout);
  }
  .reviews-arrow:hover { background: var(--ink-1); color: #fff; }
  .reviews-arrow--prev { left: -20px; }
  .reviews-arrow--next { right: -20px; }
  @media (max-width: 800px) {
    .review { flex-basis: 85%; min-width: 0; }
    .reviews-arrow { display: none; }
  }

  /* ============================================================ */
  /* FINAL CTA                                                    */
  /* ============================================================ */
  .final-cta {
    padding-block: var(--section-pad-y);
    background: var(--surface-1);
  }
  .cta-card {
    position: relative;
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: clamp(20px, 2.5vw, 28px);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    overflow: hidden;
  }
  .cta-glow {
    position: absolute;
    inset: -40% -10% auto -10%;
    height: 80%;
    background: radial-gradient(closest-side, rgba(0, 122, 255, 0.16), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
    z-index: 0;
  }
  .cta-card > * { position: relative; z-index: 1; }
  .eyebrow--dark {
    background: var(--surface-1);
  }
  .cta-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--ink-1);
    max-width: 22ch;
  }
  .cta-sub {
    font-size: var(--fs-lg);
    color: var(--ink-3);
  }
  .cta-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* ============================================================ */
  /* TAB SAVER                                                    */
  /* ============================================================ */
  .tabsaver { background: var(--surface-1); }
  .tabsaver-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .tabsaver-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .tabsaver-text .btn { margin-top: var(--space-2); }
  .tabsaver-shot {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tabsaver-shot :global(img) {
    width: 100%;
    max-width: 380px;
    height: auto;
