---
/**
 * Homepage — 2026 redesign.
 *
 * Design system = the product's own tokens (see src/styles/landing.css).
 * Every product visual is a DOM reconstruction of real Marqly UI; the page
 * saves one bookmark in the hero and finds it again in the search section.
 *
 * SEO: title/description/canonical and ALL JSON-LD payloads are carried over
 * unchanged from the previous homepage. The visible FAQ text and the FAQPage
 * JSON-LD share one source (components/landing/faqs.ts).
 */
import LandingV2 from '../layouts/LandingV2.astro';
import { alternatesForPath } from '../i18n/routes';
import { organization } from '../lib/schema';
import { homeFaqs } from '../components/landing/faqs';

import Nav from '../components/landing/Nav.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import LibrarySection from '../components/landing/LibrarySection.astro';
import SearchSection from '../components/landing/SearchSection.astro';
import SaveAnywhereSection from '../components/landing/SaveAnywhereSection.astro';
import OrganizerSection from '../components/landing/OrganizerSection.astro';
import ChatVaultSection from '../components/landing/ChatVaultSection.astro';
import EverywhereSection from '../components/landing/EverywhereSection.astro';
import MoreSection from '../components/landing/MoreSection.astro';
import ReviewsSection from '../components/landing/ReviewsSection.astro';
import PricingSection from '../components/landing/PricingSection.astro';
import FaqSection from '../components/landing/FaqSection.astro';
import CloseSection from '../components/landing/CloseSection.astro';
import FooterV2 from '../components/landing/FooterV2.astro';

const title = 'Marqly — AI Bookmark Manager | Organize Smarter, Find Faster';
const description =
  'Marqly is the AI bookmark manager with a smart New Tab, Clipboard History, saved AI chats, YouTube summaries, and webpage highlights. Start free.';
const canonical = 'https://www.marqly.com/';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Marqly',
    url: 'https://www.marqly.com/',
  },
  organization(),
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Marqly',
    applicationCategory: 'ProductivityApplication',
    operatingSystem: 'Web, iOS, Chrome, Edge, Firefox, Safari',
    url: 'https://www.marqly.com',
    installUrl:
      'https://chromewebstore.google.com/detail/marqly-all-in-one-bookmar/kcadneobjofkppmekgadodnaojoehemc',
    description:
      'AI bookmark manager with semantic search — save articles, videos, and links, then find any of them by describing what you remember instead of the exact title.',
    featureList: [
      'Semantic AI search (find saves by meaning, not keywords)',
      'Automatic AI tagging',
      'AI article summaries',
      'AI YouTube summaries, chat, and playback-synced transcript on the watch page',
      'Marqly Home New Tab workspace with quick links, notes, to-dos, weather, and saved sessions',
      'Clipboard History with search, favorites, pinning, and tags in Chrome and Edge',
      'Capture conversations from ChatGPT, Claude, and Gemini in Chrome, Edge, and Firefox',
      'Save, close, and restore open tab sessions',
      'Chrome and Edge side panel for bookmarks, clipboard items, highlights, and AI chats',
      'Web highlighter — 6 colors and notes that persist on any page',
      'Save any webpage as a clean, screen-faithful PDF',
      'Public board sharing — links and highlights, no signup to view',
      'Import from Pocket, Raindrop, and browser bookmarks',
    ],
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: '0',
      highPrice: '72',
      offerCount: 2,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      reviewCount: '150',
      bestRating: '5',
      worstRating: '1',
    },
    author: {
      '@type': 'Organization',
      name: 'Marqly',
      url: 'https://www.marqly.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<LandingV2 title={title} description={description} canonical={canonical} jsonLd={jsonLd} alternates={alternatesForPath('/')}>
  <Nav slot="nav" />
  <HeroSection />
  <LibrarySection />
  <SearchSection />
  <SaveAnywhereSection />
  <OrganizerSection />
  <ChatVaultSection />
  <EverywhereSection />
  <MoreSection />
  <PricingSection />
  <ReviewsSection />
  <FaqSection />
  <CloseSection />
  <FooterV2 slot="footer" />
</LandingV2>
