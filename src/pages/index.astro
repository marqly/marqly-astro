---
import { Image } from 'astro:assets';
import LandingLayout from '../layouts/LandingLayout.astro';
import heroApp from '../assets/images/home/hero-app.png';
import browsers from '../assets/images/home/browsers.avif';
import avatarAdrian from '../assets/images/home/avatar-adrian.avif';
import avatarMichael from '../assets/images/home/avatar-michael.avif';
import avatarChenten from '../assets/images/home/avatar-chenten.avif';
import avatarTina from '../assets/images/home/avatar-tina.avif';

const APP = 'https://app.marqly.com';
const CHROME =
  'https://chromewebstore.google.com/detail/marqly-all-in-one-bookmar/kcadneobjofkppmekgadodnaojoehemc';

const title = 'Marqly — AI Bookmark Manager | Organize Smarter, Find Faster';
const description =
  'Marqly is the AI bookmark manager that auto-organizes your links, summarizes YouTube videos, and highlights any page. Start free — no card required.';
const canonical = 'https://www.marqly.com/';

const features = [
  { key: 'ai', ai: true, title: 'AI Auto-Organize', body: 'Links land where they belong with accurate tags applied instantly by AI.' },
  { key: 'search', title: 'Instant Search', body: 'Find any bookmark instantly by text, tag, date, or URL.' },
  { key: 'reader', title: 'Reader View & AI Summaries', body: 'Get the context without reopening pages. Distraction-free reading built in.' },
  { key: 'offline', title: 'Offline Mode & Link Health', body: 'Full access without a connection. Know when saved links break or go stale.' },
  { key: 'sync', title: 'Cross-Platform Sync', body: 'Pocket, mobile, desktop — in lockstep. Your library, everywhere you read.' },
  { key: 'youtube', title: 'YouTube AI Summaries & Chat', body: 'A TL;DR, a transcript, and answers about any video — right on the watch page.' },
  { key: 'highlights', title: 'Highlights & Notes', body: 'Highlight any website in 6 colors. Your highlights survive reloads and sync everywhere.' },
  { key: 'pdf', title: 'Save Pages as PDF', body: 'Freeze any page exactly as it looks on screen — free, local, one click.' },
];

// Visible FAQ + matching FAQPage JSON-LD (identical text — Google's requirement).
const homeFaqs = [
  {
    q: 'Is Marqly free?',
    a: 'Yes. The free plan includes one-click saving, tags, search, and access on every device — no credit card required. Marqly Pro adds unlimited bookmarks, AI features like semantic search and YouTube chat, highlights, and smart sorting for $48/year (about $4/month billed annually) after a 7-day free trial.',
    href: '/faq/is-marqly-free',
  },
  {
    q: 'Which browsers does the Marqly extension support?',
    a: 'The Marqly extension runs on Chrome, Edge, Firefox, and Safari. Your library also syncs to the Marqly web app and the iOS app, so everything you save is available on desktop, tablet, and phone.',
  },
  {
    q: 'Can Marqly summarize YouTube videos?',
    a: 'Yes. Marqly adds an AI card right on the YouTube watch page with a streaming summary (TL;DR plus key sections), a chat tab that answers questions from the video’s transcript, and a playback-synced transcript you can copy in one click. Books mentioned in the video are surfaced automatically.',
  },
  {
    q: 'Can I highlight text on websites with Marqly?',
    a: 'Yes. Select text on any page and highlight it in one of 6 colors, with optional notes. Highlights are restored when you revisit the page, appear in the browser side panel, and sync to your Marqly library so they’re searchable alongside your bookmarks.',
  },
  {
    q: 'Can Marqly save a webpage as a PDF?',
    a: 'Yes. From the save dialog you can export any page as a clean PDF that matches the on-screen layout — lazy-loaded images included. It runs locally in your browser and the page is never uploaded anywhere.',
  },
  {
    q: 'How is Marqly different from browser bookmarks?',
    a: 'Browser bookmarks are a folder tree you have to file and remember. Marqly auto-tags every save with AI and lets you search by meaning — describe what the page was about and it surfaces, even if you forgot the title. It also captures highlights, transcripts, and PDFs, not just URLs.',
    href: '/faq/how-is-marqly-different-from-browser-bookmarks',
  },
  {
    q: 'Can I import my bookmarks from Pocket or Raindrop?',
    a: 'Yes. Marqly imports Pocket export files, Raindrop.io collections, and the standard bookmark HTML that Chrome, Edge, Firefox, and Safari export. Everything you import is auto-tagged by AI on the way in, so your whole backlog becomes searchable by meaning immediately.',
    href: '/faq/how-do-i-import-from-pocket',
  },
  {
    q: 'How do I get a YouTube video’s transcript?',
    a: 'Open any YouTube video with the Marqly extension installed and the AI card next to the player includes a Transcript tab — playback-synced, with one-click copy. Bookmarking the video from YouTube’s action row saves it with the transcript attached, so it stays searchable later.',
    href: '/faq/how-do-i-get-a-youtube-transcript',
  },
  {
    q: 'What is semantic search?',
    a: 'Semantic search finds saves by meaning instead of exact keywords. Type “that video about sourdough starters” and Marqly surfaces the right save even if those words never appear in the title — it searches across titles, content, highlights, and transcripts.',
    href: '/faq/what-is-semantic-search',
  },
  {
    q: 'Is Marqly a good Pocket replacement?',
    a: 'Yes. Pocket shut down in July 2025, and Marqly covers the same save-for-later core — then adds AI tagging, summaries, and semantic search that Pocket never had. It imports your Pocket export file directly, so switching takes minutes.',
    href: '/faq/is-marqly-a-pocket-replacement',
  },
  {
    q: 'Is there an iOS app?',
    a: 'Yes. The Marqly iOS app puts your whole library — saves, tags, highlights — on your iPhone and iPad, synced with the extension and web app. Download it from the App Store and sign in with the same account.',
    href: '/faq/is-there-an-ios-app',
  },
  {
    q: 'Does Marqly work on Android?',
    a: 'There’s no Android app yet, but the Marqly web app at app.marqly.com works in any Android browser, so your saves are always reachable. On desktop, the extension covers Chrome, Edge, Firefox, and Safari.',
    href: '/faq/is-there-an-android-app',
  },
  {
    q: 'How do I cancel my subscription?',
    a: 'From your account settings at app.marqly.com, any time — you keep Pro access until the end of the billing period, and your saves stay on the free plan afterwards. If anything goes wrong, email support@marqly.com.',
    href: '/faq/how-do-i-cancel-my-subscription',
  },
  {
    q: 'Can I share what I save?',
    a: 'Yes. Group links and highlights into boards, then share any board as a public page — viewers don’t need an account. Public boards also appear in Marqly’s Discover directory if you want them found.',
    href: '/faq/how-do-i-share-a-board-publicly',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Marqly',
    url: 'https://www.marqly.com/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Marqly',
    url: 'https://www.marqly.com',
    logo: 'https://www.marqly.com/favicon.png',
    sameAs: ['https://twitter.com/getmarqly', 'https://x.com/getmarqly'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Marqly',
    applicationCategory: 'ProductivityApplication',
    operatingSystem: 'Web, iOS, Chrome, Edge, Firefox, Safari',
    url: 'https://www.marqly.com',
    installUrl:
      'https://chromewebstore.google.com/detail/marqly-all-in-one-bookmar/kcadneobjofkppmekgadodnaojoehemc',
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', bestRating: '5', ratingCount: 32 },
    description:
      'AI bookmark manager with semantic search — save articles, videos, and links, then find any of them by describing what you remember instead of the exact title.',
    featureList: [
      'Semantic AI search (find saves by meaning, not keywords)',
      'Automatic AI tagging',
      'AI article summaries',
      'AI YouTube summaries, chat, and playback-synced transcript on the watch page',
      'Web highlighter — 6 colors and notes that persist on any page',
      'Save any webpage as a clean, screen-faithful PDF',
      'Public board sharing — links and highlights, no signup to view',
      'Import from Pocket, Raindrop, and browser bookmarks',
    ],
    offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: '0', offerCount: 2 },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const steps = [
  {
    n: '01',
    title: 'Install the extension',
    body: 'One click from the Chrome, Edge, Firefox, or Safari store. Marqly sits quietly in your toolbar until you need it.',
  },
  {
    n: '02',
    title: 'Save anything, anywhere',
    body: 'Click the Marqly icon — or hit ⌘+Shift+S. We capture the page and tag it for you.',
  },
  {
    n: '03',
    title: 'Find it the moment you need it',
    body: 'Search by what it was about, not by what it was called. The page finds itself.',
  },
];

const tiers = [
  {
    name: 'Free',
    price: '$0',
    period: 'forever',
    blurb: 'Everything you need to stop losing tabs.',
    cta: 'Get Marqly Free',
    href: APP,
    featured: false,
    perks: [
      'Up to 50 bookmarks',
      'Basic search',
      'Bookmark preview',
      'Bookmark tags',
      'Access on mobile, tablet',
      'Unlimited devices',
    ],
  },
  {
    name: 'Pro',
    monthly: { amount: '$8', period: 'per month' },
    yearly: { amount: '$4', period: 'per month, billed annually' },
    blurb: '7-day free trial. Cancel anytime.',
    cta: 'Start 7-day trial',
    href: APP,
    featured: true,
    perks: [
      'Unlimited bookmarks',
      'AI Powered Features',
      'YouTube AI summaries & chat',
      'Super fast search',
      'Boards & collections',
      'Highlights & notes',
      'Read mode',
      'Smart sorting',
      'Priority support by email',
    ],
  },
];
// Non-null aliases (satisfies noUncheckedIndexedAccess — the array is a fixed 2-tuple).
const tierFree = tiers[0]!;
const tierPro = tiers[1]!;

const testimonials = [
  {
    name: 'Chenten',
    role: 'Product Designer, Berlin',
    avatar: avatarChenten,
    quote:
      'Great bookmarking tool with a user-friendly interface. Absolutely a great way to save your bookmarks.',
  },
  {
    name: 'Adrian',
    role: 'Indie founder, Lisbon',
    avatar: avatarAdrian,
    quote:
      'I love the simplicity of Marqly. It allows me to manage all of my bookmarks in a single place.',
  },
  {
    name: 'Michael',
    role: 'Researcher, Toronto',
    avatar: avatarMichael,
    quote:
      'Fantastic way to organize bookmarks. Highly recommended!',
    dark: true,
  },
  {
    name: 'Tina',
    role: 'Editor, New York',
    avatar: avatarTina,
    quote:
      'The reader mode plus AI summaries save me hours every week. Worth every cent of Pro.',
  },
];
---

<LandingLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <!-- ============================================================ -->
  <!-- HERO                                                         -->
  <!-- ============================================================ -->
  <section class="hero" aria-labelledby="hero-h1">
    <div class="container">
      <div class="hero-inner">
        <span class="eyebrow" data-reveal>
          <span class="dot"></span> New — AI summaries, chat & transcripts on YouTube
        </span>

        <h1 id="hero-h1" class="hero-title" data-reveal data-reveal-delay="1">
          The Bookmark Manager<br />
          <span class="grad">supercharged with AI.</span>
        </h1>

        <p class="hero-sub" data-reveal data-reveal-delay="2">
          The free bookmark manager that reads, tags, and organizes every link you save.
          Search by context, not keywords. Welcome to the future of bookmarks.
        </p>

        <div class="hero-ctas" data-reveal data-reveal-delay="3">
          <a href={APP} class="btn btn--primary btn--lg">
            Get Started for Free
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="https://apps.apple.com/us/app/marqly-ai-bookmark-manager/id6758905385"
            class="btn btn--outline btn--lg btn--ios"
            target="_blank"
            rel="noopener"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
            Download iOS App
          </a>
        </div>

        <p class="hero-micro" data-reveal data-reveal-delay="4">
          No card required · Works on every device
        </p>

        <!-- Hero composition: dashboard screenshot + callouts + save popup overlaid -->
        <div class="hero-shot" data-reveal data-reveal-delay="4">
          <div class="callout callout--left" aria-hidden="true">
            <span class="callout-dot callout-dot--accent"></span>
            Tagged in 0.3s
          </div>

          <Image
            class="hero-bg"
            src={heroApp}
            alt="Marqly bookmark manager dashboard"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 980px) 94vw, 1100px"
            loading="eager"
          />

          <!-- Save popup (the extension in action, overlaid on the dashboard) -->
          <div class="save-pop" role="img" aria-label="Marqly extension saving a webpage with AI-generated tags">
            <div class="save-pop-head">
              <span class="save-pop-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg>
              </span>
              <div>
                <strong>Save to Marqly</strong>
                <span class="save-pop-sub">Auto-tagging with AI</span>
              </div>
            </div>
            <div class="save-pop-tags">
              <span class="tag tag--accent">productivity</span>
              <span class="tag">deep-work</span>
              <span class="tag">research</span>
              <span class="tag">to-read</span>
            </div>
            <div class="save-pop-foot">
              <span class="save-pop-spinner" aria-hidden="true"></span>
              <span>Saving & generating summary…</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FEATURES BENTO — pixel-perfect custom UI per card            -->
  <!-- ============================================================ -->
  <section class="features section" id="features" aria-labelledby="features-h2">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow"><span class="dot"></span> Features</span>
        <h2 id="features-h2" class="section-title">
          Everything you need in a bookmark manager
        </h2>
        <p class="section-sub">
          Rebuilt from the ground up with AI at the core. Marqly brings lightning-fast
          performance, smart auto-tagging, and a beautiful new interface.
        </p>
      </header>

      <div class="bento">
        <!-- AI card (full width) -->
        <article class="bento-card bento-card--ai bento-card--wide" data-reveal data-reveal-delay="1">
          <div class="bento-text">
            <span class="ai-badge">AI</span>
            <h3 class="bento-title">AI Auto-Organize</h3>
            <p class="bento-body">Links land where they belong with accurate tags applied instantly by AI.</p>
          </div>
          <div class="bento-shot">
            <div class="ui-panel ui-inbox" aria-hidden="true">
              <div class="ui-panel-head">
                <div class="ui-panel-title">
                  <span class="ui-spark" aria-hidden="true">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"/></svg>
                  </span>
                  Inbox
                </div>
                <span class="ui-badge">4 new</span>
                <div class="ui-panel-tools" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
              </div>
              <ul class="ui-list">
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#111">M</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">Designing for AI Agents</span>
                    <span class="ui-row-sub">medium.com · @kentcdodds · 6 min</span>
                  </div>
                  <div class="ui-row-tags">
                    <span class="ui-tag ui-tag--ai">productivity</span>
                    <span class="ui-tag ui-tag--ai">design</span>
                  </div>
                </li>
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#000">N</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">The True Cost of Context Switching</span>
                    <span class="ui-row-sub">nytimes.com · @sellersburg · 8 min</span>
                  </div>
                  <div class="ui-row-tags">
                    <span class="ui-tag">productivity</span>
                    <span class="ui-tag">deep-work</span>
                  </div>
                </li>
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#635bff">S</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">Why Async Communication Wins</span>
                    <span class="ui-row-sub">stripe.com · blog · 5 min</span>
                  </div>
                  <div class="ui-row-tags">
                    <span class="ui-tag ui-tag--ai">workplace</span>
                    <span class="ui-tag ui-tag--ai">remote</span>
                  </div>
                </li>
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#fc6d26">JC</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">How to Build Habits That Stick</span>
                    <span class="ui-row-sub">jamesclear.com · blog · 7 min</span>
                  </div>
                  <div class="ui-row-tags">
                    <span class="ui-tag">productivity</span>
                    <span class="ui-tag">habits</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </article>

        <!-- Instant Search (cell) -->
        <article class="bento-card bento-card--cell" data-reveal data-reveal-delay="1">
          <div class="bento-text">
            <h3 class="bento-title">Instant Search</h3>
            <p class="bento-body">Find any bookmark instantly by text, tag, date, or URL.</p>
          </div>
          <div class="bento-shot">
            <div class="ui-panel ui-search" aria-hidden="true">
              <div class="ui-search-bar">
                <span class="ui-search-icon" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </span>
                <span class="ui-search-query">ai tools</span>
                <span class="ui-search-cursor" aria-hidden="true"></span>
                <span class="ui-search-kbd">⌘K</span>
              </div>
              <div class="ui-search-meta">12 results · 0.04s</div>
              <ul class="ui-list ui-list--rows">
                <li class="ui-row ui-row--active">
                  <span class="ui-favicon" style="--c:#0ea5a4">AT</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">AI Tools <em>Weekly</em></span>
                    <span class="ui-row-sub">aitoolsweekly.com · newsletter</span>
                  </div>
                </li>
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#111">M</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">Designing for <em>AI</em> Agents</span>
                    <span class="ui-row-sub">medium.com · @kentcdodds</span>
                  </div>
                </li>
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#222">GH</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">Best <em>AI</em> Bookmarks</span>
                    <span class="ui-row-sub">github.com · awesome list</span>
                  </div>
                </li>
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#007aff">P</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">Prompt Library for <em>AI</em> Tools</span>
                    <span class="ui-row-sub">promptbase.com · directory</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </article>

        <!-- Reader View & AI Summaries (cell) -->
        <article class="bento-card bento-card--cell" data-reveal data-reveal-delay="2">
          <div class="bento-text">
            <h3 class="bento-title">Reader View & AI Summaries</h3>
            <p class="bento-body">Get the context without reopening pages. Distraction-free reading built in.</p>
          </div>
          <div class="bento-shot">
            <div class="ui-panel ui-reader" aria-hidden="true">
              <div class="ui-reader-bar">
                <span class="ui-reader-back" aria-hidden="true">←</span>
                <span class="ui-reader-domain">nytimes.com</span>
                <span class="ui-reader-actions" aria-hidden="true">
                  <span class="ui-pill ui-pill--on">Read</span>
                  <span class="ui-pill">Save</span>
                </span>
              </div>
              <div class="ui-reader-body">
                <div class="ui-reader-text">
                  <h4 class="ui-reader-title">The True Cost of<br/>Context Switching</h4>
                  <span class="ui-reader-meta">8 min read · Apr 2026</span>
                  <div class="ui-reader-lines" aria-hidden="true">
                    <span style="width:96%"></span>
                    <span style="width:82%"></span>
                    <span style="width:94%"></span>
                    <span style="width:70%"></span>
                    <span style="width:88%"></span>
                    <span style="width:60%"></span>
                  </div>
                </div>
                <div class="ui-summary">
                  <div class="ui-summary-head">
                    <span class="ui-spark ui-spark--ai" aria-hidden="true">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"/></svg>
                    </span>
                    <strong>AI Summary</strong>
                  </div>
                  <ul class="ui-summary-bullets">
                    <li>Context switches cost 23 min of refocus per interruption.</li>
                    <li>Async tools cut meetings and recover ~6 hrs per week.</li>
                    <li>Save with one click; AI tags + summary arrive in 0.3s.</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- Offline Mode & Link Health (cell) -->
        <article class="bento-card bento-card--cell" data-reveal data-reveal-delay="1">
          <div class="bento-text">
            <h3 class="bento-title">Offline Mode & Link Health</h3>
            <p class="bento-body">Full access without a connection. Know when saved links break or go stale.</p>
          </div>
          <div class="bento-shot">
            <div class="ui-panel ui-offline" aria-hidden="true">
              <div class="ui-panel-head">
                <div class="ui-panel-title">Saved · 12</div>
                <div class="ui-offline-pill">
                  <span class="ui-offline-dot" aria-hidden="true"></span>
                  Offline
                </div>
              </div>
              <ul class="ui-list ui-list--rows">
                <li class="ui-row">
                  <span class="ui-favicon" style="--c:#000">N</span>
                  <div class="ui-row-main">
                    <span class="ui-row-title">The True Cost of Context Switching</span>
                    <span class="ui-row-sub">nytimes.com</span>
                  </div>
                  <span class="ui-status ui-status--ok">
                    <span class="ui-status-dot" aria-hidden="true"></span> Cached
                  </span>
                </li>
                <li class="ui-row">
