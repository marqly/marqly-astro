---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { organization, breadcrumbList, webSite, itemList } from '../../lib/schema';

const title = 'Research | Marqly';
const description = 'Measured, reproducible studies from Marqly on how bookmark and read-it-later tools actually behave — method, data, and dates on every page.';
const canonical = 'https://www.marqly.com/research';
const updated = '2026-10-05';

const studies = [
  {
    path: '/research/bookmark-import-fidelity',
    title: 'When your bookmark export won’t import: what we measured',
    blurb: 'Real, hash-pinned public export files through a bookmark importer: 0/261 Pocket HTML, 43/43 Chrome, a Raindrop description bug (fixed), and why save dates don’t survive.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList([{ name: 'Home', path: '/' }, { name: 'Research', path: '/research' }]),
  itemList(studies.map((s) => s.title), '/research', studies.map((s) => s.path)),
];
---

<LandingLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="page">
    <div class="wrap">
      <h1>Research</h1>
      <p class="lede">Small, honest studies. Every page states its method, its date, and the exact data it
        ran on — and links our <a href="/how-we-test">testing standards</a>. We publish a number only when we
        actually measured it.</p>
      <ul class="list">
        {studies.map((s) => (
          <li>
            <a class="t" href={s.path}>{s.title}</a>
            <p>{s.blurb}</p>
          </li>
        ))}
      </ul>
      <p class="updated" data-date={updated}>Last updated: <time datetime={updated}>October 5, 2026</time></p>
    </div>
  </section>
</LandingLayout>

<style>
  .page { background: var(--surface-1, #fff); }
  .wrap { max-width: 44rem; margin: 0 auto; padding: var(--space-16, 4rem) var(--space-5, 1.25rem) var(--space-24, 6rem); }
  h1 { font-size: var(--fs-h1, 2.4rem); color: var(--ink-1, #101014); margin: 0 0 var(--space-3, .75rem); }
  .lede { line-height: 1.6; color: var(--ink-2, #374151); }
  .lede a { color: var(--ink-1, #101014); text-decoration: underline; text-underline-offset: 2px; }
  .list { list-style: none; padding: 0; margin: var(--space-8, 2rem) 0 0; display: grid; gap: var(--space-4, 1rem); }
  .list li { padding: var(--space-5, 1.25rem); border: 1px solid var(--border-1, #eceef1); border-radius: var(--radius-card, 12px); }
  .t { font-size: var(--fs-h4, 1.15rem); font-weight: 600; color: var(--ink-1, #101014); text-decoration: none; }
  .t:hover { text-decoration: underline; text-underline-offset: 2px; }
  .list p { margin: .4rem 0 0; color: var(--ink-2, #374151); line-height: 1.6; font-size: var(--fs-sm, .95rem); }
  .updated { margin-top: var(--space-8, 2rem); font-size: var(--fs-sm, .85rem); color: var(--ink-3, #6b7280); }
</style>
