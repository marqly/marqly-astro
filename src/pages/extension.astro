---
/**
 * /extension — redesigned end to end in the homepage's design system.
 * SEO payload (title, description, canonical, og image, JSON-LD incl.
 * breadcrumbs and the 4-question FAQPage) carried over unchanged.
 * Every visual is a DOM reconstruction of real extension UI.
 */
import LandingV2 from '../layouts/LandingV2.astro';
import { breadcrumbList, faqPage, organization, softwareApplication } from '../lib/schema';

import Nav from '../components/landing/Nav.astro';
import FooterV2 from '../components/landing/FooterV2.astro';
import CloseSection from '../components/landing/CloseSection.astro';
import MoreSection from '../components/landing/MoreSection.astro';
import { BrowserFrame } from '../components/landing/BrowserFrame';
import { PopupDemo } from '../components/landing/PopupDemo';
import { SidePanelDemo } from '../components/landing/SidePanelDemo';
import { SaveModal } from '../components/landing/SaveModal';
import HighlighterDemo from '../components/landing/HighlighterDemo';
import YouTubeShowcase from '../components/landing/YouTubeShowcase';
import { NewTabDemo } from '../components/landing/demos';
import { CheckIcon } from '../components/landing/icons';
import { APP_URL, CHROME_URL, EDGE_URL, FIREFOX_URL } from '../components/landing/data';

const title = 'Marqly Browser Extension — Every Feature';
const description =
  'Explore every Marqly extension feature: New Tab, Clipboard History, saved AI chats, highlights, tab sessions, YouTube AI, PDF export, and more.';

const faqs = [
  {
    q: 'Which browsers support the Marqly extension?',
    a: 'Marqly is available for Chrome, Edge, Firefox, and Safari. Core saving, organizing, search, highlights, and YouTube features work across the supported extensions, while Clipboard History and the side panel are currently Chrome and Edge features.',
  },
  {
    q: 'Does Marqly include a New Tab page?',
    a: 'Yes. Marqly Home replaces the New Tab page in Chrome, Edge, and Firefox with search, quick links, notes, to-dos, weather, backgrounds, and saved browsing sessions. It is not currently available in Safari.',
  },
  {
    q: 'Can Marqly save my clipboard history?',
    a: 'Yes, in Chrome and Edge. Clipboard History keeps text copied from webpages together in the extension, with search, filters, favorites, pinning, and tags. Pro members can also sync clipboard items through their Marqly account.',
  },
  {
    q: 'Can I save ChatGPT, Claude, and Gemini conversations?',
    a: 'Yes. In Chrome, Edge, and Firefox, Marqly can capture conversations from ChatGPT, Claude, and Gemini and keep them in a dedicated AI Chats view. AI chat capture is not currently available in Safari.',
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Browser extension', path: '/extension' },
  ]),
  faqPage(faqs),
];

const browsers = [
  {
    name: 'Chrome',
    logo: '/landing/browsers/chrome.png',
    tier: 'Full workspace',
    features: [
      'Everything: saving, search, boards',
      'Marqly Home New Tab',
      'Side panel + Clipboard History',
      'AI chat capture, YouTube AI',
      'Tab sessions, PDF, media tools',
    ],
    href: CHROME_URL,
    cta: 'Install for Chrome',
    primary: true,
  },
  {
    name: 'Microsoft Edge',
    logo: '/landing/browsers/edge.png',
    tier: 'Full workspace',
    features: [
      'Everything: saving, search, boards',
      'Marqly Home New Tab',
      'Side panel + Clipboard History',
      'AI chat capture, YouTube AI',
      'Tab sessions, PDF, media tools',
    ],
    href: EDGE_URL,
    cta: 'Install for Edge',
    primary: false,
  },
  {
    name: 'Firefox',
    logo: '/landing/browsers/firefox.png',
    tier: 'Most features',
    features: [
      'Saving, search, boards, highlights',
      'Marqly Home New Tab',
      'AI chat capture, YouTube AI',
      'Tab sessions',
      'PDF via the browser print flow',
    ],
    href: FIREFOX_URL,
    cta: 'Install for Firefox',
    primary: false,
  },
  {
    name: 'Safari',
    logo: '/landing/browsers/safari.png',
    tier: 'Core features',
    features: [
      'Saving, organizing, and search',
      'Highlights and notes',
      'YouTube tools, tab saving',
      'PDF via the browser print flow',
      'Syncs with the iOS app',
    ],
    href: null,
    cta: null,
    primary: false,
  },
];
---

<LandingV2
  title={title}
  description={description}
  canonical="https://www.marqly.com/extension"
  ogImage="https://www.marqly.com/og/seo/extension.png"
  jsonLd={jsonLd}
>
  <Nav slot="nav" />

  <!-- Hero: the popup, where it actually lives — dropped from the toolbar -->
  <section class="relative overflow-hidden">
    <div
      aria-hidden
      class="pointer-events-none absolute inset-0"
      style="background:
        radial-gradient(58% 42% at 16% 4%, color-mix(in oklab, var(--hl-blue) 52%, transparent) 0%, transparent 62%),
        radial-gradient(52% 38% at 84% 2%, color-mix(in oklab, var(--hl-purple) 40%, transparent) 0%, transparent 60%),
        radial-gradient(64% 44% at 55% 26%, color-mix(in oklab, var(--hl-mint) 26%, transparent) 0%, transparent 66%),
        linear-gradient(180deg, var(--background) 0%, #ffffff 100%)"
    >
    </div>

    <div class="relative mx-auto max-w-[1120px] px-5 pt-10 pb-20 md:px-8 md:pt-12 md:pb-28">
      <nav aria-label="Breadcrumb" class="text-[12px] text-foreground/60">
        <a href="/" class="hover:text-foreground">Home</a>
        <span aria-hidden> / </span>
        <span class="text-foreground/80">Browser extension</span>
      </nav>

      <div class="mx-auto mt-8 max-w-[720px] text-center">
        <p class="text-[11px] font-semibold tracking-[0.16em] text-foreground/70 uppercase">
          Browser extension
        </p>
        <h1
          class="font-display mt-4 text-[clamp(2.4rem,6vw,4rem)] leading-[1.05] font-medium tracking-[-0.015em] text-foreground"
        >
          One extension.<br />
          Your browser <em class="mark-stroke">workspace.</em>
        </h1>
        <p class="mx-auto mt-6 max-w-[560px] text-[17px] leading-relaxed text-[#4b4b53]">
          Marqly is more than a save button. It turns your New Tab page, copied text, highlights,
          AI conversations, videos, and open tabs into one organized workspace.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={CHROME_URL}
            target="_blank"
            rel="noopener"
            class="flex h-11 items-center rounded-3xl bg-accent px-6 text-[15px] font-medium text-accent-foreground shadow-custom transition-transform active:scale-[0.97]"
          >
            Add to Chrome, it's free
          </a>
          <a
            href={APP_URL}
            class="flex h-11 items-center rounded-3xl bg-white px-5 text-[15px] font-medium text-foreground shadow-surface transition-colors hover:bg-white/80"
          >
            Sign up to Marqly
          </a>
        </div>
        <p class="mt-5 text-[12px] text-foreground/70">
          Free to install · Chrome · Edge · Firefox · Safari
        </p>
      </div>

      <!-- The popup, over the page you're reading -->
      <div class="mx-auto mt-12 max-w-[860px] md:mt-16">
        <BrowserFrame url="feelgoodfoodie.net/recipe/best-hummus">
          <div class="relative h-[430px] overflow-hidden bg-background">
            <div aria-hidden class="h-full px-8 pt-8 opacity-60 sm:px-14">
              <div class="mx-auto max-w-[560px]">
                <span class="text-[11px] text-muted">feelgoodfoodie.net · Recipes</span>
                <p
                  class="font-display mt-3 text-[28px] leading-tight font-medium text-foreground sm:text-3xl"
                >
                  The Hummus I Make Every Week
                </p>
                <p class="mt-2 text-[11px] text-muted/80">5 ingredients · 10 minutes</p>
                <div class="mt-5 space-y-2.5 text-[13px] leading-relaxed text-muted/90">
                  <p>
                    Chickpeas, tahini, lemon, garlic, and ice-cold water. Authentic Lebanese hummus
                    needs nothing else, and the blender does most of the work.
                  </p>
                  <p>
                    The cold water is the trick: streamed in while blending, it whips the tahini
                    and turns the whole bowl pale, light, and impossibly smooth.
                  </p>
                </div>
              </div>
            </div>
            <div class="absolute top-4 right-4 sm:right-10">
              <PopupDemo />
            </div>
          </div>
        </BrowserFrame>
        <p class="mt-4 text-center text-[12px] text-muted/90">
          One click on the toolbar. Everything the extension does starts here.
        </p>
      </div>
    </div>
  </section>

  <!-- Save dialog + side panel -->
  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="max-w-[600px]" data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">
          Save and browse
        </p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          The AI files it.<br />The panel keeps it close.
        </h2>
        <p class="mt-4 max-w-[520px] text-[16px] leading-relaxed text-muted">
          Saving picks the board and tags for you. The side panel keeps your whole library one
          click from the page you're reading.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 items-stretch gap-5 md:grid-cols-2 md:gap-6">
        <figure class="flex flex-col" data-reveal>
          <div
            class="flex flex-1 items-center justify-center rounded-3xl p-5 py-10 sm:p-8 sm:py-12"
            style="background: color-mix(in oklab, var(--hl-yellow) 34%, white)"
          >
            <SaveModal
              phase="thinking"
              url="asana.com"
              title="Asana: The OS for human-agent teams"
              boardEmoji="🚀"
              boardName="Side projects"
              tags={['productivity', 'work', 'saas']}
              className="min-h-[430px]"
            />
          </div>
          <figcaption class="mt-4 text-sm leading-relaxed text-muted">
            <b class="font-semibold text-foreground">Caught mid-thought.</b>
            The AI is finding the board and writing the tags while the dialog is still open.
          </figcaption>
        </figure>

        <figure class="flex flex-col" data-reveal style="--reveal-delay: 70ms">
          <div
            class="flex flex-1 items-center justify-center rounded-3xl p-5 py-10 sm:p-8 sm:py-12"
            style="background: color-mix(in oklab, var(--hl-purple) 26%, white)"
          >
            <SidePanelDemo className="min-h-[430px]" />
          </div>
          <figcaption class="mt-4 text-sm leading-relaxed text-muted">
            <b class="font-semibold text-foreground">Side panel library.</b>
            Bookmarks, clipboard, highlights, and AI chats next to the page. Chrome and Edge.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- YouTube AI, full width on a soft coral band -->
  <section
    class="py-20 md:py-28"
    style="background: color-mix(in oklab, var(--hl-coral) 16%, white)"
  >
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="max-w-[600px]" data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">
          On the watch page
        </p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          YouTube, summarized<br />where you watch it.
        </h2>
      </div>
      <figure class="mt-10" data-reveal>
        <YouTubeShowcase bare client:visible />
        <figcaption class="mt-4 max-w-[640px] text-sm leading-relaxed text-muted">
          <b class="font-semibold text-foreground">The AI card sits beside the player.</b>
          Streaming summary, chat over the transcript, playback-synced timestamps. Save the video
          and all of it stays searchable. <a
            href="/youtube-summarizer"
            class="font-medium text-foreground underline underline-offset-2">More on YouTube AI</a
          >
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Highlighter + Marqly Home -->
  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="max-w-[600px]" data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">
          Read and return
        </p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          Mark the page.<br />Own the new tab.
        </h2>
      </div>

      <div class="mt-10 grid grid-cols-1 items-stretch gap-5 md:grid-cols-2 md:gap-6">
        <figure class="flex flex-col" data-reveal>
          <div
            class="flex flex-1 items-center justify-center rounded-3xl p-5 py-10 sm:p-8 sm:py-12"
            style="background: color-mix(in oklab, var(--hl-mint) 30%, white)"
          >
            <HighlighterDemo client:visible />
          </div>
          <figcaption class="mt-4 text-sm leading-relaxed text-muted">
            <b class="font-semibold text-foreground">Highlights that survive.</b>
            Six markers with notes, restored on every revisit, synced to your library.
            <a href="/web-highlighter" class="font-medium text-foreground underline underline-offset-2"
              >About the highlighter</a
            >
          </figcaption>
        </figure>

        <figure class="flex flex-col" data-reveal style="--reveal-delay: 70ms">
          <div class="aspect-auto flex-1">
            <NewTabDemo />
          </div>
          <figcaption class="mt-4 text-sm leading-relaxed text-muted">
            <b class="font-semibold text-foreground">Marqly Home.</b>
            New Tab becomes library search, quick links, notes, to-dos, and saved sessions.
            Chrome, Edge, and Firefox.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Clipboard History + tab sessions (shared with home) -->
  <MoreSection />

  <!-- Browser availability -->
  <section id="availability" class="py-20 md:py-28">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="max-w-[600px]" data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">
          Browser availability
        </p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          Choose your browser.
        </h2>
        <p class="mt-4 max-w-[520px] text-[16px] leading-relaxed text-muted">
          The essentials work everywhere. Browser-specific APIs make a few workspace features
          different.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          browsers.map((b, i) => (
            <div
              class="flex flex-col rounded-3xl bg-surface p-6 shadow-surface"
              data-reveal
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <div class="flex items-center justify-between">
                <img src={b.logo} alt="" width="36" height="36" class="size-9 object-contain" loading="lazy" />
                <p class="text-[10px] font-semibold tracking-wider text-muted uppercase">{b.tier}</p>
              </div>
              <h3 class="mt-3 text-lg font-semibold text-foreground">{b.name}</h3>
              <ul class="mt-4 flex-1 space-y-2">
                {b.features.map((f) => (
                  <li class="flex items-start gap-2 text-[13px] leading-snug text-foreground/80">
                    <CheckIcon size={13} className="mt-0.5 shrink-0 text-muted" />
                    {f}
                  </li>
                ))}
              </ul>
              {b.href ? (
                <a
                  href={b.href}
                  target="_blank"
                  rel="noopener"
                  class={`mt-5 flex h-10 items-center justify-center rounded-3xl text-sm font-medium transition-transform active:scale-[0.97] ${
                    b.primary
                      ? 'bg-accent text-accent-foreground'
                      : 'bg-default text-foreground hover:bg-default/70'
                  }`}
                >
                  {b.cta}
                </a>
              ) : (
                <span class="mt-5 flex h-10 items-center justify-center rounded-3xl bg-default/50 text-sm font-medium text-muted">
                  Ships with the iOS app
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Extension FAQ -->
  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="max-w-[600px]" data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">FAQ</p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          Extension questions.
        </h2>
      </div>
      <div class="mt-10 max-w-[760px]">
        {
          faqs.map((f) => (
            <details class="faq-item group border-b border-separator">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-medium text-foreground [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M12 5.5v13M5.5 12h13" />
                  </svg>
                </span>
              </summary>
              <div class="pb-5 text-sm leading-relaxed text-muted">{f.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CloseSection padTop />
  <FooterV2 slot="footer" />
</LandingV2>
