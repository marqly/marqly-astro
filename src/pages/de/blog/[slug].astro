---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  // German posts live at src/content/blog/de/<slug>.md (collection id `de/<slug>`)
  // and render here at /de/blog/<slug>. BlogPostLayout handles lang, canonical,
  // hreflang, and locale chrome from the post's `lang` frontmatter.
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'de');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^de\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post}>
  <Content />
</BlogPostLayout>
