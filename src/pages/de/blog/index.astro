---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import LandingLayout from '../../../layouts/LandingLayout.astro';
import { alternatesForPath } from '../../../i18n/routes';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'de')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('de-DE', { year: 'numeric', month: 'short', day: 'numeric' });

const title = 'Der Marqly Blog auf Deutsch — Lesezeichen, KI & zweites Gehirn';
const description =
  'Ratgeber und Vergleiche auf Deutsch: Lesezeichen verwalten, Später-lesen-Apps, KI-Suche und das zweite Gehirn im Browser. Vom Team hinter Marqly.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Marqly Blog (Deutsch)',
    url: 'https://www.marqly.com/de/blog',
    description,
    inLanguage: 'de',
    blogPost: posts.slice(0, 20).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `https://www.marqly.com/de/blog/${p.id.replace(/^de\//, '')}`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
];
---

<LandingLayout
  title={title}
  description={description}
  canonical="https://www.marqly.com/de/blog"
  jsonLd={jsonLd}
  lang="de"
  alternates={alternatesForPath('/de/blog')}
  showLinkHub={false}
>
  <div class="blog-index">
    <header class="blog-head">
      <p class="kicker">Der Marqly Blog</p>
      <h1>Speichern mit System. Alles wiederfinden.</h1>
      <p class="sub">
        Ratgeber und Vergleiche auf Deutsch: Lesezeichen verwalten, Später-lesen-Apps und ein
        durchsuchbares zweites Gehirn im Browser.
      </p>
    </header>

    <div class="grid">
      {posts.map((post) => (
        <a class="card" href={`/de/blog/${post.id.replace(/^de\//, '')}`}>
          {post.data.heroImage && (
            <div class="card-img">
              <Image
                src={post.data.heroImage}
                alt={post.data.heroAlt ?? post.data.title}
                widths={[320, 480, 640]}
                sizes="(max-width: 700px) 100vw, 360px"
              />
            </div>
          )}
          <div class="card-body">
            <span class="chip">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          </div>
        </a>
      ))}
    </div>

    <p class="en-note">
      Mehr Artikel gibt es im <a href="/blog">englischen Blog</a> — die deutschen Ausgaben
      wachsen gerade.
    </p>
  </div>
</LandingLayout>

<style>
  .blog-index {
    max-width: 1140px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }
  .blog-head { max-width: 680px; margin-bottom: var(--space-16); }
  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  .blog-head h1 { font-size: var(--fs-h1); margin-bottom: var(--space-4); }
  .blog-head .sub { font-size: var(--fs-lg); color: var(--color-text-soft); line-height: var(--lh-snug); }

  .chip {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(0, 122, 255, 0.08);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
  }
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .card:hover { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); transform: translateY(-2px); }
  .card-img :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 10; }
  .card-body { padding: var(--space-6); display: flex; flex-direction: column; flex: 1; }
  .card-body h2 { font-size: var(--fs-lg); margin-bottom: var(--space-3); line-height: var(--lh-snug); }
  .card-body p { color: var(--color-text-soft); font-size: var(--fs-sm); margin-bottom: var(--space-4); }
  .card-body time { font-size: var(--fs-sm); color: var(--color-text-muted); margin-top: auto; }

  .en-note { margin-top: var(--space-12); font-size: var(--fs-sm); color: var(--color-text-muted); }
  .en-note a { text-decoration: underline; }
</style>
