---
import { getCollection } from 'astro:content';
import LocaleLander from '../../components/seo/LocaleLander.astro';

export async function getStaticPaths() {
  const entries = await getCollection('localePages', ({ data }) => !data.draft && data.lang === 'tr');
  return entries.map((entry) => ({
    params: {
      slug: entry.data.path === '/tr' ? undefined : entry.data.path.replace(/^\/tr\//, ''),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<LocaleLander entry={entry} />
