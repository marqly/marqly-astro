---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import { breadcrumbList, faqPage, howTo, organization, softwareApplication, webSite } from '../../lib/schema';

const path = '/migrate/instapaper';
const title = 'How to Migrate from Instapaper to Marqly (2026 Guide) — Step-by-Step';
const description =
  'Export your reading list and highlights from Instapaper and import them into Marqly in under 2 minutes. Upgrade to AI auto-tagging, summaries, and semantic search.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare' },
  { name: 'Migrate from Instapaper', path },
];

const steps = [
  {
    name: 'Export your archive from Instapaper',
    text: 'Sign in to your Instapaper account on the web, navigate to Settings, and scroll down to the Export section. Click to download your library as an HTML or CSV file.',
    url: path,
  },
  {
    name: 'Upload the export file to Marqly',
    text: 'Sign in to Marqly at app.marqly.com (free account, no credit card required). Go to Settings → Import Bookmarks and upload your Instapaper file.',
    url: path,
  },
  {
    name: 'AI auto-tags and semantically indexes your saves',
    text: 'Marqly restores your articles and highlights. On Pro, AI automatically generates summaries, tags, and semantic embeddings so you can find any article by describing its meaning.',
    url: path,
  },
];

const faqs = [
  {
    q: 'Will my Instapaper highlights and folders be preserved?',
    a: 'Yes. Instapaper exports standard HTML or CSV files that contain your saved URLs, titles, folder groupings, and highlight snippets. Marqly maps your folders to boards and preserves your highlights.',
  },
  {
    q: 'How does Marqly compare to Instapaper for reading?',
    a: 'Instapaper is a classic read-it-later queue focused on clean article typography and Kindle delivery. Marqly provides a distraction-free clean reader view and text highlighter, but adds an active AI intelligence layer: automatic summaries, AI auto-tagging, semantic search, and interactive YouTube video transcripts.',
  },
  {
    q: 'Is Marqly free to try for Instapaper users?',
    a: 'Yes. Marqly offers a free tier that stores up to 100 bookmarks with search across your whole library, without requiring a credit card. Pro adds unlimited bookmarks and semantic AI search, billed when you upgrade — cancel anytime.',
  },
  {
    q: 'Can I keep using Instapaper alongside Marqly?',
    a: 'Yes. Exporting your data from Instapaper leaves your Instapaper library completely untouched. You can import your archive into Marqly to evaluate its AI search and organization while keeping Instapaper active.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  softwareApplication(),
  breadcrumbList(crumbs),
  howTo(
    'How to Migrate from Instapaper to Marqly in 3 Steps',
    'Step-by-step instructions for importing your Instapaper reading backlog into Marqly with AI indexing.',
    steps,
    'PT2M',
  ),
  faqPage(faqs),
];
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogImage="https://www.marqly.com/og/seo/migrate-instapaper.png"
>
  <article class="section">
    <div class="container migrate-page">
      <Breadcrumbs items={crumbs} />

      <header class="page-head">
        <div class="badge-row">
          <span class="pill-badge">Migration Guide · 2026</span>
          <span class="time-badge">⏱️ Takes ~2 minutes</span>
        </div>
        <h1>How to Migrate from Instapaper to Marqly</h1>
        <p class="lead">
          Turn your unread Instapaper backlog into an intelligent, searchable second brain. Here is how to export your saved articles and import them into Marqly in minutes.
        </p>
      </header>

      <div class="comparison-callout">
        <div class="callout-head">
          <span class="callout-tag">Why users switch</span>
          <h3>What changes when you move to Marqly?</h3>
        </div>
        <div class="callout-grid">
          <div class="callout-item">
            <strong>Semantic Search by Meaning</strong>
            <p>Instapaper search requires remembering exact keywords. Marqly finds articles when you only remember the concept or core argument.</p>
          </div>
          <div class="callout-item">
            <strong>Instant AI Summaries</strong>
            <p>Every article you save receives a concise streaming summary, letting you triage a multi-year backlog in minutes.</p>
          </div>
          <div class="callout-item">
            <strong>YouTube Transcript Chat</strong>
            <p>Save YouTube videos with their transcripts attached, read synchronized video text, and chat with video content directly.</p>
          </div>
          <div class="callout-item">
            <strong>Side Panel & Tab Management</strong>
            <p>Browse your library and clipboard history right beside any open webpage using Chrome and Edge side panels.</p>
          </div>
        </div>
        <p class="callout-footer">
          Want a full comparison? See our <a href="/compare/marqly-vs-instapaper">Marqly vs Instapaper comparison</a> or browse other <a href="/alternatives/instapaper">Instapaper alternatives</a>.
        </p>
      </div>

      <h2>Step-by-Step Migration Walkthrough</h2>
      <div class="steps-list">
        <div class="step-card">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Export your library from Instapaper</h3>
            <p>
              Log in to <a href="https://www.instapaper.com" target="_blank" rel="noopener">instapaper.com</a> in your browser. Go to <strong>Settings</strong> and scroll to <strong>Export</strong>. Choose HTML or CSV format and save the file to your computer.
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Import into Marqly</h3>
            <p>
              Open <a href="https://app.marqly.com">app.marqly.com</a> (sign up free without a credit card). In <strong>Settings → Import Bookmarks</strong>, upload your downloaded Instapaper export file.
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>AI tags and embeds your reading archive</h3>
            <p>
              Marqly recreates your reading collection with highlights preserved. On Pro, AI automatically tags and summarizes each article, making your entire backlog searchable by meaning.
            </p>
          </div>
        </div>
      </div>

      <FaqAccordion faqs={faqs} heading="Frequently asked migration questions" />

      <CtaBox
        heading="Ready to upgrade your reading library?"
        sub="Import your Instapaper backlog in under 2 minutes. Free forever up to 100 bookmarks."
        ctaLabel="Migrate to Marqly free"
        ctaUrl="https://app.marqly.com"
      />
    </div>
  </article>
</LandingLayout>

<style>
  .migrate-page { max-width: 860px; }
  .badge-row { display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-3); }
  .pill-badge {
    display: inline-block; font-size: var(--fs-xs); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    background: var(--surface-2); color: var(--ink-2);
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); border: 1px solid var(--border-1);
  }
  .time-badge { font-size: var(--fs-xs); color: var(--ink-3); font-weight: 500; }
  h1 { font-size: var(--fs-h2); font-weight: 600; letter-spacing: var(--tracking-tight); color: var(--ink-1); line-height: var(--lh-tight); }
  .lead { margin-top: var(--space-4); font-size: var(--fs-lg); line-height: var(--lh-base); color: var(--ink-2); }

  .comparison-callout {
    margin-top: var(--space-8); margin-bottom: var(--space-10);
    background: var(--surface-1); border: 1px solid var(--border-1);
    border-radius: var(--radius-card); padding: var(--space-6);
  }
  .callout-head { margin-bottom: var(--space-5); }
  .callout-tag { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--ink-3); }
  .callout-head h3 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-top: var(--space-1); }
  .callout-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-5); }
  .callout-item strong { display: block; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-1); }
  .callout-item p { font-size: var(--fs-sm); color: var(--ink-2); line-height: var(--lh-base); margin: 0; }
  .callout-footer { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--border-1); font-size: var(--fs-sm); color: var(--ink-3); }
  .callout-footer a { color: var(--ink-1); text-decoration: underline; font-weight: 500; }

  h2 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-top: var(--space-10); margin-bottom: var(--space-6); }

  .steps-list { display: flex; flex-direction: column; gap: var(--space-6); }
  .step-card {
    display: flex; gap: var(--space-5);
    background: var(--surface-1); border: 1px solid var(--border-1);
    border-radius: var(--radius-card); padding: var(--space-6);
  }
  .step-num {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    background: var(--ink-1); color: var(--surface-1);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--fs-base); font-weight: 600;
  }
  .step-content { flex: 1; }
  .step-content h3 { font-size: var(--fs-lg); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-2); }
  .step-content p { font-size: var(--fs-base); color: var(--ink-2); line-height: var(--lh-base); margin: 0; }
</style>
