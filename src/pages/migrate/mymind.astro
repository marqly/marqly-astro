---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import { breadcrumbList, faqPage, howTo, organization, softwareApplication, webSite } from '../../lib/schema';

const path = '/migrate/mymind';
const title = 'How to Migrate from mymind to Marqly (2026 Guide) — Move Your Saves';
const description =
  'Export your saves from mymind and import them into Marqly in minutes. Keep AI auto-tagging and semantic search, plus gain bookmark imports and shareable public boards.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare' },
  { name: 'Migrate from mymind', path },
];

const steps = [
  {
    name: 'Export your cards from mymind',
    text: 'Open mymind in desktop Chrome or Edge, go to your Account Settings, and find the Export section. Download your cards.csv archive (along with your media files ZIP).',
    url: path,
  },
  {
    name: 'Upload your export file to Marqly',
    text: 'Sign in to Marqly at app.marqly.com (free account, no credit card required). In Settings → Import, upload your cards.csv or bookmark archive.',
    url: path,
  },
  {
    name: 'Enjoy zero-filing AI organization with sharing',
    text: 'Marqly restores your saved links and notes. On Pro, AI automatically tags, generates short summaries, and enables semantic search, while unlocking public boards and web highlighting.',
    url: path,
  },
];

const faqs = [
  {
    q: 'Can I export my data from mymind?',
    a: 'Yes. From your account settings in desktop Chrome or Edge, mymind provides a data export containing a cards.csv file (holding your saved links, notes, quotes, and highlights) plus a ZIP of uploaded images and PDFs.',
  },
  {
    q: 'Will my saved links and tags transfer into Marqly?',
    a: 'Yes. Marqly imports the URLs, titles, and text notes from your mymind export. Once imported, Marqly automatically applies AI tags and short summaries to each link so your zero-effort organization is preserved.',
  },
  {
    q: 'Why do users switch from mymind to Marqly?',
    a: 'While mymind is visually beautiful, it is strictly single-player: you cannot share any link, list, or board with anyone, and it deliberately blocks importing existing browser bookmarks. Marqly delivers the same zero-filing AI auto-tagging and semantic search, but adds shareable public boards, browser bookmark imports, YouTube transcript chat, and a 100-save free tier.',
  },
  {
    q: 'Do I need a credit card to try Marqly?',
    a: 'No. Marqly provides a free tier storing up to 100 bookmarks with search across your whole library. You can import your saves, explore the interface, and test semantic search without entering payment details.',
  },
  {
    q: 'Does Marqly support visual cards like mymind?',
    a: 'Yes. Marqly provides rich visual preview cards, grid layouts, and side-panel views alongside reader mode and text highlighting, giving you visual inspiration without locking your content into a closed silo.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  softwareApplication(),
  breadcrumbList(crumbs),
  howTo(
    'How to Migrate from mymind to Marqly in 3 Steps',
    'A quick guide for mymind users to export their saved cards and import them into Marqly with AI semantic indexing and shareable boards.',
    steps,
    'PT2M',
  ),
  faqPage(faqs),
];
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogImage="https://www.marqly.com/og/seo/migrate-mymind.png"
>
  <article class="section">
    <div class="container migrate-page">
      <Breadcrumbs items={crumbs} />

      <header class="page-head">
        <div class="badge-row">
          <span class="pill-badge">Migration Guide · 2026</span>
          <span class="time-badge">⏱️ Takes ~2 minutes</span>
        </div>
        <h1>How to Migrate from mymind to Marqly</h1>
        <p class="lead">
          Love mymind's "zero manual organization" promise but frustrated by zero sharing, no mass imports, and high subscription fees? Here is how to move your saves to Marqly in three simple steps.
        </p>
      </header>

      <div class="comparison-callout">
        <div class="callout-head">
          <span class="callout-tag">Why users switch</span>
          <h3>What changes when you move to Marqly?</h3>
        </div>
        <div class="callout-grid">
          <div class="callout-item">
            <strong>Public Boards & Sharing</strong>
            <p>mymind is strictly anti-social with zero sharing. Marqly lets you share curated boards publicly with clients, friends, or teammates via simple links.</p>
          </div>
          <div class="callout-item">
            <strong>True Semantic Paraphrase Search</strong>
            <p>Describe what you remember in plain language ("that article explaining sleep and cortisol") and find saves instantly without exact keywords.</p>
          </div>
          <div class="callout-item">
            <strong>Full Import Freedom</strong>
            <p>mymind forbids bulk import. Marqly welcomes your past saves: import from Pocket, Raindrop, or any browser HTML export anytime.</p>
          </div>
          <div class="callout-item">
            <strong>Affordable AI Summaries</strong>
            <p>mymind gates AI summaries to its $12.99/mo Mastermind tier. Marqly includes AI summaries, semantic search, and YouTube transcript chat at half the price.</p>
          </div>
        </div>
        <p class="callout-footer">
          Want a detailed comparison? Read our full <a href="/compare/marqly-vs-mymind">Marqly vs mymind comparison</a> or explore <a href="/alternatives/mymind">mymind alternatives</a>.
        </p>
      </div>

      <h2>Step-by-Step Migration Walkthrough</h2>
      <div class="steps-list">
        <div class="step-card">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Export your cards from mymind</h3>
            <p>
              Open mymind in desktop Chrome or Edge (export is only enabled on desktop Chromium browsers). Go to your <strong>Account Settings</strong> and scroll to <strong>Export Data</strong>. Download your <code>cards.csv</code> file.
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Upload to Marqly</h3>
            <p>
              Sign up for free at <a href="https://app.marqly.com">app.marqly.com</a> (no credit card required). In <strong>Settings → Import Bookmarks</strong>, select CSV / HTML and upload your file.
            </p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>AI automatically organizes your library</h3>
            <p>
              Marqly parses your links, notes, and tags. AI automatically creates summaries and embeds every item for semantic search. You can also organize links into public shareable boards or pin them to your new tab workspace.
            </p>
          </div>
        </div>
      </div>

      <FaqAccordion faqs={faqs} heading="Frequently asked migration questions" />

      <CtaBox
        heading="Ready for zero-filing bookmarks with sharing?"
        sub="Import your mymind export and test semantic search across your saves in under 2 minutes. Free forever up to 100 bookmarks."
        ctaLabel="Migrate to Marqly free"
        ctaUrl="https://app.marqly.com"
      />
    </div>
  </article>
</LandingLayout>

<style>
  .migrate-page { max-width: 860px; }
  .badge-row { display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-3); }
  .pill-badge {
    display: inline-block; font-size: var(--fs-xs); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    background: var(--surface-2); color: var(--ink-2);
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); border: 1px solid var(--border-1);
  }
  .time-badge { font-size: var(--fs-xs); color: var(--ink-3); font-weight: 500; }
  h1 { font-size: var(--fs-h2); font-weight: 600; letter-spacing: var(--tracking-tight); color: var(--ink-1); line-height: var(--lh-tight); }
  .lead { margin-top: var(--space-4); font-size: var(--fs-lg); line-height: var(--lh-base); color: var(--ink-2); }

  .comparison-callout {
    margin-top: var(--space-8); margin-bottom: var(--space-10);
    background: var(--surface-1); border: 1px solid var(--border-1);
    border-radius: var(--radius-card); padding: var(--space-6);
  }
  .callout-head { margin-bottom: var(--space-5); }
  .callout-tag { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--ink-3); }
  .callout-head h3 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-top: var(--space-1); }
  .callout-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-5); }
  .callout-item strong { display: block; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-1); }
  .callout-item p { font-size: var(--fs-sm); color: var(--ink-2); line-height: var(--lh-base); margin: 0; }
  .callout-footer { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--border-1); font-size: var(--fs-sm); color: var(--ink-3); }
  .callout-footer a { color: var(--ink-1); text-decoration: underline; font-weight: 500; }

  h2 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-top: var(--space-10); margin-bottom: var(--space-6); }

  .steps-list { display: flex; flex-direction: column; gap: var(--space-6); }
  .step-card {
    display: flex; gap: var(--space-5);
    background: var(--surface-1); border: 1px solid var(--border-1);
    border-radius: var(--radius-card); padding: var(--space-6);
  }
  .step-num {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    background: var(--ink-1); color: var(--surface-1);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--fs-base); font-weight: 600;
  }
  .step-content { flex: 1; }
  .step-content h3 { font-size: var(--fs-lg); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-2); }
  .step-content p { font-size: var(--fs-base); color: var(--ink-2); line-height: var(--lh-base); margin: 0; }
</style>
