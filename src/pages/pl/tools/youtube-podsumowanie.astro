---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import ToolShell from '../../../components/seo/ToolShell.astro';
import { breadcrumbList, faqPage, freeWebApplication, organization, webSite } from '../../../lib/schema';
import { alternatesForPath } from '../../../i18n/routes';

const path = '/pl/tools/youtube-podsumowanie';
const title = 'Darmowy podsumowywacz wideo YouTube — TL;DR każdego filmu';
const description =
  'Wklej link do filmu YouTube i dostan streszczenie AI z najważniejszymi punktami — za darmo. Podsumowania na samej stronie filmu, plus transkrypcja i czat, oferuje rozszerzenie Marqly.';

const faqs = [
  {
    q: 'Jak działa narzędzie do podsumowywania YouTube?',
    a: 'Pobiera ścieżkę napisów filmu, a model AI kondensuje ją do krótkiego TL;DR z najważniejszymi punktami. Podsumowanie opiera się na transkrypcji — streszcza to, co faktycznie powiedziano, a nie to, co obiecuje tytuł.',
  },
  {
    q: 'Czy działa z filmami bez napisów?',
    a: 'Nie. Jeśli film ma wyłączone napisy, nie ma transkrypcji do streszczenia. Większość filmów na YouTube ma co najmniej napisy generowane automatycznie i tu działają one bez problemu.',
  },
  {
    q: 'Czy jest limit długości?',
    a: 'Bardzo długie filmy są streszczane z mniej więcej pierwszej godziny transkrypcji. Rozszerzenie Marqly ogarnia pełne długości filmów i dorzuca podział na sekcje, wymieniane książki oraz zakładkę czatu, która odpowiada na pytania z całej transkrypcji.',
  },
  {
    q: 'Czy to jest darmowe?',
    a: 'Tak — bez rejestracji. To przedsmak tego, co rozszerzenie Marqly robi automatycznie na każdej stronie filmu YouTube: płynące podsumowanie AI, kluczowe sekcje, transkrypcja zsynchronizowana z odtwarzaniem i czat oparty na transkrypcji.',
  },
];

const jsonLd = [
  organization(),
  webSite('pl'),
  breadcrumbList([
    { name: 'Strona główna', path: '/pl' },
    { name: 'Podsumowanie YouTube', path },
  ]),
  faqPage(faqs, 'pl'),
  freeWebApplication(
    'Podsumowanie wideo YouTube AI',
    'Błyskawiczne streszczanie filmów z YouTube za pomocą sztucznej inteligencji. Za darmo, online.',
    path,
    'pl',
  ),
];
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  lang="pl"
  alternates={alternatesForPath(path)}
  showLinkHub={false}
  localeLinkHub="pl"
>
  <ToolShell
    name="Podsumowanie YouTube"
    heading="Błyskawiczne podsumowanie filmów YouTube przez AI"
    sub="Wklej link do wideo i poznaj najważniejsze wnioski w kilka sekund. Bez rejestracji, bezpłatnie — na podstawie faktycznych napisów."
    faqs={faqs}
    faqHeading="Często zadawane pytania"
    crumbs={[
      { name: 'Strona główna', path: '/pl' },
      { name: 'Podsumowanie YouTube', path },
    ]}
    ctaHeading="Podsumowania przy każdym filmie — bez kopiowania linków"
    ctaSub="Marqly dokłada płynące podsumowanie AI, kluczowe sekcje, transkrypcję i czat obok odtwarzacza na każdej stronie YouTube."
    ctaLabel="Rozpocznij za darmo"
    ctaSecondaryLabel="Dodaj do Chrome"
    backHref={null}
  >
    <form id="ys-form">
      <div class="tool-row">
        <div class="grow">
          <label for="ys-url">Link do filmu YouTube</label>
          <input id="ys-url" type="url" placeholder="https://www.youtube.com/watch?v=…" required />
        </div>
        <button class="btn btn--primary" type="submit">Podsumuj</button>
      </div>
      <p class="tool-status" id="ys-status" role="status"></p>
    </form>
    <div class="tool-output hidden" id="ys-out" aria-live="polite"></div>

    <!-- Sekcje tej strony (lustrzane odbicie nagłówków EN):
## Jak streścić wideo z YouTube
## Kiedy podsumowanie bije oglądanie
    -->
    <Fragment slot="content">
      <h2>Jak streścić wideo z YouTube</h2>
      <ol>
        <li>Wklej adres URL filmu w polu powyżej i kliknij <strong>Podsumuj</strong>.</li>
        <li>Narzędzie pobierze transkrypcję filmu i skondensuje ją za pomocą AI.</li>
        <li>Przeczytaj TL;DR i najważniejsze punkty — zwykle poniżej 30 sekund dla dowolnego filmu.</li>
      </ol>
      <p>
        Podsumowania powstają ze ścieżki napisów, więc oddają to, co mówca faktycznie powiedział.
        To różnica między prawdziwym streszczeniem a zgadywanką na podstawie tytułu i miniaturki —
        i dlatego filmów z wyłączonymi napisami nie da się podsumować.
      </p>

      <h2>Kiedy podsumowanie bije oglądanie</h2>
      <ul>
        <li><strong>Triage kolejki „Do obejrzenia”</strong> — w kilka sekund zdecyduj, które filmy są warte pełnej uwagi.</li>
        <li><strong>Długie podcasty i wykłady</strong> — poznaj wywód bez oglądania 90 minut.</li>
        <li><strong>Poradniki</strong> — sprawdź, czy film faktycznie rozwiązuje Twój problem, zanim się w niego wtopisz.</li>
      </ul>
      <p>
        Jeśli selekcjonujesz filmy codziennie, rób to tam, gdzie one żyją:
        <a href="/pl/podsumowanie-youtube">rozszerzenie Marqly</a> streamuje podsumowanie obok odtwarzacza
        w chwili otwarcia strony filmu — z kluczowymi sekcjami, wymienianymi książkami,
        <a href="/faq/how-do-i-get-a-youtube-transcript">zsynchronizowaną transkrypcją</a> oraz
        <a href="/pl/blog/czat-z-filmami-youtube-2026">czatem opartym na transkrypcji</a>. Zapisane filmy
        zachowują swoje transkrypcje, więc możesz do nich wracać i cytować je miesiące później.
        Pełny, nieskrócony tekst wypowiedzi pobierzesz darmowym narzędziem
        <a href="/pl/tools/youtube-transkrypcja">Transkrypcja YouTube</a>.
      </p>
    </Fragment>
  </ToolShell>
</LandingLayout>

<script>
  const form = document.getElementById('ys-form') as HTMLFormElement;
  const input = document.getElementById('ys-url') as HTMLInputElement;
  const status = document.getElementById('ys-status')!;
  const out = document.getElementById('ys-out')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    out.classList.add('hidden');
    status.classList.remove('is-error');
    try {
      status.textContent = 'Pobieranie transkrypcji…';
      const tRes = await fetch(`/api/youtube-transcript?v=${encodeURIComponent(input.value)}`);
      const tData = await tRes.json() as {
        error?: string;
        title: string;
        segments: { text: string }[];
      };
      if (!tRes.ok) throw new Error(tData.error ?? 'Nie udało się pobrać transkrypcji.');

      status.textContent = `Generowanie streszczenia AI dla „${tData.title}”…`;
      const text = tData.segments.map((s: { text: string }) => s.text).join(' ');
      const sRes = await fetch('/api/summarize', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ text, title: tData.title, lang: 'pl' }),
      });
      const sData = await sRes.json() as {
        error?: string;
        summary: string;
        truncated?: boolean;
      };
      if (!sRes.ok) throw new Error(sData.error ?? 'Błąd podczas generowania podsumowania.');

      status.textContent = tData.title;
      out.textContent = sData.summary + (sData.truncated ? '\n\n(W przypadku bardzo długiego wideo podsumowano pierwszą część.)' : '');
      out.classList.remove('hidden');
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : 'Wystąpił błąd.';
      status.classList.add('is-error');
    }
  });
</script>
