---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import ToolShell from '../../../components/seo/ToolShell.astro';
import { breadcrumbList, faqPage, freeWebApplication, organization, webSite } from '../../../lib/schema';
import { alternatesForPath } from '../../../i18n/routes';

const path = '/pl/tools/youtube-transkrypcja';
const title = 'Transkrypcja YouTube – Pobierz i skopiuj napisy z filmu | Marqly';
const description =
  'Wklej link do YouTube i natychmiast pobierz całą transkrypcję w formie tekstu. Kopiuj jednym kliknięciem lub pobierz jako .txt z sygnaturami czasowymi. Bezpłatnie.';

const faqs = [
  {
    q: 'Jak pobrać transkrypcję z filmu na YouTube?',
    a: 'Wklej adres URL filmu w pole powyżej — narzędzie pobiera ścieżkę napisów, którą YouTube już posiada dla tego filmu. Możesz skopiować całą transkrypcję jednym kliknięciem albo pobrać ją jako plik tekstowy. Jeśli chcesz mieć transkrypcję przy każdym filmie, nie opuszczając YouTube, rozszerzenie Marqly dodaje kartę transkrypcji zsynchronizowaną z odtwarzaniem bezpośrednio na stronie filmu.',
  },
  {
    q: 'Dlaczego narzędzie nie znalazło napisów?',
    a: 'Niektóre filmy mają napisy wyłączone przez autora, a bardzo świeże nagrania mogą jeszcze nie mieć napisów automatycznych. Jeśli film pokazuje napisy w YouTube, a narzędzie zwraca błąd, możliwe że YouTube ogranicza nasz serwer limitami żądań — rozszerzenie Marqly odczytuje napisy bezpośrednio w twojej przeglądarce, co całkowicie to obejdzie.',
  },
  {
    q: 'Czy narzędzie obsługuje automatyczne napisy?',
    a: 'Tak. Jeśli twórca dodał własne napisy ręczne, narzędzie daje im pierwszeństwo; w przeciwnym razie sięga po ścieżkę wygenerowaną automatycznie przez YouTube. Napisy automatyczne od czasu do czasu przekręcą słowa, więc nazwiska i terminy techniczne zweryfikuj z nagraniami.',
  },
  {
    q: 'Czy mogę pobrać transkrypcję z sygnaturami czasowymi?',
    a: 'Tak. Przed skopiowaniem tekstu lub pobraniem pliku .txt wystarczy zaznaczyć albo odznaczyć opcję „Znaczniki czasu”. Z znacznikami otrzymujesz linie w formacie [min:sek], bez nich — czysty tekst gotowy do wklejenia do notatek.',
  },
  {
    q: 'Czy to na pewno jest darmowe?',
    a: 'Tak — bez rejestracji, bez znaku wodnego, bez dziennego paywalla. Narzędzie istnieje, bo rozszerzenie Marqly robi to samo (plus streszczenia AI i czat oparty na transkrypcji) na każdej stronie YouTube; wolimy ci to pokazać, niż opisywać.',
  },
];

const jsonLd = [
  organization(),
  webSite('pl'),
  breadcrumbList([
    { name: 'Strona główna', path: '/' },
    { name: 'Transkrypcja YouTube', path },
  ]),
  faqPage(faqs, 'pl'),
  freeWebApplication(
    'Transkrypcja YouTube',
    'Pobierz pełną transkrypcję dowolnego filmu z YouTube w formie tekstu. Za darmo, online.',
    path,
    'pl',
  ),
];
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  lang="pl"
  alternates={alternatesForPath(path)}
  showLinkHub={false}
  localeLinkHub="pl"
>
  <ToolShell
    name="Transkrypcja YouTube"
    heading="Transkrypcja z YouTube w jednym kliknięciu"
    sub="Wklej link, uzyskaj pełny tekst wypowiedzi z filmu. Za darmo, bez logowania. Skopiuj do schowka lub pobierz jako plik tekstowy."
    faqs={faqs}
    faqHeading="Często zadawane pytania"
    crumbs={[
      { name: 'Strona główna', path: '/' },
      { name: 'Transkrypcja YouTube', path },
    ]}
    ctaHeading="Transkrypcja przy każdym filmie – automatycznie?"
    ctaSub="Rozszerzenie Marqly dodaje do każdego odtwarzacza YouTube kartę zsynchronizowanej transkrypcji, streszczenie AI i czat z wideo."
    ctaLabel="Rozpocznij za darmo z Marqly"
    ctaSecondaryLabel="Dodaj do Chrome"
    backHref={null}
  >
    <form id="yt-form">
      <div class="tool-row">
        <div class="grow">
          <label for="yt-url">Link do filmu YouTube</label>
          <input id="yt-url" type="url" placeholder="https://www.youtube.com/watch?v=…" required />
        </div>
        <button class="btn btn--primary" type="submit">Pobierz transkrypcję</button>
      </div>
      <p class="tool-status" id="yt-status" role="status"></p>
    </form>
    <div class="tool-actions hidden" id="yt-actions">
      <button class="btn btn--outline btn--sm" id="yt-copy" type="button">Skopiuj tekst</button>
      <button class="btn btn--outline btn--sm" id="yt-download" type="button">Pobierz .txt</button>
      <label style="display:inline-flex;align-items:center;gap:.4rem;margin:0;font-weight:400;">
        <input type="checkbox" id="yt-stamps" checked style="width:auto;" /> Znaczniki czasu
      </label>
    </div>
    <div class="tool-output hidden" id="yt-out" aria-live="polite"></div>

    <Fragment slot="content">
      <!-- Section index (mirrors the <h2> headings below for the parity checker):
      ## Jak pobrać transkrypcję z YouTube w tekście
      ## Do czego przydaje się transkrypcja wideo
      ## Wygodniej: transkrypcja prosto w YouTube z Marqly
      -->
      <h2>Jak pobrać transkrypcję z YouTube w tekście</h2>
      <ol>
        <li>Skopiuj link do filmu z paska adresu lub z przycisku Udostępnij.</li>
        <li>Wklej go w pole powyżej i kliknij <strong>Pobierz transkrypcję</strong>.</li>
        <li>Skopiuj tekst lub pobierz go jako plik <code>.txt</code> — z sygnaturami czasowymi albo bez nich.</li>
      </ol>
      <p>
        Narzędzie czyta tę samą ścieżkę napisów, którą YouTube wygenerował dla filmu — dokładnie te
        dane, które stoją za panelem „Pokaż transkrypcję” — bez klikania, scrollowania i kopiowania
        linijka po linijce. Działa zarówno z napisami dodanymi ręcznie przez twórcę, jak i z tymi
        generowanymi automatycznie, w języku udostępnionym przez autora.
      </p>

      <h2>Do czego ludzie używają transkrypcji</h2>
      <ul>
        <li><strong>Skanowanie przed oglądaniem</strong> — 40-minutowa konferencja staje się 4-minutowym czytaniem.</li>
        <li><strong>Dokładne cytowanie</strong> — wyciągaj dosłowne brzmienie zdań do notatek, pracy dyplomowej czy artykułu.</li>
        <li><strong>Nauka</strong> — przeszukuj wykłady w poszukiwaniu potrzebnego terminu zamiast przewijać w ciemno (Ctrl+F).</li>
        <li><strong>Podawanie dalej do AI</strong> — wklej transkrypcję do chatbota i zadawaj pytania o film (rozszerzenie Marqly robi to na miejscu, w zakładce czatu opartej na transkrypcji — patrz <a href="/pl/tools/youtube-podsumowanie">Podsumowanie YouTube</a>).</li>
      </ul>

      <h2>Wygodniej: transkrypcja prosto na stronie YouTube</h2>
      <p>
        Jeśli robisz to częściej niż okazjonalnie, pętla kopiuj-wklej szybko się opatruje.
        Rozszerzenie <a href="/pl/podsumowanie-youtube">Marqly</a> dokłada kartę AI obok każdego filmu
        na YouTube: zakładkę transkrypcji zsynchronizowaną z odtwarzaniem (kopiowanie jednym
        kliknięciem, aktualne zdanie podświetla się w trakcie), płynące streszczenie AI oraz czat
        odpowiadający na pytania na podstawie transkrypcji. Zapisanie filmu utrzymuje transkrypcję
        przy nim, więc <a href="/pl/blog/jak-szukac-zakladek-z-ai-2026">wyszukiwanie semantyczne</a>
        znajdzie „ten film, w którym tłumaczy fundusze indeksowe na przykładzie wiader” miesiące
        później. Zobacz też poradnik o wszystkich sposobach:
        <a href="/pl/blog/jak-pobrac-transkrypcje-z-youtube-2026">jak pobrać transkrypcję z YouTube</a>.
      </p>
    </Fragment>
  </ToolShell>
</LandingLayout>

<script>
  const form = document.getElementById('yt-form') as HTMLFormElement;
  const input = document.getElementById('yt-url') as HTMLInputElement;
  const status = document.getElementById('yt-status')!;
  const out = document.getElementById('yt-out')!;
  const actions = document.getElementById('yt-actions')!;
  const stamps = document.getElementById('yt-stamps') as HTMLInputElement;

  let segments: { start: number; text: string }[] = [];
  let videoTitle = 'transkrypcja';

  const fmt = (s: number) =>
    `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  const renderText = (withStamps: boolean) =>
    segments.map((s) => (withStamps ? `[${fmt(s.start)}] ${s.text}` : s.text)).join('\n');

  const render = () => {
    out.textContent = renderText(stamps.checked);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Ładowanie transkrypcji…';
    status.classList.remove('is-error');
    out.classList.add('hidden');
    actions.classList.add('hidden');
    try {
      const res = await fetch(`/api/youtube-transcript?v=${encodeURIComponent(input.value)}`);
      const data = await res.json() as {
        error?: string;
        title: string;
        auto?: boolean;
        segments: { start: number; text: string }[];
      };
      if (!res.ok) throw new Error(data.error ?? 'Wystąpił błąd.');
      segments = data.segments;
      videoTitle = data.title ?? 'transkrypcja';
      status.textContent = `${data.title}${data.auto ? ' (automatyczne napisy)' : ''} — ${segments.length} linii`;
      render();
      out.classList.remove('hidden');
      actions.classList.remove('hidden');
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : 'Wystąpił problem z pobraniem transkrypcji.';
      status.classList.add('is-error');
    }
  });

  stamps.addEventListener('change', render);

  document.getElementById('yt-copy')!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(renderText(stamps.checked));
    status.textContent = 'Skopiowano do schowka!';
  });

  document.getElementById('yt-download')!.addEventListener('click', () => {
    const blob = new Blob([renderText(stamps.checked)], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${videoTitle.replace(/[^\w\s-]/g, '').slice(0, 60) || 'transkrypcja'}.txt`;
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
