---
import { getCollection, render } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ComparisonTable from '../../components/seo/ComparisonTable.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import SourceNote from '../../components/seo/SourceNote.astro';
import { competitors, marqly, getCompetitor } from '../../lib/competitors';
import { marqlyPairFaqs, marqlyEdges, otherEdges, pricingSentence, switchSentence } from '../../lib/compare-content';
import { breadcrumbList, faqPage, organization, softwareApplication, webSite } from '../../lib/schema';
import { alternatesForPath } from '../../i18n/routes';

export async function getStaticPaths() {
  const verdictEntries = await getCollection('verdicts', ({ data }) => !data.draft);

  const marqlyPairs = competitors.map((c) => ({
    params: { pair: `marqly-vs-${c.slug}` },
    props: { bSlug: c.slug, verdictId: null as string | null },
  }));

  const thirdParty = verdictEntries
    .filter((v) => getCompetitor(v.data.a) && getCompetitor(v.data.b))
    .map((v) => ({
      params: { pair: v.id },
      props: { bSlug: null as string | null, verdictId: v.id },
    }));

  return [...marqlyPairs, ...thirdParty];
}

const { bSlug, verdictId } = Astro.props;
const verdictEntries = await getCollection('verdicts', ({ data }) => !data.draft);
const verdictEntry = verdictId ? verdictEntries.find((v) => v.id === verdictId) ?? null : null;

const isMarqlyPair = !verdictEntry;
const a = isMarqlyPair ? marqly : getCompetitor(verdictEntry!.data.a)!;
const b = isMarqlyPair ? getCompetitor(bSlug!)! : getCompetitor(verdictEntry!.data.b)!;

const VerdictContent = verdictEntry ? (await render(verdictEntry)).Content : null;

const pairSlug = isMarqlyPair ? `marqly-vs-${b.slug}` : verdictEntry!.id;
const path = `/compare/${pairSlug}`;
const h1 = `${a.name} vs ${b.name}: Which is better? (2026)`;
const title = `${a.name} vs ${b.name}: Which Is Better? (2026)`;
const description = isMarqlyPair
  ? `Detailed ${a.name} vs ${b.name} comparison: AI tagging, semantic search, highlights, YouTube AI, pricing, and imports — which fits your workflow in 2026.`
  : `${a.name} vs ${b.name} compared feature by feature — pricing, platforms, search, highlights — plus the AI-first option both sides overlook.`;

const faqs = isMarqlyPair ? marqlyPairFaqs(marqly, b) : verdictEntry!.data.faqs;

// Cross-link blocks
const otherMarqlyPairs = competitors.filter((c) => c.slug !== b.slug);
const pairsInvolving = (slug: string) =>
  verdictEntries
    .filter((v) => v.id !== pairSlug && (v.data.a === slug || v.data.b === slug))
    .map((v) => {
      const other = v.data.a === slug ? getCompetitor(v.data.b) : getCompetitor(v.data.a);
      return other ? { slug: v.id, name: other.name } : null;
    })
    .filter((x): x is NonNullable<typeof x> => Boolean(x));
const bRelated = pairsInvolving(b.slug);
const aRelated = isMarqlyPair ? [] : pairsInvolving(a.slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare' },
  { name: `${a.name} vs ${b.name}`, path },
];

const jsonLd = [
  organization(),
  webSite(),
  softwareApplication(),
  breadcrumbList(crumbs),
  ...(faqs.length ? [faqPage(faqs)] : []),
];

const aEdgesList = isMarqlyPair ? marqlyEdges(marqly, b, 4) : [];
const bEdgesList = isMarqlyPair ? otherEdges(marqly, b, 4) : [];
const tableTools = isMarqlyPair ? [marqly, b] : [a, b, marqly];
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={alternatesForPath(`/compare/${pairSlug}`)}
  ogImage={`https://www.marqly.com/og/seo/compare-${pairSlug}.png`}
>
  <article class="section">
    <div class="container cmp-page">
      <Breadcrumbs items={crumbs} />
      <h1>{h1}</h1>
      <SourceNote tools={tableTools} />

      <div class="verdict-box">
        <p class="verdict-label">The short answer</p>
        {isMarqlyPair ? (
          <>
            {b.status === 'shutdown' && (
              <p class="shutdown-note"><strong>Heads up:</strong> {b.shutdownNote}</p>
            )}
            <ul class="verdict-points">
              <li><strong>Choose Marqly</strong> — {marqly.bestFor} {aEdgesList.length > 0 && `It adds ${aEdgesList.join(', ')} that ${b.name} doesn't offer.`}</li>
              <li><strong>Choose {b.name}</strong> — {b.bestFor} {bEdgesList.length > 0 && `It offers ${bEdgesList.join(', ')}, which Marqly doesn't.`}</li>
            </ul>
          </>
        ) : (
          <p class="verdict-prose">{verdictEntry!.data.verdict}</p>
        )}
      </div>

      <h2>Feature comparison</h2>
      <ComparisonTable tools={tableTools} variant="full" caption={`${a.name} vs ${b.name}${isMarqlyPair ? '' : ' vs Marqly'} — feature by feature`} />

      <h2>Pricing</h2>
      <ul class="pricing-list">
        <li><strong>{a.name}:</strong> {pricingSentence(a)}</li>
        <li><strong>{b.name}:</strong> {pricingSentence(b)}</li>
        {!isMarqlyPair && <li><strong>Marqly:</strong> {pricingSentence(marqly)}</li>}
      </ul>

      {isMarqlyPair ? (
        <>
          <h2>About {b.name}</h2>
          <p class="prose-p">{b.overview}</p>
          <div class="two-col">
            <div>
              <h3>Where {b.name} wins</h3>
              <ul>{b.pros.map((p) => <li>{p}</li>)}</ul>
            </div>
            <div>
              <h3>Where {b.name} falls short</h3>
              <ul>{b.cons.map((c) => <li>{c}</li>)}</ul>
            </div>
          </div>

          <h2>About Marqly</h2>
          <p class="prose-p">{marqly.overview}</p>
          <div class="two-col">
            <div>
              <h3>Where Marqly wins</h3>
              <ul>{marqly.pros.map((p) => <li>{p}</li>)}</ul>
            </div>
            <div>
              <h3>Where Marqly falls short</h3>
              <ul>{marqly.cons.map((c) => <li>{c}</li>)}</ul>
            </div>
          </div>

          {!b.features.semanticSearch && (
            <div class="search-contrast">
              <h2>The core difference: Finding saves when you forgot the exact title</h2>
              <p class="prose-p">
                The most frequent pain point with traditional bookmark tools like {b.name} is search failure. When you save hundreds of links and later only remember the concept—not the exact title or tag—keyword matching comes up empty. Marqly indexes the actual meaning of your bookmarks, articles, highlights, and YouTube transcripts with semantic embeddings.
              </p>
              <div class="contrast-grid">
                <div class="contrast-card traditional">
                  <div class="contrast-head">
                    <span class="contrast-tag">{b.name}</span>
                    <h4>Keyword & Tag Matching</h4>
                  </div>
                  <p class="contrast-desc">Matches titles, tags, and exact strings. If you paraphrase or forget the exact wording, the save stays hidden.</p>
                  <div class="contrast-example">
                    <span class="query-label">Search Query:</span>
                    <code>"study about sleep cycles and focus"</code>
                    <div class="result-box fail">
                      <span class="res-icon">✕</span>
                      <span>0 results (Title was "Huberman Morning Protocols")</span>
                    </div>
                  </div>
                </div>
                <div class="contrast-card ai">
                  <div class="contrast-head">
                    <span class="contrast-tag pro">Marqly</span>
                    <h4>Semantic AI Search</h4>
                  </div>
                  <p class="contrast-desc">Understands natural-language concepts. Find any bookmark by describing what you remember, just like asking a human colleague.</p>
                  <div class="contrast-example">
                    <span class="query-label">Search Query:</span>
                    <code>"study about sleep cycles and focus"</code>
                    <div class="result-box success">
                      <span class="res-icon">✓</span>
                      <span>Found: Huberman Morning Protocols (matched by concept)</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <div class="switch-box">
            <h3>Switching from {b.name} to Marqly</h3>
            <p class="prose-p">{switchSentence(b)}</p>
            <div class="switch-steps">
              <div class="step-item">
                <span class="step-num">1</span>
                <span>Export your {b.name} bookmarks as HTML or CSV</span>
              </div>
              <div class="step-item">
                <span class="step-num">2</span>
                <span>Upload file in Marqly Settings → Import</span>
              </div>
              <div class="step-item">
                <span class="step-num">3</span>
                <span>AI auto-tags and indexes your library in minutes</span>
              </div>
            </div>
            <div class="migration-btns">
              <a class="btn btn--primary" href="https://app.marqly.com">Import your {b.name} bookmarks free →</a>
              {(b.slug === 'raindrop' || b.slug === 'pocket') && (
                <a class="migration-guide-link" href={`/migrate/${b.slug}`}>
                  Step-by-step {b.name} migration guide →
                </a>
              )}
            </div>
          </div>
        </>
      ) : (
        <>
          <h2>About {a.name}</h2>
          <p class="prose-p">{a.overview}</p>
          <h2>About {b.name}</h2>
          <p class="prose-p">{b.overview}</p>
          <h2>Which should you choose?</h2>
          <div class="prose">
            {VerdictContent && <VerdictContent />}
          </div>
          <div class="third-option">
            <h2>The option both sides overlook</h2>
            <p class="prose-p">
              If the real problem is finding things again, neither {a.name} nor {b.name} fully
              solves it. Marqly auto-tags and summarizes every save with AI and lets you retrieve
              any of them by describing what you remember — plus a highlighter, YouTube summaries
              with transcripts, and save-as-PDF. There's a free tier with no card required.
            </p>
          </div>
        </>
      )}

      {faqs.length > 0 && (
        <div class="faq-wrap">
          <FaqAccordion faqs={faqs} heading={`${a.name} vs ${b.name} FAQ`} />
        </div>
      )}

      <CtaBox />

      <nav class="xlinks" aria-label="More comparisons">
        <div>
          <h3>Compare Marqly with other tools</h3>
          <ul>
            {otherMarqlyPairs.map((c) => (
              <li><a href={`/compare/marqly-vs-${c.slug}`}>Marqly vs {c.name}</a></li>
            ))}
          </ul>
        </div>
        {(bRelated.length > 0 || aRelated.length > 0 || !isMarqlyPair) && (
          <div>
            <h3>More {b.name} comparisons</h3>
            <ul>
              {!isMarqlyPair && <li><a href={`/compare/marqly-vs-${b.slug}`}>Marqly vs {b.name}</a></li>}
              {bRelated.map((r) => (
                <li><a href={`/compare/${r.slug}`}>{r.slug.split('-vs-').join(' vs ').replace(/-/g, ' ')}</a></li>
              ))}
              {aRelated.length > 0 && <li><a href={`/compare/marqly-vs-${a.slug}`}>Marqly vs {a.name}</a></li>}
            </ul>
          </div>
        )}
        <div>
          <h3>Alternatives</h3>
          <ul>
            {!isMarqlyPair && <li><a href={`/alternatives/${a.slug}`}>Best {a.name} alternatives</a></li>}
            <li><a href={`/alternatives/${b.slug}`}>Best {b.name} alternatives</a></li>
            <li><a href="/alternatives">All alternatives →</a></li>
          </ul>
        </div>
      </nav>
    </div>
  </article>
</LandingLayout>

<style>
  .cmp-page { max-width: 900px; }
  h1 {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
    line-height: var(--lh-tight);
  }
  h2 {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--ink-1);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    letter-spacing: var(--tracking-tight);
  }
  h3 { font-size: var(--fs-base); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-3); }

  .verdict-box {
    margin-top: var(--space-6);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }
  .verdict-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin-bottom: var(--space-3);
  }
  .verdict-points { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .verdict-points li { padding-left: var(--space-5); position: relative; }
  .verdict-points li::before { content: '→'; position: absolute; left: 0; color: var(--ink-4); }
  .verdict-points li, .verdict-prose { font-size: var(--fs-base); line-height: var(--lh-base); color: var(--ink-2); }
  .verdict-points strong, .verdict-prose strong { color: var(--ink-1); }
  .shutdown-note {
    margin-bottom: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--ink-1);
    background: var(--surface-1);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-inner);
    padding: var(--space-3) var(--space-4);
  }

  .pricing-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .pricing-list li { font-size: var(--fs-base); color: var(--ink-2); line-height: var(--lh-base); }
  .pricing-list strong { color: var(--ink-1); }

  .prose-p, .prose :global(p) {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }
  .prose :global(h3) { font-size: var(--fs-lg); font-weight: 600; color: var(--ink-1); margin-top: var(--space-6); margin-bottom: var(--space-2); }
  .prose :global(ul) { padding-left: 1.4rem; margin-bottom: var(--space-4); color: var(--ink-2); line-height: var(--lh-base); }
  .prose :global(a) { color: var(--ink-1); font-weight: 500; text-decoration: underline; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }
  .two-col ul { list-style: disc; padding-left: 1.2rem; color: var(--ink-2); line-height: var(--lh-base); display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--fs-sm); }
  .two-col li::marker { color: var(--ink-4); }
  @media (max-width: 700px) { .two-col { grid-template-columns: 1fr; } }

  .third-option {
    margin-top: var(--space-8);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    background: var(--surface-1);
  }
  .third-option h2 { margin-top: 0; }

  .faq-wrap { margin-top: var(--space-12); }

  .xlinks {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-1);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  .xlinks ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .xlinks a { font-size: var(--fs-sm); color: var(--ink-3); }
  .xlinks a:hover { color: var(--ink-1); }
  @media (max-width: 800px) { .xlinks { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .xlinks { grid-template-columns: 1fr; } }

  /* Contrast grid */
  .search-contrast { margin-top: var(--space-10); }
  .contrast-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .contrast-card {
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .contrast-card.ai {
    background: var(--surface-2);
    border-color: var(--border-2);
  }
  .contrast-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .contrast-tag {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }
  .contrast-tag.pro { color: var(--accent); }
  .contrast-head h4 {
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--ink-1);
    margin: 0;
  }
  .contrast-desc {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: var(--lh-base);
    margin-bottom: var(--space-4);
  }
  .contrast-example {
    background: var(--surface-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-inner);
    padding: var(--space-4);
    margin-top: auto;
  }
  .query-label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--ink-3);
    margin-bottom: var(--space-1);
  }
  .contrast-example code {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-1);
    margin-bottom: var(--space-3);
  }
  .result-box {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-inner);
  }
  .result-box.fail {
    background: #fdf2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }
  .result-box.success {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .res-icon { font-weight: bold; }

  /* Switch box */
  .switch-box {
    margin-top: var(--space-10);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }
  .switch-box h3 {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--ink-1);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }
  .switch-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-5) 0 var(--space-6);
  }
  .step-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: var(--lh-snug);
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ink-1);
    color: var(--surface-1);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .btn--primary {
    display: inline-block;
    background: var(--ink-1);
    color: var(--surface-1);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .btn--primary:hover { opacity: 0.9; }
  .migration-btns { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-4); }
  .migration-guide-link { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-1); text-decoration: underline; }

  @media (max-width: 700px) {
    .contrast-grid { grid-template-columns: 1fr; }
    .switch-steps { grid-template-columns: 1fr; }
  }
</style>
