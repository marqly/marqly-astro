---
/**
 * Marqly Teams — the shared, AI-organised bookmark workspace.
 *
 * LAUNCHED 2026-09-25 (owner flipped TEAMS_PUBLIC=true after the product
 * flags went live). The flag still gates every surface: set it false and
 * this page builds for preview but goes noindex + unlinked (see data.ts).
 *
 * Copy is pinned to the product truth in the monorepo (docs/teams/*.md,
 * apps/api/src/lib/teams/config.ts) and the approved wording in
 * docs/superpowers/specs/2026-08-02-marqly-product-facts.md. Do NOT add:
 * file uploads / storage numbers, custom sharing domains, team access from
 * MCP or the AI assistant, Viewer/Guest roles, SSO/SCIM, per-board
 * permissions, mobile team access, extension save-to-team, non-USD pricing,
 * invoices/bank transfer, any trial.
 */
import LandingV2 from '../layouts/LandingV2.astro';
import Nav from '../components/landing/Nav.astro';
import FooterV2 from '../components/landing/FooterV2.astro';
import CloseSection from '../components/landing/CloseSection.astro';
import { CheckIcon, PlusIcon } from '../components/landing/icons';
import { APP_URL, TEAMS_PUBLIC, TEAMS_PRICE } from '../components/landing/data';

const title = 'Marqly Teams — Shared AI Bookmark Workspace for Your Team';
const description =
  'A shared, AI-organised bookmark workspace: team boards and saves everyone can search, while each member keeps their personal library. $9 per seat per month or $72 per seat per year, 3-seat minimum.';
const canonical = 'https://www.marqly.com/teams';

const P = TEAMS_PRICE;

const included = [
  {
    lead: 'All Pro features, included.',
    text: 'Every seat carries the full Pro feature set — AI auto-tagging and summaries, semantic search, Ask, ChatVault, everything else Pro does — alongside the shared workspace.',
  },
  {
    lead: 'One shared library.',
    text: 'A team workspace with shared boards and shared saves, separate from every member’s personal library. Everyone can save, organise, and search together.',
  },
  {
    lead: 'Personal stays personal.',
    text: 'Joining a team never touches anyone’s bookmarks, boards, or personal plan. Pro members can join or start a team and keep everything they have.',
  },
  {
    lead: 'A pooled AI allowance.',
    text: 'Each purchased seat adds 2× an individual Pro’s monthly AI allowance to one shared team pool. It resets monthly; unused credits don’t roll over.',
  },
  {
    lead: 'Invites and an activity log.',
    text: 'Invite members by email — a pending invitation holds a seat for 7 days. Owners and Admins see an activity log of what the team saved and changed.',
  },
  {
    lead: 'One bill, one Owner.',
    text: 'The Owner pays for the team; adding seats is prorated and charged immediately. Cancel any time — the workspace turns read-only, nothing is deleted.',
  },
];

const roles = [
  {
    name: 'Owner',
    note: 'Pays and holds the team.',
    can: ['Everything Admins can do', 'Billing: purchase, add/remove seats, cancel', 'Transfer ownership', 'Delete the team'],
  },
  {
    name: 'Admin',
    note: 'Runs the workspace.',
    can: ['Everything Members can do', 'Manage members and invitations', 'Publish shared boards', 'Edit team settings'],
  },
  {
    name: 'Member',
    note: 'Works the library.',
    can: ['Save, edit, and organise shared bookmarks', 'Search the team workspace', 'Invite others only if the team allows it'],
  },
];

const billing = [
  {
    lead: 'Seats are the unit.',
    text: `You pay for purchased seats, including any you’re not using yet. Minimum ${P.minSeats} seats — a team starts at ${P.fromMonthly} per month.`,
  },
  {
    lead: 'Add seats anytime.',
    text: 'A new seat is prorated to the end of your period and charged immediately.',
  },
  {
    lead: 'Remove at renewal.',
    text: 'Seat removals take effect at the next renewal; the period you’ve paid for is not refunded.',
  },
  {
    lead: 'One bill, paid by the Owner.',
    text: 'No trial — Teams is billed the moment the Owner upgrades.',
  },
  {
    lead: 'Cancel keeps everything.',
    text: 'The team works to the end of the paid period, then turns read-only. Nothing is deleted — resume or restart later with the same members and content.',
  },
];

const faqs = [
  {
    q: 'Is there a free trial for Teams?',
    a: 'No. Marqly sells no trials — Teams is billed when the Owner upgrades. The personal free plan (no card, no time limit, up to 100 bookmarks) is the way to evaluate Marqly before paying for anything.',
  },
  {
    q: 'What does Teams cost?',
    a: `${P.perSeatMonthly} per seat per month or ${P.perSeatYearly} per seat per year (about ${P.perSeatMonthlyWhenYearly} per seat/month billed annually), USD, with a ${P.minSeats}-seat minimum — so from ${P.fromMonthly}/month or ${P.fromYearly}/year. The Owner pays one bill for the team.`,
  },
  {
    q: 'Do members lose their personal library when they join?',
    a: 'No. The team workspace is separate from every member’s personal library, and personal plans (Free, Pro, Lifetime, app-store subscriptions) are unchanged by joining. You can switch between personal and team views in the web app.',
  },
  {
    q: 'Can a Pro user start or join a team?',
    a: 'Yes, either. Pro members can start a team or accept an invitation; their personal Pro features keep working alongside the team workspace.',
  },
  {
    q: 'What happens when we add or remove seats?',
    a: 'Adding a seat is prorated and charged immediately. Removing a seat takes effect at the next renewal — you keep paying for purchased seats through the period you’ve paid for, and removals are not refunded mid-term.',
  },
  {
    q: 'What happens if the team cancels?',
    a: 'The team keeps working until the end of the paid period, then turns read-only. Nothing is deleted: you can resume the subscription, or restart the team later with the same members and content.',
  },
  {
    q: 'Does Teams work in the mobile apps?',
    a: 'Teams is web-only today — members use it at app.marqly.com. The iOS and Android apps are for personal libraries.',
  },
  {
    q: 'How do invitations work?',
    a: 'The Owner or an Admin invites by email. Until the invite is accepted it holds one of your purchased seats for 7 days, after which it expires; revoking it releases the seat.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Marqly Teams',
    description:
      'A shared, AI-organised bookmark workspace for teams: shared boards and saves, a pooled AI allowance, role-based management, and one Owner-paid bill. 3-seat minimum.',
    brand: { '@type': 'Brand', name: 'Marqly', url: 'https://www.marqly.com' },
    url: canonical,
    offers: [
      {
        '@type': 'Offer',
        price: '9',
        priceCurrency: 'USD',
        unitText: 'per seat per month',
        availability: 'https://schema.org/PreOrder',
      },
      {
        '@type': 'Offer',
        price: '72',
        priceCurrency: 'USD',
        unitText: 'per seat per year',
        availability: 'https://schema.org/PreOrder',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<LandingV2
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={TEAMS_PUBLIC ? jsonLd : []}
  noindex={!TEAMS_PUBLIC}
>
  <Nav slot="nav" />

  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-[1120px] px-5 pt-16 pb-14 md:px-8 md:pt-20">
      <div class="mx-auto max-w-[720px] text-center">
        <p class="text-[11px] font-semibold tracking-[0.16em] text-foreground/70 uppercase">For teams</p>
        <h1
          class="font-display mt-4 text-[clamp(2.4rem,5.5vw,3.9rem)] leading-[1.06] font-medium tracking-[-0.015em] text-foreground"
        >
          The links your team<br />
          <em class="mark-stroke">keeps losing.</em>
        </h1>
        <p class="mx-auto mt-6 max-w-[560px] text-[17px] leading-relaxed text-[#4b4b53]">
          Marqly Teams is one shared, AI-organised bookmark workspace: everyone saves to it, everyone
          searches it, and the AI tags and files as you go — while each member keeps their own personal
          library untouched.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={APP_URL}
            data-cta="teams_hero"
            class="flex h-11 items-center rounded-3xl bg-accent px-6 text-[15px] font-medium text-accent-foreground shadow-custom transition-transform active:scale-[0.97]"
          >
            Start a team
          </a>
          <a
            href="/pricing"
            class="flex h-11 items-center gap-1.5 rounded-3xl bg-white px-5 text-[15px] font-medium text-foreground shadow-surface transition-colors hover:bg-white/80"
          >
            Personal plans
          </a>
        </div>
        <p class="mt-5 text-[13px] text-muted">
          {P.minSeats}-seat minimum · from {P.fromMonthly}/month · no trial — billed when the Owner upgrades
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <h2 class="font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-medium tracking-[-0.01em] text-foreground">
        What’s in the workspace
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {
          included.map((f) => (
            <div class="rounded-3xl bg-surface p-6 shadow-surface">
              <h3 class="text-[15px] font-semibold text-foreground">{f.lead}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <h2 class="font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-medium tracking-[-0.01em] text-foreground">
        Three roles, one bill
      </h2>
      <p class="mt-3 max-w-[560px] text-[15px] leading-relaxed text-muted">
        Every role occupies a seat. Billing is the Owner’s; the rest of the team just works.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          roles.map((r) => (
            <div class="flex flex-col rounded-3xl bg-surface p-6 shadow-surface">
              <h3 class="text-sm font-semibold tracking-wide text-foreground uppercase">{r.name}</h3>
              <p class="mt-1 text-[13px] text-muted">{r.note}</p>
              <ul class="mt-4 flex flex-col gap-2">
                {r.can.map((c) => (
                  <li class="flex items-start gap-3 text-sm leading-snug text-foreground/85">
                    <span
                      class="mt-px flex size-5 shrink-0 items-center justify-center rounded-full"
                      style={{
                        background: 'color-mix(in oklab, var(--success-solid) 13%, transparent)',
                        color: 'var(--success-solid)',
                      }}
                    >
                      <CheckIcon size={11} />
                    </span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="tp-card relative overflow-hidden rounded-3xl border border-separator p-8 md:p-12" data-reveal>
        {/* Subtle creative backdrop: soft brand-tinted glows over a fine dot grid. */}
        <div aria-hidden class="tp-bg pointer-events-none absolute inset-0"></div>
        <div class="relative grid gap-10 md:gap-14 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]">
          {/* Price side: the two billing choices are selectable, like the personal plans. */}
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">Teams pricing</p>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">
              Priced per seat, billed to one Owner. USD.
            </p>
            <div class="mt-7 grid grid-cols-2 gap-3" role="group" aria-label="Billing period">
              <button type="button" data-teams-btn="monthly" aria-pressed="false" class="tp-btn rounded-2xl p-5 text-left">
                <p class="tp-label text-[10px] font-semibold tracking-[0.14em] uppercase">Monthly</p>
                <p class="font-display tp-price mt-2.5 text-[32px] leading-none font-medium">
                  {P.perSeatMonthly}<span class="tp-per text-[13px] font-normal"> /seat</span>
                </p>
              </button>
              <button type="button" data-teams-btn="annual" aria-pressed="true" class="tp-btn is-on rounded-2xl p-5 text-left">
                <p class="tp-label text-[10px] font-semibold tracking-[0.14em] uppercase">Annual</p>
                <p class="font-display tp-price mt-2.5 text-[32px] leading-none font-medium">
                  {P.perSeatYearly}<span class="tp-per text-[13px] font-normal"> /seat/yr</span>
                </p>
                <p class="tp-sub mt-2 text-[11px] font-medium">
                  ≈ {P.perSeatMonthlyWhenYearly}/seat/month, billed yearly
                </p>
              </button>
            </div>
            <p class="mt-3 flex items-center gap-2.5 rounded-2xl bg-default/70 px-4 py-3 text-[13px] font-medium text-foreground/80">
              <span aria-hidden class="size-1.5 shrink-0 rounded-full bg-pro"></span>
              <span data-teams-note>{
                `Minimum ${P.minSeats} seats — ${P.fromYearly}/year (≈${P.perSeatMonthlyWhenYearly}/seat/month)`
              }</span>
            </p>
            <a
              href={APP_URL}
              data-cta="teams_pricing"
              class="mt-6 flex h-12 w-full items-center justify-center rounded-3xl bg-accent text-[15px] font-medium text-accent-foreground shadow-custom transition-transform active:scale-[0.98]"
            >
              Start a team
            </a>
            <p class="mt-3 text-center text-[12px] text-muted">
              No trial — Teams is billed when the Owner upgrades. Cancel any time.
            </p>
          </div>

          {/* Rules side: a definition list on hairlines. */}
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">How billing works</p>
            <dl class="mt-5 divide-y divide-separator">
              {
                billing.map((b) => (
                  <div class="grid gap-1 py-4 first:pt-0 first:pb-4 last:pb-0">
                    <dt class="text-[14px] font-semibold text-foreground">{b.lead}</dt>
                    <dd class="text-[13px] leading-relaxed text-muted">{b.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-[1120px] px-5 md:px-8">
      <div class="max-w-[600px]" data-reveal>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-muted uppercase">FAQ</p>
        <h2
          class="font-display mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-medium tracking-[-0.01em] text-foreground"
        >
          Questions teams ask<br />
          before paying.
        </h2>
      </div>

      {/* Same accordion as the homepage: faq-item + PlusIcon, expanded
          smoothly by the ::details-content rule in landing.css. */}
      {
        (() => {
          const mid = Math.ceil(faqs.length / 2);
          const columns = [faqs.slice(0, mid), faqs.slice(mid)];
          return (
            <div class="mt-10 grid grid-cols-1 gap-x-12 md:grid-cols-2">
              {columns.map((col) => (
                <div>
                  {col.map((f) => (
                    <details class="faq-item group border-b border-separator">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-medium text-foreground [&::-webkit-details-marker]:hidden">
                        {f.q}
                        <span class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45">
                          <PlusIcon size={15} />
                        </span>
                      </summary>
                      <div class="pb-5 text-sm leading-relaxed text-muted">{f.a}</div>
                    </details>
                  ))}
                </div>
              ))}
            </div>
          );
        })()
      }
    </div>
  </section>

  <CloseSection />
  <FooterV2 slot="footer" />
</LandingV2>

<script define:vars={{ TP: TEAMS_PRICE }}>
  // Teams billing-period toggle — same vanilla, no-hydration pattern as the
  // personal-plan section. The selected panel inverts to ink; the minimum-seats
  // note restates the price in the chosen period.
  const btns = [...document.querySelectorAll('[data-teams-btn]')];
  const note = document.querySelector('[data-teams-note]');
  const NOTES = {
    monthly: `Minimum ${TP.minSeats} seats — from ${TP.fromMonthly}/month`,
    annual: `Minimum ${TP.minSeats} seats — ${TP.fromYearly}/year (≈${TP.perSeatMonthlyWhenYearly}/seat/month)`,
  };
  function pick(k) {
    btns.forEach((b) => {
      const on = b.dataset.teamsBtn === k;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('is-on', on);
    });
    if (note) note.textContent = NOTES[k];
  }
  btns.forEach((b) => b.addEventListener('click', () => pick(b.dataset.teamsBtn)));
</script>

<style>
  .tp-card {
    background: var(--surface);
  }
  .tp-bg {
    background:
      radial-gradient(64% 52% at 88% 0%, color-mix(in oklab, var(--pro) 10%, transparent), transparent 68%),
      radial-gradient(52% 44% at 2% 100%, color-mix(in oklab, var(--success-solid) 9%, transparent), transparent 70%),
      radial-gradient(rgba(38, 38, 44, 0.05) 1px, transparent 1.3px);
    background-size:
      auto,
      auto,
      22px 22px;
  }
  .tp-btn {
    background: color-mix(in oklab, var(--foreground) 5%, transparent);
    color: var(--foreground);
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background 0.2s var(--ease-smooth, ease),
      color 0.2s,
      box-shadow 0.2s;
  }
  .tp-label,
  .tp-per,
  .tp-sub {
    color: var(--muted);
  }
  .tp-btn:hover {
    background: color-mix(in oklab, var(--foreground) 9%, transparent);
  }
  .tp-btn.is-on {
    background: var(--foreground);
    color: #fff;
    box-shadow: 0 12px 28px color-mix(in oklab, var(--foreground) 22%, transparent);
  }
  .tp-btn.is-on .tp-label {
    color: rgba(255, 255, 255, 0.55);
  }
  .tp-btn.is-on .tp-per {
    color: rgba(255, 255, 255, 0.65);
  }
  .tp-btn.is-on .tp-sub {
    color: rgba(255, 255, 255, 0.78);
  }
</style>
