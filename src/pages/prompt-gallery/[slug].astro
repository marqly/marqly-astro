---
import { getCollection, render } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import { breadcrumbList, faqPage, organization, webSite } from '../../lib/schema';
import { aiToolsBySlug } from '../../lib/ai-tools';

export async function getStaticPaths() {
  const entries = await getCollection('prompts', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const path = `/prompt-gallery/${entry.id}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Prompt Gallery', path: '/prompt-gallery' },
  { name: data.title, path },
];

const related = all
  .filter((e) => e.id !== entry.id && e.data.category === data.category)
  .slice(0, 6);

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList(crumbs),
  ...(data.faqs.length ? [faqPage(data.faqs)] : []),
];

const title = `${data.title} | Marqly Prompt Gallery`;
const ogImage = data.ogImage ?? `https://www.marqly.com/og/seo/prompt-${entry.id}.png`;

const toolLinks = data.tools
  .map((slug) => aiToolsBySlug[slug])
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

function catSlug(text: string) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
const categoryPath = `/prompt-gallery/category/${catSlug(data.category)}`;

---

<LandingLayout title={title} description={data.description} jsonLd={jsonLd} ogImage={ogImage} ogType="article">
  <article class="section prompt-page">
    <div class="container">
      <Breadcrumbs items={crumbs} />

      <header class="prompt-head" data-reveal>
        <div class="prompt-meta">
          <a class="cat-badge" href={categoryPath}>{data.category}</a>
          {data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
        <h1>{data.title}</h1>
        <p class="lead">{data.description}</p>

        {toolLinks.length > 0 && (
          <div class="tool-row">
            <span class="tool-label">Works with:</span>
            {toolLinks.map((t) => (
              <a class="tool-chip" href={t.url} target="_blank" rel="noopener noreferrer">
                {t.name}
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="prompt-layout" data-reveal>
        <div class="prompt-body">
          <div class="prompt-card">
            <div class="prompt-toolbar">
              <span class="toolbar-label">Full prompt</span>
              <div class="toolbar-actions">
                <button type="button" class="save-marqly-btn" data-save-btn title="Copy prompt and save in Marqly">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                  <span class="save-label">Save to Marqly</span>
                </button>
                <button type="button" class="copy-btn" data-copy-btn>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span class="copy-label">Copy</span>
                </button>
              </div>
            </div>
            <pre data-copy-target>{data.prompt}</pre>
            <div class="prompt-callout">
              <span class="callout-icon">💡</span>
              <div class="callout-text">
                <strong>Organize your AI prompt library with Marqly</strong>
                <p>
                  Never lose high-performing prompts in chat history. Clip prompts directly from ChatGPT, Claude, and Gemini with the
                  <a href="/extension">Marqly extension</a>, tag them by project, and find them with
                  <a href="/faq/what-is-semantic-search">semantic search</a>.
                </p>
              </div>
            </div>
          </div>

          <div class="prose">
            <Content />
          </div>

          {related.length > 0 && (
            <nav class="related" aria-labelledby="related-heading">
              <h2 id="related-heading">More {data.category.toLowerCase()} prompts</h2>
              <ul class="related-grid">
                {related.map((r) => (
                  <li>
                    <a href={`/prompt-gallery/${r.id}`} class="card">
                      <span class="related-cat">{r.data.category}</span>
                      <h3>{r.data.title}</h3>
                      <p>{r.data.description}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </div>

        <aside class="prompt-sidebar">
          <div class="sidebar-card">
            <div class="sidebar-badge">⚡ AI Prompt Organizer</div>
            <h3>Save & Run Prompts in Marqly</h3>
            <p>
              Stop losing your best prompts in endless chat threads. Save custom prompts to your personal Marqly library, tag them by workflow, and clip new ones directly from ChatGPT, Claude, and Gemini with one click.
            </p>
            <ul class="sidebar-benefits">
              <li>✓ One-click prompt clipping</li>
              <li>✓ Semantic search across your library</li>
              <li>✓ Sync across Chrome, Edge, Firefox, & Safari</li>
              <li>✓ Free up to 2,000 saves</li>
            </ul>
            <a href="/extension" class="btn btn--primary btn--sm sidebar-btn">
              Get Extension Free <span class="arrow">→</span>
            </a>
            <a href="https://app.marqly.com" target="_blank" rel="noopener" class="sidebar-sublink">
              Or open web app (no card required) ↗
            </a>
          </div>

          <div class="sidebar-card sidebar-card--secondary">
            <h4>Curated by Marqly</h4>
            <p>
              Looking for more AI workflows? Explore our free tools or learn how to search your entire knowledge base by meaning.
            </p>
            <div class="sidebar-links">
              <a href="/tools/youtube-transcript">YouTube Transcript Viewer →</a>
              <a href="/tools/youtube-summarize">YouTube Summarizer →</a>
              <a href="/embed">Embed Curated Boards →</a>
              <a href="/blog/how-to-search-bookmarks-with-ai">AI Semantic Search Guide →</a>
            </div>
          </div>
        </aside>
      </div>

      {data.faqs.length > 0 && (
        <div data-reveal>
          <FaqAccordion faqs={data.faqs} heading="Frequently asked questions" />
        </div>
      )}

      <CtaBox />
    </div>
  </article>

  <script is:inline>
    (function () {
      const copyBtn = document.querySelector('[data-copy-btn]');
      const saveBtn = document.querySelector('[data-save-btn]');
      const pre = document.querySelector('[data-copy-target]');

      if (copyBtn && pre) {
        copyBtn.addEventListener('click', async () => {
          const text = pre.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            const label = copyBtn.querySelector('.copy-label');
            const original = label ? label.textContent : 'Copy';
            copyBtn.classList.add('is-copied');
            if (label) label.textContent = 'Copied!';
            setTimeout(() => {
              copyBtn.classList.remove('is-copied');
              if (label) label.textContent = original;
            }, 1800);
          } catch (err) {
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(pre);
            selection.removeAllRanges();
            selection.addRange(range);
          }
        });
      }

      if (saveBtn && pre) {
        saveBtn.addEventListener('click', async () => {
          const text = pre.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            const label = saveBtn.querySelector('.save-label');
            const original = label ? label.textContent : 'Save to Marqly';
            saveBtn.classList.add('is-saved');
            if (label) label.textContent = 'Copied! Opening Marqly…';
            setTimeout(() => {
              window.open('https://app.marqly.com', '_blank');
              if (label) label.textContent = original;
              saveBtn.classList.remove('is-saved');
            }, 600);
          } catch (err) {
            window.open('https://app.marqly.com', '_blank');
          }
        });
      }
    })();
  </script>

  <style>
    .prompt-page { padding-block: var(--section-pad-y); }
    .prompt-head { max-width: 760px; margin-bottom: var(--space-10); }
    .prompt-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }
    .cat-badge {
      display: inline-block;
      font-size: var(--fs-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.35rem 0.7rem;
      border-radius: var(--radius-pill);
      text-decoration: none;
      transition: background var(--dur-fast) var(--ease-out);
    }
    .cat-badge:hover { background: var(--accent-ring); }
    .tag {
      font-size: var(--fs-xs);
      color: var(--ink-3);
    }
    .prompt-head h1 {
      font-size: var(--fs-h1);
      font-weight: 600;
      letter-spacing: var(--tracking-tight);
      color: var(--ink-1);
      line-height: var(--lh-tight);
    }
    .lead {
      margin-top: var(--space-4);
      font-size: var(--fs-lg);
      color: var(--ink-2);
      line-height: var(--lh-base);
    }
    .tool-row {
      margin-top: var(--space-5);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
    }
    .tool-label {
      font-size: var(--fs-sm);
      color: var(--ink-3);
      margin-right: var(--space-1);
    }
    .tool-chip {
      font-size: var(--fs-xs);
      font-weight: 500;
      color: var(--ink-2);
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-pill);
      transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    }
    .tool-chip:hover { background: var(--surface-3); border-color: var(--border-2); }

    .prompt-layout {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: var(--space-10);
      align-items: start;
    }
    .prompt-body { min-width: 0; }
    .prompt-card {
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      margin-bottom: var(--space-10);
    }
    .prompt-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-3);
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .toolbar-label {
      font-size: var(--fs-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .toolbar-actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    .save-marqly-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--fs-xs);
      font-weight: 600;
      color: var(--surface-1);
      background: var(--ink-1);
      border: 1px solid var(--ink-1);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: opacity var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    }
    .save-marqly-btn:hover { opacity: 0.9; }
    .save-marqly-btn.is-saved { background: #10b981; border-color: #10b981; }
    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--fs-xs);
      font-weight: 600;
      color: var(--ink-1);
      background: var(--surface-1);
      border: 1px solid var(--border-1);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    }
    .copy-btn:hover { background: var(--surface-3); border-color: var(--border-2); }
    .copy-btn.is-copied { color: var(--success); border-color: var(--success); }
    .prompt-card pre {
      margin: 0;
      padding: var(--space-5);
      background: var(--surface-dark);
      color: #fff;
      border-radius: var(--radius-card);
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      line-height: var(--lh-base);
      white-space: pre-wrap;
      overflow-x: auto;
    }
    .prompt-callout {
      margin-top: var(--space-4);
      padding: var(--space-4);
      background: var(--surface-1);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-sm);
      display: flex;
      gap: var(--space-3);
      align-items: flex-start;
    }
    .callout-icon { font-size: 1.2rem; line-height: 1; }
    .callout-text strong { display: block; font-size: var(--fs-xs); font-weight: 600; color: var(--ink-1); margin-bottom: 2px; }
    .callout-text p { font-size: var(--fs-xs); color: var(--ink-2); margin: 0; line-height: 1.4; }
    .callout-text a { color: var(--ink-1); text-decoration: underline; font-weight: 500; }

    .prompt-sidebar {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      position: sticky;
      top: calc(var(--nav-height) + var(--space-6));
    }
    .sidebar-card {
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
    }
    .sidebar-card--secondary {
      background: var(--surface-1);
    }
    .sidebar-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      background: var(--surface-1);
      color: var(--ink-2);
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      border: 1px solid var(--border-1);
      margin-bottom: var(--space-3);
    }
    .sidebar-card h3 {
      font-size: var(--fs-base);
      font-weight: 600;
      color: var(--ink-1);
      margin: 0 0 var(--space-2) 0;
    }
    .sidebar-card h4 {
      font-size: var(--fs-sm);
      font-weight: 600;
      color: var(--ink-1);
      margin: 0 0 var(--space-2) 0;
    }
    .sidebar-card p {
      font-size: var(--fs-xs);
      color: var(--ink-2);
      line-height: 1.5;
      margin: 0 0 var(--space-4) 0;
    }
    .sidebar-benefits {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-5) 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .sidebar-benefits li {
      font-size: var(--fs-xs);
      color: var(--ink-2);
      font-weight: 500;
    }
    .sidebar-btn {
      width: 100%;
      text-align: center;
      justify-content: center;
      display: inline-flex;
      text-decoration: none;
    }
    .sidebar-sublink {
      display: block;
      margin-top: var(--space-3);
      text-align: center;
      font-size: var(--fs-xs);
      color: var(--ink-3);
      text-decoration: underline;
    }
    .sidebar-sublink:hover { color: var(--ink-1); }
    .sidebar-links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .sidebar-links a {
      font-size: var(--fs-xs);
      color: var(--ink-2);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-out);
    }
    .sidebar-links a:hover {
      color: var(--ink-1);
      text-decoration: underline;
    }

    .prose { margin-bottom: var(--space-10); }
    .prose :global(h2) {
      font-size: var(--fs-h3);
      font-weight: 600;
      color: var(--ink-1);
      margin-bottom: var(--space-3);
      letter-spacing: var(--tracking-tight);
    }
    .prose :global(p), .prose :global(li) {
      font-size: var(--fs-base);
      line-height: var(--lh-base);
      color: var(--ink-2);
    }
    .prose :global(ol), .prose :global(ul) {
      padding-left: 1.4rem;
      margin-bottom: var(--space-4);
    }
    .prose :global(li) { margin-bottom: var(--space-2); }

    .related { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--border-1); margin-bottom: var(--space-10); }
    .faq-block { margin-top: var(--space-14); }
    .related h2 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-6); }
    .related-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
    .related-grid .card { height: 100%; }
    .related-grid h3 { font-size: var(--fs-base); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-2); }
    .related-grid p { font-size: var(--fs-sm); color: var(--ink-3); line-height: var(--lh-base); }
    .related-cat {
      display: inline-block;
      font-size: var(--fs-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      margin-bottom: var(--space-2);
    }

    @media (max-width: 980px) {
      .prompt-layout { grid-template-columns: 1fr; }
    }
    @media (max-width: 620px) {
      .related-grid { grid-template-columns: 1fr; }
    }
  </style>
</LandingLayout>
