---
import { getCollection } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import FaqAccordion from '../../components/seo/FaqAccordion.astro';
import { breadcrumbList, faqPage, itemList, organization, webSite } from '../../lib/schema';
import { aiToolsBySlug } from '../../lib/ai-tools';

const entries = await getCollection('prompts', ({ data }) => !data.draft);
// Hub is navigation, not the whole library: 48 featured cards + category hubs.
// (Rendering all ~400 made this the heaviest page on the site for no SEO gain.)
const featured = entries.slice(0, 48);

const CATEGORY_ORDER = [
  'Image & Photo',
  'Writing & Content',
  'SEO & Marketing',
  'Research & Learning',
  'Work & Productivity',
  'Coding & Development',
  'Social Media',
  'Personal & Creative',
  'Analysis & Data',
  'Prompt Engineering',
];

const categories = CATEGORY_ORDER.filter((cat) => entries.some((e) => e.data.category === cat));
const counts: Record<string, number> = {};
for (const e of entries) counts[e.data.category] = (counts[e.data.category] || 0) + 1;
function catSlug(text: string) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
const title = 'AI Prompt Gallery — Copy-Paste Prompts for ChatGPT, Gemini, Midjourney & More';
const description =
  `Browse ${entries.length} copy-pasteable AI prompts organized by category: image generation, writing, SEO, coding, productivity, social media, and prompt engineering. Every prompt page shows the full text, the tools it fits, and how to adapt it.`;

const faqs = [
  {
    q: 'What is a prompt gallery?',
    a: 'A prompt gallery is a curated collection of ready-to-use AI prompts. You can copy any prompt, paste it into ChatGPT, Gemini, Midjourney, or another AI tool, and customize the placeholders.',
  },
  {
    q: 'Can I use these prompts for commercial work?',
    a: 'Yes. The prompts themselves are general frameworks. Always check the output and your AI tool\'s terms of service before using generated content commercially.',
  },
  {
    q: 'Which AI tools are covered?',
    a: 'We link to ChatGPT, Claude, Gemini, Perplexity, Microsoft Copilot, Midjourney, DALL-E, Stable Diffusion, Ideogram, Leonardo.Ai, Bing Image Creator, Canva, and Adobe Firefly.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList([{ name: 'Home', path: '/' }, { name: 'Prompt Gallery', path: '/prompt-gallery' }]),
  itemList(
    featured.map((e) => e.data.title),
    '/prompt-gallery',
    featured.map((e) => `/prompt-gallery/${e.id}`),
  ),
  faqPage(faqs),
];

const ogImage = 'https://www.marqly.com/og/seo/hub-prompt-gallery.png';

function toolNames(slugs: string[]) {
  return slugs
    .map((s) => aiToolsBySlug[s]?.name)
    .filter((n): n is string => Boolean(n));
}

function preview(text: string) {
  return text.slice(0, 110).trim() + '…';
}
---

<LandingLayout title={title} description={description} jsonLd={jsonLd} ogImage={ogImage}>
  <section class="section prompt-hub">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Prompt Gallery', path: '/prompt-gallery' }]} />

      <header class="hub-head" data-reveal>
        <h1>AI Prompt Gallery</h1>
        <p class="lead">
          {entries.length}+ copy-pasteable prompts for ChatGPT, Claude, Gemini, DeepSeek, Kimi, Midjourney,
          DALL-E, and more. Browse by category below, or open any prompt for its full text and usage steps.
        </p>
        <div class="prompt-hub-banner">
          <div class="banner-badge">⚡ AI Prompt Organizer</div>
          <div class="banner-body">
            <strong>Save, organize, and run your prompts with Marqly</strong>
            <p>
              Clip prompts from ChatGPT, Claude, and Gemini using the <a href="/extension">browser extension</a>. Save them to custom boards, tag by project, and search your entire prompt library by meaning.
            </p>
          </div>
          <div class="banner-cta">
            <a href="https://app.marqly.com" target="_blank" rel="noopener" class="btn btn--primary btn--sm">
              Open Marqly Free <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </header>

      <nav class="category-grid" aria-labelledby="cat-heading" data-reveal>
        <h2 id="cat-heading" class="sr-only">Browse by category</h2>
        {categories.map((cat) => (
          <a href={`/prompt-gallery/category/${catSlug(cat)}`} class="category-card card">
            <div>
              <span class="category-name">{cat}</span>
              <span class="category-count">{counts[cat]} prompts</span>
            </div>
          </a>
        ))}
      </nav>
      <p style="margin: var(--space-4) 0 0; font-size: var(--fs-sm);">
        <a href="/prompt-gallery/category" style="font-weight: 500; text-decoration: underline; text-underline-offset: 3px; color: inherit;">Browse all prompt categories →</a>
      </p>

      <h2 style="margin: var(--space-8) 0 var(--space-5); font-size: var(--fs-xl); color: var(--ink-1);" data-reveal>Recently added</h2>
      <div class="prompt-grid" data-reveal>
        {featured.map((entry) => {
          const data = entry.data;
          return (
            <a
              href={`/prompt-gallery/${entry.id}`}
              class="prompt-card card"
            >
              <div class="card-body">
                <span class="card-cat">{data.category}</span>
                <h3>{data.title}</h3>
                <p>{data.description}</p>
                <span class="card-preview">{preview(data.prompt)}</span>
                <div class="card-tools">
                  {toolNames(data.tools).slice(0, 4).map((name) => (
                    <span class="tool-pill">{name}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <p style="margin: var(--space-6) 0 0; font-size: var(--fs-sm);" data-reveal>
        <a href="/prompt-gallery/category" style="font-weight: 500; text-decoration: underline; text-underline-offset: 3px; color: inherit;">Browse all {entries.length} prompts by category →</a>
      </p>

      <div data-reveal>
        <FaqAccordion faqs={faqs} heading="Frequently asked questions" />
      </div>

      <CtaBox />
    </div>
  </section>

  <style>
    .prompt-hub { padding-block: var(--section-pad-y); }
    .hub-head { max-width: 720px; margin-bottom: var(--space-10); }
    .hub-head h1 {
      font-size: var(--fs-display);
      font-weight: 600;
      letter-spacing: var(--tracking-tight);
      color: var(--ink-1);
      line-height: var(--lh-display);
    }
    .lead {
      margin-top: var(--space-4);
      font-size: var(--fs-lg);
      color: var(--ink-2);
      line-height: var(--lh-base);
    }

    .prompt-hub-banner {
      margin-top: var(--space-6);
      padding: var(--space-5) var(--space-6);
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-lg);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
    }
    .banner-badge {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      background: var(--surface-1);
      color: var(--ink-2);
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
      border: 1px solid var(--border-1);
      flex-shrink: 0;
    }
    .banner-body { flex: 1; min-width: 260px; }
    .banner-body strong { display: block; font-size: var(--fs-base); font-weight: 600; color: var(--ink-1); margin-bottom: 2px; }
    .banner-body p { font-size: var(--fs-sm); color: var(--ink-2); margin: 0; line-height: 1.4; }
    .banner-body a { color: var(--ink-1); text-decoration: underline; }
    .banner-cta { flex-shrink: 0; }

    .filter-bar {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-bottom: var(--space-10);
      position: sticky;
      top: var(--header-h);
      z-index: 10;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px);
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--border-1);
    }
    .search-wrap {
      position: relative;
    }
    .search-icon {
      position: absolute;
      left: var(--space-4);
      top: 50%;
      transform: translateY(-50%);
      color: var(--ink-4);
      pointer-events: none;
    }
    .search-input {
      width: 100%;
      padding: 0.85rem 1rem 0.85rem 2.75rem;
      font-size: var(--fs-base);
      color: var(--ink-1);
      background: var(--surface-1);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-pill);
      outline: none;
      transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
    }
    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-ring);
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .chip {
      font-size: var(--fs-xs);
      font-weight: 600;
      color: var(--ink-2);
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
    }
    .chip:hover { background: var(--surface-3); border-color: var(--border-2); }
    .chip.is-active {
      color: #fff;
      background: var(--ink-1);
      border-color: var(--ink-1);
    }

    .prompt-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      margin-bottom: var(--space-12);
    }
    .prompt-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      background: var(--surface-1);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-card);
      overflow: hidden;
      transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    }
    .prompt-card:hover { border-color: var(--border-2); transform: translateY(-2px); }
    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--space-3);
      margin-bottom: var(--space-10);
    }
    .category-card {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--surface-1);
      border: 1px solid var(--border-1);
      border-radius: var(--radius-card);
      text-decoration: none;
      transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    }
    .category-card:hover { border-color: var(--border-2); transform: translateY(-1px); }
    .category-card div { display: flex; flex-direction: column; }
    .category-name { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-1); }
    .category-count { font-size: var(--fs-xs); color: var(--ink-3); }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    .card-body {
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-cat {
      font-size: var(--fs-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent);
      margin-bottom: var(--space-2);
    }
    .card-body h2 {
      font-size: var(--fs-base);
      font-weight: 600;
      color: var(--ink-1);
      line-height: var(--lh-snug);
      margin-bottom: var(--space-2);
    }
    .card-body > p {
      font-size: var(--fs-sm);
      color: var(--ink-3);
      line-height: var(--lh-base);
      margin-bottom: var(--space-3);
    }
    .card-preview {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-4);
      line-height: 1.5;
      margin-bottom: var(--space-4);
      flex: 1;
    }
    .card-tools {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .tool-pill {
      font-size: var(--fs-xs);
      color: var(--ink-3);
      background: var(--surface-2);
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-pill);
    }

    .empty-state {
      text-align: center;
      padding: var(--space-12) 0;
      color: var(--ink-3);
    }

    @media (max-width: 1000px) {
      .prompt-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 620px) {
      .prompt-grid { grid-template-columns: 1fr; }
      .filter-bar { position: static; }
    }
  </style>
</LandingLayout>
