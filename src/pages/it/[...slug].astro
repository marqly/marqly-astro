---
import { getCollection } from 'astro:content';
import LocaleLander from '../../components/seo/LocaleLander.astro';

export async function getStaticPaths() {
  const entries = await getCollection('localePages', ({ data }) => !data.draft && data.lang === 'it');
  return entries.map((entry) => ({
    // path is the full URL ("/it/…"); the route param is everything after it.
    params: {
      slug: entry.data.path === '/it' ? undefined : entry.data.path.replace(/^\/it\//, ''),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<LocaleLander entry={entry} />
