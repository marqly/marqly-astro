---
import LandingLayout from '../layouts/LandingLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FaqAccordion from '../components/seo/FaqAccordion.astro';
import {
  breadcrumbList,
  faqPage,
  freeWebApplication,
  howTo,
  organization,
  webSite,
  type HowToStep,
} from '../lib/schema';

const title = 'Embed Curated Bookmarks & Public Boards | Marqly';
const description =
  'Embed your curated Marqly bookmark boards into Notion, WordPress, Ghost, Substack, or any website. Live preview, three layouts, and one clean iframe snippet.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Embed Boards', path: '/embed' },
];

const steps: HowToStep[] = [
  {
    name: 'Make your Marqly board public',
    text: 'Open any board in your Marqly library, click Share, set access to Public (or Password Protected), and copy the share link.',
    url: 'https://app.marqly.com',
  },
  {
    name: 'Paste the link into the generator below',
    text: 'The live preview loads your real board instantly. Choose Cards, List, or Condensed — Pro plans can also hide the board title and the creator line for a content-only embed.',
    url: '/embed#generator',
  },
  {
    name: 'Copy your snippet',
    text: 'Grab the HTML iframe for websites and CMSs, the plain link for Notion /embed, or a Markdown link for GitHub READMEs.',
    url: '/embed#generator',
  },
  {
    name: 'Paste into your blog, doc, or website',
    text: 'Drop it into a Custom HTML block in WordPress or Ghost, an /embed link in Notion, or directly into your site template. The embed loads lazily and updates itself whenever your board changes.',
    url: '/embed#platforms',
  },
];

const faqs = [
  {
    q: 'Is embedding Marqly boards free?',
    a: 'Yes. Embedding a public board is available on every plan. Pro plans unlock the display options: Cards, List, and Condensed layouts, plus hiding the board title and creator line for a content-only widget.',
  },
  {
    q: 'Do embedded boards update automatically when I save new bookmarks?',
    a: 'Yes. The embed renders your live Marqly board inside an iframe, so any link you add, edit, or delete in Marqly appears in every embedded copy — no republishing.',
  },
  {
    q: 'How does Marqly board embedding compare to Raindrop.io?',
    a: 'Beyond basic collection embeds, Marqly boards carry AI-generated tags and summaries, three embed layouts with live preview, and a lazy-loading iframe that keeps your page speed intact.',
  },
  {
    q: 'Does embedding a Marqly board slow down my website?',
    a: 'No. The snippet is a standard HTML5 iframe with native loading="lazy". The board loads asynchronously, so your host page’s LCP and First Input Delay are unaffected.',
  },
  {
    q: 'Can viewers search bookmarks inside the embed?',
    a: 'Boards with many bookmarks show a search box automatically. Viewers can also open any bookmark in a new tab straight from the embed.',
  },
  {
    q: 'Can private boards be embedded?',
    a: 'No. Only Public and Password Protected boards can be embedded — a password-protected board opens with its password prompt inside the iframe. Private boards stay private.',
  },
  {
    q: 'Will the embed show a Marqly link?',
    a: 'A full embed shows the board with its title and curator line. If you hide those (Pro), the embed always keeps a small linked "Created with Marqly" note at the bottom — that stays, and it sends readers back to the live board.',
  },
];

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList(crumbs),
  howTo(
    'How to Embed a Marqly Bookmark Board on Any Website',
    'A quick step-by-step walkthrough to turn any public Marqly board into an interactive, live-updating embed widget.',
    steps,
    'PT2M',
  ),
  faqPage(faqs),
  freeWebApplication(
    'Marqly Public Board Embed Generator',
    'Turn any public Marqly board into an interactive, live-updating embed widget for Notion, WordPress, Ghost, or any website.',
    '/embed',
  ),
];
---

<LandingLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <article class="section embed-page">
    <div class="container">
      <Breadcrumbs items={crumbs} />

      <header class="page-head">
        <div class="badge-row">
          <span class="pill-badge">Embed · 2026</span>
          <span class="live-badge">⚡ Live sync</span>
        </div>
        <h1>Embed your curated bookmarks anywhere</h1>
        <p class="lead">
          Turn any public Marqly board into an interactive, live-updating widget on your blog,
          documentation, or personal website. Showcase resource directories, reading lists, and research
          piles with one clean snippet.
        </p>
      </header>

      <!-- Interactive Generator Section -->
      <section id="generator" class="generator-card" data-reveal>
        <div class="generator-head">
          <div class="gen-title">
            <span class="gen-icon">⚙️</span>
            <div>
              <h2>Embed code generator</h2>
              <p class="gen-sub">Paste a public board link, pick a layout, copy the snippet.</p>
            </div>
          </div>
        </div>

        <div class="generator-grid">
          <!-- Controls Column -->
          <div class="gen-controls">
            <div class="form-group">
              <label for="board-url">Public board link</label>
              <input
                type="url"
                id="board-url"
                class="form-input"
                placeholder="https://app.marqly.com/s/YourShareId"
                value="https://app.marqly.com/s/83QcwyG"
              />
              <span class="input-hint">Find it in Marqly under <a href="https://app.marqly.com" target="_blank" rel="noopener">Share → Public link</a>, or paste the bare share ID.</span>
            </div>

            <div class="form-group">
              <label>Layout</label>
              <div class="radio-tiles" role="radiogroup" aria-label="Embed layout">
                <label class="radio-tile">
                  <input type="radio" name="layout" value="cards" checked />
                  <span class="tile-body">
                    <strong>Cards</strong>
                    <small>Cover previews in a grid (default)</small>
                  </span>
                </label>
                <label class="radio-tile">
                  <input type="radio" name="layout" value="list" />
                  <span class="tile-body">
                    <strong>List</strong>
                    <small>One row per bookmark, with description</small>
                  </span>
                </label>
                <label class="radio-tile">
                  <input type="radio" name="layout" value="condensed" />
                  <span class="tile-body">
                    <strong>Condensed</strong>
                    <small>Tight rows for sidebars</small>
                  </span>
                </label>
              </div>
            </div>

            <div class="form-group">
              <div class="pro-row-head">
                <label for="opt-title">Display <span class="pro-chip">Pro</span></label>
              </div>
              <label class="switch-row" for="opt-title">
                <input type="checkbox" id="opt-title" checked />
                <span>Board title & description</span>
              </label>
              <label class="switch-row" for="opt-creator">
                <input type="checkbox" id="opt-creator" checked />
                <span>Creator & stats line</span>
              </label>
              <p class="attribution-note">
                Hiding both gives a content-only embed — Marqly then adds a small linked
                “Created with Marqly” note at the bottom so readers can find the live board.
              </p>
            </div>
          </div>

          <!-- Preview & Code Column -->
          <div class="gen-output">
            <div class="preview-wrap">
              <div class="preview-header">
                <div class="preview-dots">
                  <span></span><span></span><span></span>
                </div>
                <span class="preview-title">Live preview</span>
                <span class="preview-badge" id="preview-badge">Cards</span>
              </div>

              <div class="preview-frame-wrap">
                <iframe
                  id="preview-frame"
                  class="preview-frame"
                  src="https://app.marqly.com/s/83QcwyG?embed=1"
                  title="Marqly board embed preview"
                  loading="lazy"
                ></iframe>
                <div class="preview-empty" id="preview-empty" hidden>
                  Paste a valid public board link to see it here.
                </div>
              </div>
            </div>

            <!-- Code Snippet Area -->
            <div class="code-wrap">
              <div class="code-tabs" role="tablist" aria-label="Snippet format">
                <button type="button" role="tab" aria-selected="true" class="tab-btn active" data-tab="html">HTML iframe</button>
                <button type="button" role="tab" aria-selected="false" class="tab-btn" data-tab="notion">Notion /embed</button>
                <button type="button" role="tab" aria-selected="false" class="tab-btn" data-tab="markdown">Markdown</button>
              </div>

              <div class="code-box">
                <pre><code id="snippet-code"></code></pre>
                <button type="button" class="copy-snippet-btn" id="copy-btn">
                  <span id="copy-label">Copy snippet</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Platform Guides -->
      <section id="platforms" class="platforms-section" data-reveal>
        <h2>How to embed Marqly boards into popular platforms</h2>
        <p class="section-sub">
          Marqly embeds work natively in every modern blogging platform, CMS, and documentation tool.
        </p>

        <div class="platform-grid">
          <div class="platform-card">
            <div class="plat-icon">📝</div>
            <h3>Notion</h3>
            <p>
              Type <code>/embed</code> on any Notion page, paste your public board link, and press
              <strong>Embed link</strong>. Your board renders with responsive scrolling.
            </p>
            <span class="plat-badge">Zero code required</span>
          </div>

          <div class="platform-card">
            <div class="plat-icon">🌐</div>
            <h3>WordPress</h3>
            <p>
              In Gutenberg, add a <strong>Custom HTML</strong> block and paste the generated iframe
              snippet. Preview and publish — compatible with all themes.
            </p>
            <span class="plat-badge">Gutenberg & Classic</span>
          </div>

          <div class="platform-card">
            <div class="plat-icon">👻</div>
            <h3>Ghost CMS</h3>
            <p>
              In the Ghost editor, click the <code>+</code> button, select <strong>HTML</strong>, and
              paste your snippet. Ideal for weekly link roundups and resource lists.
            </p>
            <span class="plat-badge">Native HTML Card</span>
          </div>

          <div class="platform-card">
            <div class="plat-icon">⚡</div>
            <h3>Webflow & Static Sites</h3>
            <p>
              Paste into Webflow's Embed element, or directly inside Astro, Next.js, Hugo, or
              Eleventy templates. Lazy loading guarantees peak performance.
            </p>
            <span class="plat-badge">Zero JS footprint</span>
          </div>
        </div>
      </section>

      <!-- Step-by-Step Walkthrough -->
      <section class="walkthrough-section" data-reveal>
        <h2>Step-by-step: Sharing and embedding public boards</h2>
        <div class="steps-container">
          {
            steps.map((s, idx) => (
              <div class="step-row">
                <div class="step-badge">{idx + 1}</div>
                <div class="step-detail">
                  <h3>{s.name}</h3>
                  <p>{s.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Benefits Section -->
      <section class="benefits-section" data-reveal>
        <h2>Why content creators and teams choose Marqly embeds</h2>
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="ben-icon">🔄</div>
            <h3>Always Up-to-Date</h3>
            <p>
              Never manually update blog post links again. When you clip an article with the
              <a href="/extension">Marqly browser extension</a>, your embedded boards update instantly.
            </p>
          </div>

          <div class="benefit-card">
            <div class="ben-icon">🎛️</div>
            <h3>Your Layout, Your Call</h3>
            <p>
              Cards for visual directories, List for roundups, Condensed for sidebars — and Pro can
              strip the chrome down to just the bookmarks.
            </p>
          </div>

          <div class="benefit-card">
            <div class="ben-icon">⚡</div>
            <h3>Zero Performance Penalty</h3>
            <p>
              A lazy-loaded standard iframe keeps your host domain's Core Web Vitals, LCP, and SEO
              scores untouched.
            </p>
          </div>

          <div class="benefit-card">
            <div class="ben-icon">🚀</div>
            <h3>Curator Brand Equity</h3>
            <p>
              Showcase your expertise. Every public board highlights your profile and drives
              high-intent readers back to your curated knowledge base.
            </p>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="faq-wrap" data-reveal>
        <FaqAccordion faqs={faqs} heading="Frequently Asked Questions about Embedding" />
      </section>

      <!-- Bottom CTA -->
      <section class="bottom-cta" data-reveal>
        <div class="cta-inner">
          <h2>Start curating and embedding your boards today</h2>
          <p>
            Join thousands of researchers, developers, and writers organizing knowledge with Marqly.
            Free up to 2,000 bookmarks with whole-library search.
          </p>
          <div class="cta-actions">
            <a class="btn btn--primary" href="https://app.marqly.com">
              Open Marqly Free <span class="arrow">→</span>
            </a>
            <a class="btn btn--ghost" href="https://app.marqly.com/explore">
              Explore Public Boards ↗
            </a>
          </div>
        </div>
      </section>
    </div>
  </article>
</LandingLayout>

<script is:inline>
  (function () {
    // The embed contract lives in the app: apps/web/lib/utils/shareEmbed.ts.
    // Canonical form: https://app.marqly.com/s/<shareId>?embed=1
    //   [&title=0] [&meta=0]  — display options (Pro)
    //   [&view=list|condensed] — layout (cards = default, no param)
    // URLs must be ABSOLUTE on app.marqly.com: marqly.com/www serve the
    // marketing site, which has no /s routes (the old generator's
    // "/embed?theme=…" shape 404'd for everyone who copied it).
    var APP_ORIGIN = 'https://app.marqly.com';

    var urlInput = document.getElementById('board-url');
    var layoutRadios = document.querySelectorAll('input[name="layout"]');
    var optTitle = document.getElementById('opt-title');
    var optCreator = document.getElementById('opt-creator');
    var codeElem = document.getElementById('snippet-code');
    var copyBtn = document.getElementById('copy-btn');
    var copyLabel = document.getElementById('copy-label');
    var tabBtns = document.querySelectorAll('.tab-btn');
    var previewFrame = document.getElementById('preview-frame');
    var previewEmpty = document.getElementById('preview-empty');
    var previewBadge = document.getElementById('preview-badge');

    var currentLayout = 'cards';
    var currentTab = 'html';

    function extractShareId(raw) {
      var val = (raw || '').trim();
      if (!val) return null;
      var m = val.match(/\/s\/([A-Za-z0-9_-]+)/);
      if (m) return m[1];
      if (/^[A-Za-z0-9_-]{4,}$/.test(val)) return val; // bare share id
      return null;
    }

    function buildEmbedUrl(shareId) {
      var params = ['embed=1'];
      if (!optTitle || !optTitle.checked) params.push('title=0');
      if (!optCreator || !optCreator.checked) params.push('meta=0');
      if (currentLayout !== 'cards') params.push('view=' + currentLayout);
      return APP_ORIGIN + '/s/' + encodeURIComponent(shareId) + '?' + params.join('&');
    }

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function update() {
      var shareId = extractShareId(urlInput && urlInput.value);
      var embedUrl = shareId ? buildEmbedUrl(shareId) : '';
      var shareUrl = shareId ? APP_ORIGIN + '/s/' + encodeURIComponent(shareId) : '';

      // Preview: the real embed, always honest.
      if (previewFrame && previewEmpty) {
        if (embedUrl) {
          previewFrame.hidden = false;
          previewEmpty.hidden = true;
          if (previewFrame.getAttribute('src') !== embedUrl) previewFrame.setAttribute('src', embedUrl);
        } else {
          previewFrame.hidden = true;
          previewEmpty.hidden = false;
        }
      }
      if (previewBadge) {
        previewBadge.textContent =
          currentLayout.charAt(0).toUpperCase() + currentLayout.slice(1) +
          (embedUrl && embedUrl.indexOf('title=0') !== -1 && embedUrl.indexOf('meta=0') !== -1 ? ' · Content only' : '');
      }

      // Snippet
      var code = '';
      if (!embedUrl) {
        code = 'Paste a valid public board link to generate the snippet.';
      } else if (currentTab === 'html') {
        var height = currentLayout === 'cards' ? '600' : currentLayout === 'list' ? '520' : '420';
        code =
          '<iframe src="' + embedUrl + '"\n' +
          '  title="Marqly board"\n' +
          '  width="100%" height="' + height + '"\n' +
          '  style="border:0;border-radius:12px;overflow:hidden"\n' +
          '  loading="lazy"\n' +
          '  allowfullscreen></iframe>';
      } else if (currentTab === 'notion') {
        code = embedUrl;
      } else if (currentTab === 'markdown') {
        code = '[Curated bookmarks on Marqly](' + shareUrl + ')';
      }

      if (codeElem) codeElem.innerHTML = currentTab === 'html' && embedUrl ? highlight(code) : escapeHtml(code);
    }

    // Lightweight HTML-token colouring, same scheme as the in-app snippet.
    // SINGLE pass over the raw source: sequential replaces would re-match the
    // markup the previous pass emitted (class="c-..." looked like an
    // attribute) and corrupt the snippet — textContent must round-trip to a
    // valid iframe tag, since that string is what users paste into their site.
    function highlight(src) {
      var re = /(<\/?)([a-zA-Z][\w-]*)|([a-zA-Z][\w-]*)=("[^"]*")|(\/>|>)/g;
      var out = '', last = 0, m;
      while ((m = re.exec(src))) {
        out += escapeHtml(src.slice(last, m.index));
        if (m[2]) {
          out += '<span class="c-punct">' + escapeHtml(m[1]) + '</span><span class="c-tag">' + escapeHtml(m[2]) + '</span>';
        } else if (m[3]) {
          out += '<span class="c-attr">' + escapeHtml(m[3]) + '</span><span class="c-punct">=</span><span class="c-value">' + escapeHtml(m[4]) + '</span>';
        } else if (m[5]) {
          out += '<span class="c-punct">' + escapeHtml(m[5]) + '</span>';
        }
        last = m.index + m[0].length;
      }
      out += escapeHtml(src.slice(last));
      return out;
    }

    if (urlInput) urlInput.addEventListener('input', update);
    if (optTitle) optTitle.addEventListener('change', update);
    if (optCreator) optCreator.addEventListener('change', update);

    layoutRadios.forEach(function (radio) {
      radio.addEventListener('change', function (e) {
        currentLayout = e.target.value;
        update();
      });
    });

    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabBtns.forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentTab = btn.getAttribute('data-tab') || 'html';
        update();
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async function () {
        var text = (codeElem && codeElem.textContent) || '';
        try {
          await navigator.clipboard.writeText(text);
          if (copyLabel) copyLabel.textContent = 'Copied!';
          copyBtn.classList.add('is-copied');
          setTimeout(function () {
            if (copyLabel) copyLabel.textContent = 'Copy snippet';
            copyBtn.classList.remove('is-copied');
          }, 2000);
        } catch (err) {
          if (codeElem) {
            var range = document.createRange();
            range.selectNodeContents(codeElem);
            var sel = window.getSelection();
            if (sel) { sel.removeAllRanges(); sel.addRange(range); }
          }
        }
      });
    }

    update();
  })();
</script>

<style>
  .embed-page { width: 100%; }
  .embed-page > .container { max-width: 1080px; margin-inline: auto; }
  .badge-row { display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-3); }
  .pill-badge {
    display: inline-block; font-size: var(--fs-xs); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    background: var(--surface-2); color: var(--ink-2);
    padding: 0.2rem 0.6rem; border-radius: 9999px; border: 1px solid var(--border-1);
  }
  .live-badge { font-size: var(--fs-xs); color: var(--ink-2); font-weight: 500; }
  h1 { font-size: var(--fs-h2); font-weight: 600; letter-spacing: var(--tracking-tight); color: var(--ink-1); line-height: var(--lh-tight); }
  .lead { margin-top: var(--space-4); font-size: var(--fs-lg); line-height: var(--lh-base); color: var(--ink-2); max-width: 780px; }

  /* Generator Section */
  .generator-card {
    margin-top: var(--space-8); margin-bottom: var(--space-12);
    background: var(--surface-1); border: 1px solid var(--border-1);
    border-radius: var(--radius-card); padding: var(--space-8);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
  }
  .generator-head { margin-bottom: var(--space-8); border-bottom: 1px solid var(--border-1); padding-bottom: var(--space-5); }
  .gen-title { display: flex; gap: var(--space-4); align-items: flex-start; }
  .gen-icon { font-size: 2rem; line-height: 1; }
  .gen-title h2 { font-size: var(--fs-h3); font-weight: 600; color: var(--ink-1); margin: 0; }
  .gen-sub { margin-top: var(--space-1); font-size: var(--fs-sm); color: var(--ink-2); }

  .generator-grid {
    display: grid; grid-template-columns: 1fr 1.25fr; gap: var(--space-8);
  }
  @media (max-width: 900px) {
    .generator-grid { grid-template-columns: 1fr; }
  }

  /* Controls */
  .gen-controls { display: flex; flex-direction: column; gap: var(--space-6); }
  .form-group { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-group > label { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-1); }
  .form-input {
    width: 100%; padding: 0.65rem 0.85rem; font-size: var(--fs-sm);
    border: 1px solid var(--border-2); border-radius: var(--radius-sm);
    background: var(--surface-2); color: var(--ink-1);
  }
  .form-input:focus { outline: none; border-color: var(--ink-1); }
  .input-hint { font-size: var(--fs-xs); color: var(--ink-3); }
  .input-hint a { color: var(--ink-2); text-decoration: underline; }

  .pro-row-head { display: flex; align-items: center; gap: var(--space-2); }
  .pro-chip {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    background: var(--surface-2); border: 1px solid var(--border-2); color: var(--ink-2);
    padding: 0.05rem 0.4rem; border-radius: 9999px; vertical-align: middle;
  }
  .switch-row {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--fs-sm); font-weight: 500; color: var(--ink-1); cursor: pointer;
  }
  .switch-row input { accent-color: var(--ink-1); width: 15px; height: 15px; }
  .attribution-note {
    margin: var(--space-1) 0 0 0; font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.45;
  }

  /* Radio Tiles */
  .radio-tiles { display: flex; flex-direction: column; gap: var(--space-2); }
  .radio-tile {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4); border: 1px solid var(--border-1);
    border-radius: var(--radius-sm); cursor: pointer; transition: all 0.15s ease;
    background: var(--surface-2);
  }
  .radio-tile:hover { border-color: var(--border-2); background: var(--surface-1); }
  .radio-tile input { accent-color: var(--ink-1); }
  .tile-body { display: flex; flex-direction: column; }
  .tile-body strong { font-size: var(--fs-sm); color: var(--ink-1); font-weight: 500; }
