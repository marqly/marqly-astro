---
import { getCollection, render } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CtaBox from '../../components/seo/CtaBox.astro';
import { breadcrumbList, organization, qaPage, webSite } from '../../lib/schema';

export async function getStaticPaths() {
  const entries = await getCollection('faq', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: entries },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);

const CATEGORY_LABELS: Record<string, string> = {
  basics: 'Bookmarking basics',
  features: 'Features',
  'getting-started': 'Getting started',
  pricing: 'Pricing & billing',
  trust: 'Privacy & trust',
  company: 'Company & support',
};

// Related questions: explicit `related` first, topped up from the same category.
const related = entry.data.related
  .map((slug) => all.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
for (const e of all) {
  if (related.length >= 6) break;
  if (e.id !== entry.id && e.data.category === entry.data.category && !related.includes(e)) {
    related.push(e);
  }
}

const path = `/faq/${entry.id}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq' },
  { name: entry.data.question, path },
];

const jsonLd = [
  organization(),
  webSite(),
  breadcrumbList(crumbs),
  qaPage(entry.data.question, entry.data.description, path),
];

const title = `${entry.data.question} | Marqly FAQ`;
---

<LandingLayout
  title={title}
  description={entry.data.description}
  jsonLd={jsonLd}
  ogImage={`https://www.marqly.com/og/seo/faq-${entry.id}.png`}
>
  <article class="section">
    <div class="container faq-page">
      <Breadcrumbs items={crumbs} />
      <p class="cat">{CATEGORY_LABELS[entry.data.category]}</p>
      <h1>{entry.data.question}</h1>
      <p class="short-answer">{entry.data.description}</p>

      <div class="prose">
        <Content />
      </div>

      {related.length > 0 && (
        <nav class="related" aria-label="Related questions">
          <h2>Related questions</h2>
          <ul>
            {related.slice(0, 6).map((r) => (
              <li><a href={`/faq/${r.id}`}>{r.data.question}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <CtaBox />
    </div>
  </article>
</LandingLayout>

<style>
  .faq-page { max-width: 760px; }
  .cat {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin-bottom: var(--space-3);
  }
  h1 {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-1);
    line-height: var(--lh-tight);
  }
  .short-answer {
    margin-top: var(--space-5);
    padding: var(--space-5) var(--space-6);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-card);
    font-size: var(--fs-base);
    color: var(--ink-1);
    line-height: var(--lh-base);
  }

  .prose { margin-top: var(--space-8); }
  .prose :global(p) {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }
  .prose :global(h2) {
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--ink-1);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    letter-spacing: var(--tracking-tight);
  }
  .prose :global(h3) {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--ink-1);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: var(--space-4);
    color: var(--ink-2);
    line-height: var(--lh-base);
  }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(a) { color: var(--ink-1); font-weight: 500; text-decoration: underline; }
  .prose :global(strong) { color: var(--ink-1); }

  .related {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-1);
  }
  .related h2 { font-size: var(--fs-lg); font-weight: 600; color: var(--ink-1); margin-bottom: var(--space-4); }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .related a { font-size: var(--fs-sm); color: var(--ink-2); }
  .related a:hover { color: var(--ink-1); }
  @media (max-width: 620px) { .related ul { grid-template-columns: 1fr; } }
</style>
